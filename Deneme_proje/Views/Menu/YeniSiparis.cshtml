<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yeni Sipariş</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f5f6fa;
            color: #2c3e50;
        }

        .main-content {
            padding: 20px;
        }

        .breadcrumb-custom {
            background: none;
            padding: 0;
            margin-bottom: 20px;
            font-size: 0.9rem;
            color: #6c757d;
        }

            .breadcrumb-custom a {
                color: #6c757d;
                text-decoration: none;
            }

                .breadcrumb-custom a:hover {
                    color: #2c3e50;
                }

            .breadcrumb-custom .active {
                color: #2c3e50;
                font-weight: 600;
            }

        .form-container {
            background: white;
            border: 1px solid #e0e6ed;
            overflow: hidden;
            margin: 0 auto;
        }

        .form-header {
            background: #34495e;
            color: white;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 3px solid #2c3e50;
        }

        .form-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin: 0;
        }

        .customer-info {
            display: flex;
            gap: 20px;
            align-items: center;
            font-size: 0.9rem;
        }

        .form-body {
            padding: 30px;
        }

        .form-section {
            border: 1px solid #e0e6ed;
            overflow: hidden;
        }

        .section-header {
            background: #f8f9fa;
            padding: 15px 20px;
            border-bottom: 1px solid #e0e6ed;
            border-left: 4px solid #34495e;
            font-weight: 600;
            color: #2c3e50;
            font-size: 1rem;
        }

        .section-body {
            padding: 25px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

            .form-group label {
                font-weight: 600;
                color: #2c3e50;
                margin-bottom: 5px;
                font-size: 0.9rem;
            }

            .form-group input,
            .form-group select,
            .form-group textarea {
                padding: 12px 15px;
                border: 1px solid #e0e6ed;
                border-radius: 4px;
                font-size: 0.9rem;
                transition: all 0.2s ease;
                background: white;
            }

                .form-group input:focus,
                .form-group select:focus,
                .form-group textarea:focus {
                    outline: none;
                    border-color: #2c3e50;
                    box-shadow: 0 0 0 2px rgba(44, 62, 80, 0.1);
                }

            .form-group textarea {
                resize: vertical;
                min-height: 80px;
            }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
            padding: 15px;
            background: #f8f9fa;
            border: 1px solid #e0e6ed;
            border-radius: 4px;
        }

            .checkbox-group input[type="checkbox"] {
                width: 16px;
                height: 16px;
                margin-right: 8px;
            }

            .checkbox-group label {
                margin: 0;
                font-weight: 500;
                font-size: 0.9rem;
            }

        /* Ürün Tablosu */
        .table-container {
            overflow-x: auto;
            border: 1px solid #e0e6ed;
            border-radius: 4px;
        }

        .product-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1200px;
        }

            .product-table th {
                background: #34495e;
                color: white;
                padding: 12px 10px;
                text-align: left;
                font-weight: 600;
                font-size: 0.85rem;
                border-right: 1px solid #2c3e50;
            }

                .product-table th:last-child {
                    border-right: none;
                }

            .product-table td {
                padding: 10px;
                border: 1px solid #e0e6ed;
                vertical-align: middle;
            }

            .product-table input,
            .product-table select {
                width: 100%;
                padding: 8px 10px;
                border: 1px solid #e0e6ed;
                border-radius: 3px;
                font-size: 0.85rem;
                background: white;
            }

                .product-table input:focus,
                .product-table select:focus {
                    outline: none;
                    border-color: #2c3e50;
                }

        .add-product-btn,
        .remove-product-btn {
            border: none;
            border-radius: 3px;
            padding: 6px 10px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 500;
            margin-right: 5px;
        }

        .add-product-btn {
            background: #27ae60;
            color: white;
        }

        .remove-product-btn {
            background: #e74c3c;
            color: white;
        }

        .add-product-btn:hover {
            background: #229954;
        }

        .remove-product-btn:hover {
            background: #c0392b;
        }

        /* Toplam Bölümü */
        .totals-section {
            background: #f8f9fa;
            padding: 25px;
            border: 1px solid #e0e6ed;
            border-radius: 4px;
            margin-top: 20px;
        }

        .totals-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 25px;
        }

        .totals-column h6 {
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 1rem;
            font-weight: 600;
            padding-bottom: 8px;
            border-bottom: 2px solid #34495e;
        }

        .totals-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #e0e6ed;
            font-size: 0.9rem;
        }

            .totals-row:last-child {
                border-bottom: none;
                font-weight: 600;
                color: #2c3e50;
            }

        /* Butonlar */
        .form-actions {
            background: #f8f9fa;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            gap: 15px;
            border-top: 1px solid #e0e6ed;
        }

        .btn {
            padding: 12px 25px;
            border: 1px solid transparent;
            border-radius: 4px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
            font-size: 0.9rem;
        }

        .btn-primary {
            background: #2c3e50;
            color: white;
            border-color: #2c3e50;
        }

            .btn-primary:hover {
                background: #34495e;
                border-color: #34495e;
            }

        .btn-secondary {
            background: #95a5a6;
            color: white;
            border-color: #95a5a6;
        }

            .btn-secondary:hover {
                background: #7f8c8d;
                border-color: #7f8c8d;
            }

        .btn-success {
            background: #27ae60;
            color: white;
            border-color: #27ae60;
        }

            .btn-success:hover {
                background: #229954;
                border-color: #229954;
            }

        /* Responsive */
        @@media (max-width: 1200px) {
            .form-row

        {
            grid-template-columns: repeat(3, 1fr);
        }

        .totals-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        }

        @@media (max-width: 768px) {
            .form-row

        {
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .totals-grid {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
        }

        .customer-info {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        }

        @@media (max-width: 480px) {
            .form-row

        {
            grid-template-columns: 1fr;
        }

        }
    </style>
</head>
<body>
    <div class="main-content mt-5">
        <div class="px-lg-5 px-3">
            <!-- Breadcrumb -->
            <nav class="breadcrumb-custom">
                <a href="/Menu">Ana Menü</a> >
                <a href="#">Satış</a> >
                <a href="/Menu/Siparisler">Satış Siparişleri</a> >
                <span class="active">Yeni Kayıt</span>
            </nav>

            <form method="post" class="form-container" id="orderForm">
                <!-- Form Header -->
                <div class="form-header">
                    <h2 class="form-title">➕ Yeni Sipariş</h2>
                    <div class="customer-info">
                        <span>📊 Müşteri Ek Bilgiler</span>
                        <span>💼 Alış-Satış Koşulları</span>
                    </div>
                </div>

                <div class="form-body">
                    <!-- Temel Bilgiler -->
                    <div class="form-section">
                        <div class="section-header">📋 Temel Bilgiler</div>
                        <div class="section-body">
                            <div class="checkbox-group">
                                <label>
                                    <input type="checkbox" id="aktif" checked> Aktif
                                </label>
                                <label>
                                    <input type="checkbox" id="stokRezerve"> Stok Rezerve Et
                                </label>
                                <label>
                                    <input type="checkbox" id="yurtdisi"> Yurtdışı
                                </label>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Başlık</label>
                                    <select name="baslik">
                                        <option>Kayıt</option>
                                        <option>Sipariş</option>
                                        <option>Proforma</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Sipariş Tarihi</label>
                                    <input type="date" name="siparisTarihi" value="2025-01-15" />
                                </div>
                                <div class="form-group">
                                    <label>Depo</label>
                                    <select name="depo">
                                        <option>Ana Depo</option>
                                        <option>Şube Depo</option>
                                        <option>Merkez Depo</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Cari Hesap 🔍</label>
                                    <input type="text" name="cariHesap" placeholder="Cari hesap seçiniz..." />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Yetkili</label>
                                    <input type="text" name="yetkili" placeholder="Yetkili kişi" />
                                </div>
                                <div class="form-group">
                                    <label>Sevk Tarihi</label>
                                    <input type="date" name="sevkTarihi" value="2025-01-22" />
                                </div>
                                <div class="form-group">
                                    <label>Teslim Tarihi</label>
                                    <input type="date" name="teslimTarihi" />
                                </div>
                                <div class="form-group">
                                    <label>Teslim Yeri ⚙️</label>
                                    <select name="teslimYeri">
                                        <option>Fabrika</option>
                                        <option>Müşteri Adresi</option>
                                        <option>Kargo</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Şube</label>
                                    <input type="text" name="sube" placeholder="Seçiniz" readonly />
                                </div>
                                <div class="form-group">
                                    <label>Süreç</label>
                                    <select name="surec">
                                        <option>Kayıt</option>
                                        <option>Onay Bekliyor</option>
                                        <option>Onaylandı</option>
                                        <option>Üretimde</option>
                                        <option>Hazır</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Satış Çalışanı</label>
                                    <input type="text" name="satisCalisan" placeholder="serhat gundes" />
                                </div>
                                <div class="form-group">
                                    <label>Satış Ortağı</label>
                                    <input type="text" name="satisOrtagi" placeholder="Satış Ortağı" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>İletişim</label>
                                    <select name="iletisim">
                                        <option>Seçiniz</option>
                                        <option>Telefon</option>
                                        <option>E-posta</option>
                                        <option>WhatsApp</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Özel Tanım</label>
                                    <select name="ozelTanim">
                                        <option>Seçiniz</option>
                                        <option>Acil</option>
                                        <option>Normal</option>
                                        <option>Düşük Öncelik</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Proje</label>
                                    <input type="text" name="proje" placeholder="Proje" />
                                </div>
                                <div class="form-group">
                                    <label>İş</label>
                                    <input type="text" name="is" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ürün Bilgileri -->
                    <div class="form-section">
                        <div class="section-header">📦 Ürün Bilgileri</div>
                        <div class="section-body">
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Ülke</label>
                                    <select name="ulke">
                                        <option>Seçiniz</option>
                                        <option>Türkiye</option>
                                        <option>Almanya</option>
                                        <option>İngiltere</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Satış Bölgesi</label>
                                    <select name="satisBolgesi">
                                        <option>Seçiniz</option>
                                        <option>İstanbul</option>
                                        <option>Ankara</option>
                                        <option>İzmir</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Vade</label>
                                    <input type="number" name="vade" value="0" min="0" />
                                </div>
                                <div class="form-group">
                                    <label>Öncelik</label>
                                    <select name="oncelik">
                                        <option>2-Normal</option>
                                        <option>1-Yüksek</option>
                                        <option>3-Düşük</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Ödeme Yöntemi</label>
                                    <select name="odemeYontemi">
                                        <option>Seçiniz</option>
                                        <option>Nakit</option>
                                        <option>Kredi Kartı</option>
                                        <option>Havale/EFT</option>
                                        <option>Çek</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Kampanya</label>
                                    <input type="text" name="kampanya" />
                                </div>
                                <div class="form-group">
                                    <label>Ek Bilgi</label>
                                    <input type="text" name="ekBilgi" />
                                </div>
                                <div class="form-group">
                                    <!-- Boş alan -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ürün Listesi -->
                    <div class="form-section">
                        <div class="section-header">📋 Ürün Detayları</div>
                        <div class="section-body">
                            <div class="table-container">
                                <table class="product-table">
                                    <thead>
                                        <tr>
                                            <th>No</th>
                                            <th>İşlem</th>
                                            <th>Özel Kod</th>
                                            <th>Üretici Kodu</th>
                                            <th>Barkod</th>
                                            <th>Stok Kodu</th>
                                            <th>Lot No</th>
                                            <th>Ürün Adı</th>
                                            <th>Spekt</th>
                                            <th>Miktar</th>
                                            <th>Birim</th>
                                            <th>Miktar 2</th>
                                            <th>Birim 2</th>
                                            <th>Liste Fiyatı</th>
                                            <th>Fiyat</th>
                                        </tr>
                                    </thead>
                                    <tbody id="productTableBody">
                                        <tr>
                                            <td>1</td>
                                            <td>
                                                <button type="button" class="add-product-btn" onclick="addProductRow()">➕</button>
                                                <button type="button" class="remove-product-btn" onclick="removeProductRow(this)">✖️</button>
                                            </td>
                                            <td><input type="text" name="ozelKod[]" /></td>
                                            <td><input type="text" name="ureticiKodu[]" /></td>
                                            <td><input type="text" name="barkod[]" /></td>
                                            <td><input type="text" name="stokKodu[]" /></td>
                                            <td><input type="text" name="lotNo[]" /></td>
                                            <td><input type="text" name="urunAdi[]" placeholder="Ürün adı" /></td>
                                            <td><input type="text" name="spekt[]" /></td>
                                            <td><input type="number" name="miktar[]" step="0.01" onchange="calculateRowTotal(this)" /></td>
                                            <td>
                                                <select name="birim[]">
                                                    <option>ADET</option>
                                                    <option>KG</option>
                                                    <option>METRE</option>
                                                    <option>LITRE</option>
                                                </select>
                                            </td>
                                            <td><input type="number" name="miktar2[]" step="0.01" /></td>
                                            <td>
                                                <select name="birim2[]">
                                                    <option>ADET</option>
                                                    <option>KG</option>
                                                    <option>METRE</option>
                                                </select>
                                            </td>
                                            <td><input type="number" name="listeFiyati[]" step="0.01" onchange="calculateRowTotal(this)" /></td>
                                            <td><input type="number" name="fiyat[]" step="0.01" onchange="calculateRowTotal(this)" /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Toplam Bilgileri -->
                    <div class="totals-section">
                        <h4 style="margin-bottom: 20px; color: #2c3e50; font-size: 1.1rem;">💰 Toplam Bilgileri</h4>

                        <div class="totals-grid">
                            <!-- Döviz Bölümü -->
                            <div class="totals-column">
                                <h6>💱 Döviz</h6>
                                <div class="totals-row"><span>TL</span><span>1</span></div>
                                <div class="totals-row"><span>EUR</span><span>1</span></div>
                                <div class="totals-row"><span>GBP</span><span>1</span></div>
                                <div class="totals-row"><span>USD</span><span>1</span></div>
                                <div class="totals-row"><span>JPY</span><span>1</span></div>
                                <div class="totals-row"><span>CAD</span><span>1</span></div>
                            </div>

                            <!-- Toplam Bölümü -->
                            <div class="totals-column">
                                <h6>📊 Toplam</h6>
                                <div class="totals-row"><span>Toplam</span><span id="toplamTutar">0,0</span></div>
                                <div class="totals-row"><span>Fatura Altı İndirim KDV'li</span><span>36,5</span></div>
                                <div class="totals-row"><span>Fatura Altı İndirim</span><span>43,3</span></div>
                                <div class="totals-row"><span>KDV Toplam</span><span>0,0</span></div>
                                <div class="totals-row"><span>ÖTV</span><span>0,0</span></div>
                                <div class="totals-row"><span>KDV'li Toplam</span><span id="kdvliToplam">0,0</span></div>
                            </div>

                            <!-- Vergi Bölümü -->
                            <div class="totals-column">
                                <h6>🧾 Vergi</h6>
                                <div class="totals-row"><span>Tevkifat</span><span>0,0</span></div>
                                <div class="totals-row"><span>+ Stopaj %</span><span>0,00</span></div>
                                <div class="totals-row"><span>+ İstanlar</span><span>0,00</span></div>
                                <div class="totals-row"><span>Kod</span><span>0,0</span></div>
                                <div class="totals-row"><span>Madde</span><span>0,0</span></div>
                            </div>

                            <!-- Toplam Miktar Bölümü -->
                            <div class="totals-column">
                                <h6>📦 Toplam Miktar</h6>
                                <div class="totals-row"><span>Toplam</span><span id="toplamMiktar">0</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="form-actions">
                    <div>
                        <button type="button" class="btn btn-secondary">Standart Satış</button>
                        <button type="button" class="btn btn-secondary">Stok Kodu</button>
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <a href="#" class="btn btn-secondary">❌ İptal</a>
                        <button type="button" class="btn btn-success" onclick="downloadPDF()">💾 Kaydet</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script>
        let rowCounter = 1;

        function addProductRow() {
            rowCounter++;
            const tbody = document.getElementById('productTableBody');
            const newRow = `
                <tr>
                    <td>${rowCounter}</td>
                    <td>
                        <button type="button" class="add-product-btn" onclick="addProductRow()">➕</button>
                        <button type="button" class="remove-product-btn" onclick="removeProductRow(this)">✖️</button>
                    </td>
                    <td><input type="text" name="ozelKod[]" /></td>
                    <td><input type="text" name="ureticiKodu[]" /></td>
                    <td><input type="text" name="barkod[]" /></td>
                    <td><input type="text" name="stokKodu[]" /></td>
                    <td><input type="text" name="lotNo[]" /></td>
                    <td><input type="text" name="urunAdi[]" placeholder="Ürün adı" /></td>
                    <td><input type="text" name="spekt[]" /></td>
                    <td><input type="number" name="miktar[]" step="0.01" onchange="calculateRowTotal(this)" /></td>
                    <td>
                        <select name="birim[]">
                            <option>ADET</option>
                            <option>KG</option>
                            <option>METRE</option>
                            <option>LITRE</option>
                        </select>
                    </td>
                    <td><input type="number" name="miktar2[]" step="0.01" /></td>
                    <td>
                        <select name="birim2[]">
                            <option>ADET</option>
                            <option>KG</option>
                            <option>METRE</option>
                        </select>
                    </td>
                    <td><input type="number" name="listeFiyati[]" step="0.01" onchange="calculateRowTotal(this)" /></td>
                    <td><input type="number" name="fiyat[]" step="0.01" onchange="calculateRowTotal(this)" /></td>
                </tr>
            `;
            tbody.insertAdjacentHTML('beforeend', newRow);
        }

        function removeProductRow(button) {
            const row = button.closest('tr');
            if (document.querySelectorAll('#productTableBody tr').length > 1) {
                row.remove();
                calculateTotal();
                updateRowNumbers();
            }
        }

        function updateRowNumbers() {
            const rows = document.querySelectorAll('#productTableBody tr');
            rows.forEach((row, index) => {
                row.cells[0].textContent = index + 1;
            });
            rowCounter = rows.length;
        }

        function calculateRowTotal(input) {
            calculateTotal();
        }

        function calculateTotal() {
            let toplam = 0;
            let toplamMiktar = 0;

            const rows = document.querySelectorAll('#productTableBody tr');
            rows.forEach(row => {
                const miktar = parseFloat(row.querySelector('input[name="miktar[]"]')?.value || 0);
                const fiyat = parseFloat(row.querySelector('input[name="fiyat[]"]')?.value || 0);

                toplam += miktar * fiyat;
                toplamMiktar += miktar;
            });

            document.getElementById('toplamTutar').textContent = toplam.toFixed(2);
            document.getElementById('kdvliToplam').textContent = (toplam * 1.18).toFixed(2);
            document.getElementById('toplamMiktar').textContent = toplamMiktar.toFixed(2);
        }

        function downloadPDF() {
            // wwwroot klasöründeki 1.pdf dosyasını indir
            const link = document.createElement('a');
            link.href = '/1.pdf'; // wwwroot klasöründeki dosya yolu
            link.download = '1.pdf'; // İndirilecek dosya adı
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>