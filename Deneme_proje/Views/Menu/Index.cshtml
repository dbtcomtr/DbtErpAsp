<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ana Menü</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f8f9fa;
        }

        .breadcrumb-custom {
            background: none;
            padding: 0;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

            .breadcrumb-custom .breadcrumb-item {
                font-size: 1rem;
                color: #6c757d;
                display: flex;
                align-items: center;
            }

                .breadcrumb-custom .breadcrumb-item.active {
                    color: #007bff;
                    font-weight: 600;
                }

                .breadcrumb-custom .breadcrumb-item + .breadcrumb-item::before {
                    content: ">";
                    color: #6c757d;
                    margin: 0 10px;
                }

        /* Ana Menü Layout - Sola Yaslanmış */
        .main-menu-layout {
            display: flex;
            gap: 40px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(250px, 1fr));
            gap: 30px;
            flex: 1;
        }

        .menu-item {
            background: white;
            border-radius: 16px;
            padding: 30px 20px;
            text-align: center;
            text-decoration: none;
            color: #495057;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            border: 2px solid transparent;
            min-height: 160px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

            .menu-item:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.15);
                border-color: #007bff;
                color: #007bff;
                text-decoration: none;
            }

            .menu-item.accessible {
                border-left: 4px solid #28a745;
            }

                .menu-item.accessible:hover {
                    border-color: #007bff;
                    border-left: 4px solid #007bff;
                }

        /* Sağ Sidebar - Erişim Yok Menüleri */
        .restricted-sidebar {
            width: 280px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            padding: 25px;
            height: fit-content;
            position: sticky;
            top: 20px;
        }

        .sidebar-title-main {
            font-size: 1.1rem;
            font-weight: 600;
            color: #dc3545;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            padding-bottom: 10px;
            border-bottom: 2px solid #f8f9fa;
        }

            .sidebar-title-main i {
                margin-right: 10px;
                font-size: 1.2rem;
            }

        .restricted-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            color: #6c757d;
            background: #f8f9fa;
            margin-bottom: 8px;
            border-radius: 8px;
            font-size: 0.9rem;
            cursor: not-allowed;
            transition: all 0.3s ease;
            opacity: 0.7;
        }

            .restricted-item:hover {
                background: #e9ecef;
            }

            .restricted-item span {
                margin-left: 10px;
            }

        .menu-icon {
            font-size: 3.5rem;
            margin-bottom: 15px;
            display: block;
            transition: all 0.3s ease;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.1));
        }

        .menu-item:hover .menu-icon {
            transform: scale(1.1);
            filter: drop-shadow(0 6px 12px rgba(0,123,255,0.3));
        }

        .menu-text {
            font-size: 1.1rem;
            font-weight: 600;
            margin: 0;
            line-height: 1.3;
            transition: all 0.3s ease;
        }

        /* Alt Menü Stilleri - Yeni Layout */
        .sub-menu-section {
            display: none;
            animation: fadeIn 0.5s ease;
        }

            .sub-menu-section.active {
                display: flex;
                gap: 20px;
            }

        .main-content-area {
            flex: 1;
            padding-right: 20px;
        }

        .sidebar-right {
            width: 300px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            padding: 20px;
            height: fit-content;
            position: sticky;
            top: 20px;
            margin-top:56px;
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .section {
            margin-bottom: 40px;
        }

        .section-header {
            display: flex;
            align-items: center;
            margin-bottom: 25px;
            padding: 18px 25px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            position: relative;
        }

            .section-header::after {
                content: '';
                position: absolute;
                right: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background: linear-gradient(180deg, #007bff 0%, #0056b3 100%);
                border-radius: 0 12px 12px 0;
            }

        .section-icon {
            font-size: 1.8rem;
            margin-right: 15px;
            padding: 12px;
            background: #fff3cd;
            border-radius: 10px;
        }

        .section-title {
            font-size: 1.4rem;
            font-weight: 600;
            color: #495057;
            margin: 0;
        }

        .sub-menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 25px;
        }

        .sub-menu-item {
            background: white;
            border-radius: 14px;
            padding: 30px 25px;
            text-align: center;
            text-decoration: none;
            color: #495057;
            transition: all 0.3s ease;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
            border: 2px solid transparent;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 160px;
            justify-content: center;
            cursor: pointer;
        }

            .sub-menu-item:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(0,0,0,0.15);
                border-color: #007bff;
                color: #007bff;
                text-decoration: none;
            }

            .sub-menu-item.disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

                .sub-menu-item.disabled:hover {
                    transform: none;
                    box-shadow: 0 3px 12px rgba(0,0,0,0.08);
                    border-color: transparent;
                    color: #495057;
                }

        .sub-menu-item-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin-bottom: 15px;
            transition: all 0.3s ease;
            font-weight: bold;
            color: white;
        }

        .sub-menu-item-text {
            font-size: 1rem;
            font-weight: 600;
            margin: 0;
            line-height: 1.4;
        }

        /* Renkli ikonlar */
        .icon-purple {
            background: #6f42c1;
        }

        .icon-blue {
            background: #007bff;
        }

        .icon-orange {
            background: #fd7e14;
        }

        .icon-green {
            background: #28a745;
        }

        .icon-red {
            background: #dc3545;
        }

        .sidebar-title {
            font-size: 1rem;
            font-weight: 600;
            color: #495057;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            padding: 8px 0;
            color: #6c757d;
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s ease;
        }

            .sidebar-item:hover {
                color: #007bff;
                text-decoration: none;
            }

            .sidebar-item i {
                margin-right: 8px;
                font-size: 1rem;
                width: 20px;
                text-align: center;
            }

        .back-button {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 8px 15px;
            color: #6c757d;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            font-size: 0.9rem;
            margin-bottom: 20px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .back-button:hover {
                background: #e9ecef;
                color: #495057;
                text-decoration: none;
            }

            .back-button i {
                margin-right: 5px;
            }

        .main-content {
            margin-top: 2rem;
        }

        .px-lg-5 {
            padding-left: 3rem;
            padding-right: 3rem;
        }

        .px-3 {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        /* Alert Modal */
        .alert-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .alert-content {
            background: white;
            padding: 30px;
            border-radius: 12px;
            text-align: center;
            max-width: 400px;
            margin: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .alert-icon {
            font-size: 3rem;
            color: #dc3545;
            margin-bottom: 15px;
        }

        .alert-message {
            font-size: 1.1rem;
            color: #495057;
            margin-bottom: 20px;
        }

        .alert-button {
            background: #007bff;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1rem;
            transition: background 0.3s ease;
        }

            .alert-button:hover {
                background: #0056b3;
            }

        @@media (max-width: 1200px) {
            .main-menu-layout

        {
            flex-direction: column;
        }

        .restricted-sidebar {
            width: 100%;
            margin-top: 20px;
            position: static;
        }

        .sub-menu-section.active {
            flex-direction: column;
        }

        .sidebar-right {
            width: 100%;
            margin-top: 20px;
            position: static;
        }

        }

        @@media (max-width: 768px) {
            .menu-grid

        {
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .sub-menu-grid {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
        }

        .menu-item, .sub-menu-item {
            padding: 20px 15px;
            min-height: 120px;
        }

        .menu-icon {
            font-size: 2.5rem;
        }

        .menu-text, .sub-menu-item-text {
            font-size: 0.9rem;
        }

        .px-lg-5 {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        }
    </style>
</head>
<body>
    <div class="main-content mt-5">
        <div class="px-lg-5 px-3">
            <!-- Breadcrumb -->
