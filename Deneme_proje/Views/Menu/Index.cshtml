                        </div>

                        <div class="restricted-item" onclick="showAccessDenied()">
                            <span>🚫</span>
                            <span>Müşteri-Tedarikçi</span>
                        </div>

                        <div class="restricted-item" onclick="showAccessDenied()">
                            <span>🚫</span>
                            <span>Stok Yönetimi</span>
                        </div>

                        <div class="restricted-item" onclick="showAccessDenied()">
                            <span>🚫</span>
                            <span>Satınalma</span>
                        </div>

                        <div class="restricted-item" onclick="showAccessDenied()">
                            <span>🚫</span>
                            <span>Anlaşmalar-Koşullar</span>
                        </div>

                        <div class="restricted-item" onclick="showAccessDenied()">
                            <span>🚫</span>
                            <span>Kasa</span>
                        </div>

                        <div class="restricted-item" onclick="showAccessDenied()">
                            <span>🚫</span>
