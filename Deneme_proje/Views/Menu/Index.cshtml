    <script>
        function showSubMenu(menuType) {
            // Sadece satış menüsü açılabilir
            if (menuType !== 'satis') {
                showAccessDenied();
                return;
            }

            // Ana menüyü gizle
            document.getElementById('mainMenu').style.display = 'none';

            // Tüm alt menüleri gizle
            const subMenus = document.querySelectorAll('.sub-menu-section');
            subMenus.forEach(menu => {
                menu.classList.remove('active');
            });

            // Breadcrumb güncelle ve satış menüsünü göster
            const breadcrumb = document.getElementById('breadcrumb');
            document.getElementById('satisMenu').classList.add('active');
            breadcrumb.innerHTML = `
                <li class="breadcrumb-item">🛒 Uygulamalar</li>
                <li class="breadcrumb-item active">Satış</li>
            `;
        }

        function backToMain() {
            // Alt menüleri gizle
            const subMenus = document.querySelectorAll('.sub-menu-section');
            subMenus.forEach(menu => {
                menu.classList.remove('active');
            });

            // Ana menüyü göster
            document.getElementById('mainMenu').style.display = 'block';

            // Breadcrumb sıfırla
            document.getElementById('breadcrumb').innerHTML = `
                <li class="breadcrumb-item active">🛒 Uygulamalar</li>
            `;
        }

        function showAccessDenied() {
            document.getElementById('alertModal').style.display = 'flex';
        }

        function closeAlert() {
            document.getElementById('alertModal').style.display = 'none';
        }

        // Modal dışına tıklandığında kapat
        document.getElementById('alertModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeAlert();
            }
        });

        // ESC tuşu ile kapat
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeAlert();
            }
        });
    </script>
</body>
</html>