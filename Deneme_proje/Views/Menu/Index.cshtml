                        <div class="restricted-item" onclick="showAccessDenied()">
                            <span>🚫</span>
                            <span>Cari</span>
                        </div>

                        <div class="restricted-item" onclick="showAccessDenied()">
                            <span>🚫</span>
                            <span>Raporlar</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SATIŞ ALT MENÜ -->
            <div id="satisMenu" class="sub-menu-section">
