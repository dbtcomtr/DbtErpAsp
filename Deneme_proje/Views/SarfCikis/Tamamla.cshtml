@model IEnumerable<Deneme_proje.Models.SarfCikisDepartmanBazli>
@{
    ViewData["Title"] = "Sarf Çıkışları - Tamamlama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content mt-5">
    <div class="px-lg-5 py-3">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="fas fa-check-circle"></i> Tamamlanmayı Bekleyen Sarf Çıkış Talepleri</h4>
            </div>
            <div class="card-body">

                @if (!Model.Any())
                {
                    <div class="alert alert-info text-center py-5">
                        <i class="fas fa-info-circle fa-2x mb-3 d-block"></i>
                        Tamamlanacak talep bulunmuyor.
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Dikkat:</strong> Tamamlama işlemi MikroDB'ye stok hareketi yazar ve <strong>geri alınamaz</strong>!
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Evrak No</th>
                                    <th>Talep Tarihi</th>
                                    <th>Talep Eden</th>
                                    <th>Masraf Merkezi</th>
                                    <th>Departman</th>
                                    <th>Durum</th>
                                    <th class="text-center">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int sira = 1;
                                }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@sira</td>
                                        <td><strong>@item.sth_evrakno_seri-@item.sth_evrakno_sira</strong></td>
                                        <td>@item.talep_tarihi?.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@item.talep_eden_isim</td>
                                        <td>@item.masraf_merkezi_ismi</td>
                                        <td>@item.birim_adi</td>
                                        <td><span class="badge bg-warning">Bekliyor</span></td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-success tamamla-btn"
                                                    data-id="@item.Id"
                                                    data-evrak="@item.sth_evrakno_seri-@item.sth_evrakno_sira">
                                                <i class="fas fa-check"></i> Tamamla
                                            </button>
                                        </td>
                                    </tr>
                                    sira++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(function () {
            $('.tamamla-btn').click(function () {
                let btn = $(this);
                let id = btn.data('id');
                let evrak = btn.data('evrak');

                Swal.fire({
                    title: 'Emin misiniz?',
                    html: `Evrak <b>${evrak}</b> tamamlanacak.<br>
                           <small>Stok hareketleri MikroDB'ye yazılacak ve bu işlem geri alınamaz.</small>`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Evet, Tamamla',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    btn.prop('disabled', true)
                       .html('<i class="fas fa-spinner fa-spin"></i> İşleniyor...');

                    $.post('@Url.Action("TamamlaIslem", "SarfCikis")', { id: id }, function (res) {
                        if (res.success) {
                            Swal.fire('Tamamlandı', 'Stok hareketleri başarıyla kaydedildi.', 'success')
                                .then(() => location.reload());
                        } else {
                            Swal.fire('Hata', res.message || 'İşlem başarısız oldu.', 'error');
                            btn.prop('disabled', false)
                               .html('<i class="fas fa-check"></i> Tamamla');
                        }
                    }).fail(function () {
                        Swal.fire('Hata', 'Sunucuyla iletişim kurulamadı.', 'error');
                        btn.prop('disabled', false)
                           .html('<i class="fas fa-check"></i> Tamamla');
                    });
                });
            });
        });
    </script>
