@model Deneme_proje.Models.SarfCikisViewModel
@{
    ViewData["Title"] = "Sarf Çıkış Talebi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content mt-5">
    <div class="px-lg-5 py-3">
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="fas fa-boxes"></i> Sarf Çıkış Talebi Oluştur</h4>
                    </div>
                    <div class="card-body">

                        <!-- EVRAK BİLGİLERİ -->
                        <div class="row mb-4">
                            <div class="col-12"><h5 class="border-bottom pb-2 mb-3">Evrak Bilgileri</h5></div>
                        </div>
                        <div class="row mb-4 g-3">
                            <div class="col-md-3">
                                <label class="form-label">Evrak Seri No</label>
                                <input type="text" class="form-control" id="evrakSeri" value="SÇ" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Evrak Sıra No</label>
                                <input type="text" class="form-control bg-light" id="evrakSira" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Talep Tarihi</label>
                                <input type="date" class="form-control bg-light" value="@DateTime.Now.ToString("yyyy-MM-dd")" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Talep Eden</label>
                                <input type="text" class="form-control bg-light" value="@ViewBag.UserName" readonly />
                            </div>
                        </div>

                        <!-- MASRAF MERKEZİ + DEPO -->
                        <div class="row mb-4">
                            <div class="col-12"><h5 class="border-bottom pb-2 mb-3">Masraf Merkezi ve Depo</h5></div>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Ana Masraf Merkezi <span class="text-danger">*</span></label>
                                <select class="form-select" id="anaMasraf">
                                    <option value="">Seçiniz...</option>
                                    @if (Model.AnaMasrafGruplari != null)
                                    {
                                        foreach (var ana in Model.AnaMasrafGruplari)
                                        {
                                            <option value="@ana.AnaKod">@ana.AnaKod - @ana.AnaIsim</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Alt Masraf Merkezi <span class="text-danger">*</span></label>
                                <select class="form-select" id="masrafMerkezi" disabled>
                                    <option value="">Önce ana masraf merkezi seçiniz</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Çıkış Deposu <span class="text-danger">*</span></label>
                                <select class="form-select" id="cikisDepo">
                                    <option value="">Seçiniz...</option>
                                    @if (Model.Depolar != null)
                                    {
                                        foreach (var depo in Model.Depolar)
                                        {
                                            <option value="@depo.dep_no">@depo.dep_adi</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Birim Adı / Departman</label>
                                <input type="text" class="form-control" id="birimAdi" placeholder="Örn: Üretim, Paketleme, Montaj..." />
                            </div>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Sorumluluk Merkezi <span class="text-danger">*</span></label>
                                <select class="form-select" id="sorumlulukMerkezi" required>
                                    <option value="">Seçiniz...</option>
                                    @if (Model.SorumlulukMerkezleri != null)
                                    {
                                        foreach (var sm in Model.SorumlulukMerkezleri)
                                        {
                                            <option value="@sm.Kod">@sm.Kod - @sm.Isim</option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- İsterseniz buraya başka bir alan daha koyabilirsiniz -->
                            <div class="col-md-6">
                                <!-- boş bırakabilir veya başka bilgi eklenebilir -->
                            </div>
                        </div>
                        <!-- STOK EKLEME BÖLÜMÜ -->
                        <div class="row mb-4">
                            <div class="col-12"><h5 class="border-bottom pb-2 mb-3">Stok Ekleme</h5></div>
                        </div>

                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Stok Arama</label>
                                        <div class="input-group">
                                            <input type="text" class="form-control" id="stokArama" placeholder="Stok kodu veya adı..." autocomplete="off" />
                                            <button class="btn btn-outline-secondary" type="button" id="stokTemizleBtn"><i class="fas fa-times"></i></button>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold">Miktar</label>
                                        <input type="number" class="form-control" id="miktar" min="0.001" step="0.001" value="0" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold">Birim</label>
                                        <select class="form-select" id="birim" disabled>
                                            <option value="">Stok seçiniz</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold">Birim Fiyat (TL)</label>
                                        <input type="number" class="form-control" id="birimFiyat" step="0.01" value="0" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-success w-100 mt-4" id="stokEkleBtn">
                                            <i class="fas fa-plus"></i> Ekle
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Arama sonuçları alanı -->
                        <div class="row mb-4" id="stokSonucAlani" style="display:none;">
                            <div class="col-12">
                                <div class="card border-primary">
                                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-search"></i> Arama Sonuçları</span>
                                        <button type="button" class="btn btn-sm btn-light" id="sonuclariKapatBtn"><i class="fas fa-times"></i></button>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="list-group list-group-flush" id="stokListesi" style="max-height:320px; overflow-y:auto;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Uyarı ve bilgi alanları -->
                        <div id="stokYukleniyor" class="alert alert-info d-none">
                            <div class="spinner-border spinner-border-sm me-2"></div> Stoklar aranıyor...
                        </div>
                        <div id="stokMiktarUyari" class="mb-3"></div>
                        <div id="seciliStokBilgi" class="alert alert-success d-none">
                            <strong>Seçili stok:</strong> <span id="seciliStokText"></span>
                        </div>

                        <!-- Stok tablosu -->
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-hover" id="stokTablosu">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Stok Kodu</th>
                                        <th>Stok Adı</th>
                                        <th class="text-end">Miktar</th>
                                        <th>Birim</th>
                                        <th class="text-end">Birim Fiyat</th>
                                        <th class="text-end">Toplam</th>
                                        <th class="text-center">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr id="bos-satir">
                                        <td colspan="8" class="text-center text-muted py-5">
                                            <i class="fas fa-box-open fa-2x mb-3 d-block"></i>
                                            Henüz stok eklenmedi
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="6" class="text-end fw-bold">TOPLAM:</td>
                                        <td colspan="2" class="fw-bold text-end" id="genelToplam">0,00 TL</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Kaydet / İptal -->
                        <div class="text-end">
                            <button type="button" class="btn btn-lg btn-outline-secondary me-3" onclick="history.back()">
                                <i class="fas fa-arrow-left"></i> Vazgeç
                            </button>
                            <button type="button" class="btn btn-lg btn-primary" id="kaydetBtn">
                                <i class="fas fa-save"></i> Talebi Kaydet
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(function () {

            let stoklar = [];
            let satirNo = 1;
            let secilenStok = null;
            let secilenDepo = null;

            // ─── Evrak sıra numarasını backend'den çek ───
            function yukleSonSira() {
                let seri = $('#evrakSeri').val().trim() || 'SÇ';
                $.getJSON('@Url.Action("GetSonEvrakNo", "SarfCikis")', { seriNo: seri }, function (res) {
                    if (res.success) {
                        $('#evrakSira').val(res.siraNo);
                    } else {
                        $('#evrakSira').val(1);
                    }
                });
            }
            yukleSonSira();
            $('#evrakSeri').on('change', yukleSonSira);

            // Depo seçimi
            $('#cikisDepo').change(function () {
                secilenDepo = $(this).val();
                if (secilenStok && secilenDepo) {
                    stokMiktarKontrol(secilenStok.sto_kod, secilenDepo);
                }
            });

            // ─── Stok arama ───
            let aramaTimer;
            $('#stokArama').on('input', function () {
                clearTimeout(aramaTimer);
                let val = $(this).val().trim();

                if (val.length < 2) {
                    $('#stokSonucAlani, #stokYukleniyor').hide();
                    return;
                }

                aramaTimer = setTimeout(() => {
                    $('#stokYukleniyor').removeClass('d-none').show();
                    $.getJSON('@Url.Action("StokAra", "SarfCikis")', { arama: val }, function (res) {
                        $('#stokYukleniyor').hide();
                        let html = '';
                        if (res.success && res.data?.length) {
                            res.data.forEach(s => {
                                html += `
                                <a href="#" class="list-group-item list-group-item-action stok-item px-3 py-2"
                                   data-kod="${s.sto_kod}"
                                   data-isim="${s.sto_isim?.replace(/"/g,'&quot;')}"
                                   data-birim1="${s.sto_birim1_ad||''}"
                                   data-birim2="${s.sto_birim2_ad||''}"
                                   data-birim3="${s.sto_birim3_ad||''}"
                                   data-birim4="${s.sto_birim4_ad||''}">
                                    <strong>${s.sto_kod}</strong><br>
                                    <small class="text-muted">${s.sto_isim}</small>
                                    <span class="badge bg-info float-end">${s.sto_birim1_ad || '-'}</span>
                                </a>`;
                            });
                        } else {
                            html = '<div class="list-group-item text-center py-4 text-muted">Sonuç bulunamadı</div>';
                        }
                        $('#stokListesi').html(html);
                        $('#stokSonucAlani').show();
                    });
                }, 400);
            });

            // Stok seçildi
            $(document).on('click', '.stok-item', function (e) {
                e.preventDefault();
                let $el = $(this);
                secilenStok = {
                    sto_kod: $el.data('kod'),
                    sto_isim: $el.data('isim'),
                    birim1: $el.data('birim1'),
                    birim2: $el.data('birim2'),
                    birim3: $el.data('birim3'),
                    birim4: $el.data('birim4')
                };

                $('#stokArama').val(secilenStok.sto_kod + ' - ' + secilenStok.sto_isim);
                $('#stokSonucAlani').hide();
                $('#seciliStokText').text(secilenStok.sto_kod + ' – ' + secilenStok.sto_isim);
                $('#seciliStokBilgi').removeClass('d-none').show();

                // Birim seçenekleri
                let opts = '<option value="">Seçiniz</option>';
                if (secilenStok.birim1) opts += `<option value="1">${secilenStok.birim1}</option>`;
                if (secilenStok.birim2) opts += `<option value="2">${secilenStok.birim2}</option>`;
                if (secilenStok.birim3) opts += `<option value="3">${secilenStok.birim3}</option>`;
                if (secilenStok.birim4) opts += `<option value="4">${secilenStok.birim4}</option>`;
                $('#birim').html(opts).prop('disabled', false);

                if (secilenDepo) stokMiktarKontrol(secilenStok.sto_kod, secilenDepo);
                $('#miktar').focus().select();
            });

            // Stok miktar kontrol
            function stokMiktarKontrol(kod, depo) {
                if (!kod || !depo) return;
                $.getJSON('@Url.Action("GetStokMiktar", "SarfCikis")', { stokKod: kod, depoNo: depo }, res => {
                    if (res.success) {
                        let m = parseFloat(res.miktar) || 0;
                        let cls = m > 0 ? 'success' : 'danger';
                        let ico = m > 0 ? 'check-circle' : 'exclamation-triangle';
                        $('#stokMiktarUyari').html(`
                            <div class="alert alert-${cls}">
                                <i class="fas fa-${ico}"></i> Depoda mevcut: <strong>${m.toFixed(3)}</strong>
                            </div>`);
                    }
                });
            }

            // Temizle butonları
            $('#stokTemizleBtn, #sonuclariKapatBtn').click(() => {
                $('#stokArama').val('');
                $('#stokSonucAlani').hide();
                $('#seciliStokBilgi').addClass('d-none');
                $('#stokMiktarUyari').empty();
                secilenStok = null;
                $('#birim').html('<option value="">Stok seçiniz</option>').prop('disabled', true);
            });

            // Stok ekle
            $('#stokEkleBtn').click(function () {
                if (!secilenDepo) return Swal.fire('Uyarı', 'Önce çıkış deposu seçmelisiniz.', 'warning');
                if (!secilenStok) return Swal.fire('Uyarı', 'Stok seçmelisiniz.', 'warning');

                let miktar = parseFloat($('#miktar').val()) || 0;
                if (miktar <= 0) return Swal.fire('Uyarı', 'Geçerli miktar giriniz.', 'warning');

                let birimPtr = $('#birim').val();
                if (!birimPtr) return Swal.fire('Uyarı', 'Birim seçmelisiniz.', 'warning');

                let birimAd = $('#birim option:selected').text();
                let fiyat = parseFloat($('#birimFiyat').val()) || 0;
                let toplam = miktar * fiyat;

                stoklar.push({
                    sth_stok_kod: secilenStok.sto_kod,
                    sth_stok_adi: secilenStok.sto_isim,
                    sth_miktar: miktar,
                    sth_birim_pntr: parseInt(birimPtr),
                    sth_tutar: fiyat,
                    planlanan_adet: miktar,
                    birim_adi: birimAd
                });

                $('#bos-satir').remove();
                $('#stokTablosu tbody').append(`
                    <tr data-idx="${stoklar.length-1}">
                        <td>${satirNo++}</td>
                        <td>${secilenStok.sto_kod}</td>
                        <td>${secilenStok.sto_isim}</td>
                        <td class="text-end">${miktar.toFixed(3)}</td>
                        <td>${birimAd}</td>
                        <td class="text-end">${fiyat.toFixed(2)}</td>
                        <td class="text-end">${toplam.toFixed(2)}</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-danger stok-sil"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>`);

                // temizle
                $('#stokArama,#miktar,#birimFiyat').val('');
                $('#birim').prop('disabled', true).html('<option value="">Stok seçiniz</option>');
                $('#seciliStokBilgi').addClass('d-none');
                $('#stokMiktarUyari').empty();
                secilenStok = null;
                hesaplaToplam();
                Swal.fire({icon:'success', title:'Eklendi', timer:900, showConfirmButton:false});
            });

            // Silme
            $(document).on('click', '.stok-sil', function () {
                let $row = $(this).closest('tr');
                let idx = $row.data('idx');
                stoklar.splice(idx, 1);
                $row.remove();

                $('#stokTablosu tbody tr').each((i, el) => {
                    $(el).data('idx', i).find('td:first').text(i+1);
                });

                if (!stoklar.length) {
                    $('#stokTablosu tbody').html(`
                        <tr id="bos-satir">
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="fas fa-box-open fa-2x mb-3 d-block"></i>
                                Henüz stok eklenmedi
                            </td>
                        </tr>`);
                    satirNo = 1;
                }
                hesaplaToplam();
            });

            function hesaplaToplam() {
                let t = stoklar.reduce((a, b) => a + (b.sth_miktar * b.sth_tutar), 0);
                $('#genelToplam').text(t.toFixed(2) + ' TL');
            }

            // Kaydet
            $('#kaydetBtn').click(function () {
                let anaMasraf = $('#anaMasraf').val();
                let masrafKod = $('#masrafMerkezi').val();
                let masrafIsim = $('#masrafMerkezi option:selected').text().trim();
                let depo = $('#cikisDepo').val();
                let birimAdi = $('#birimAdi').val().trim();

                if (!anaMasraf) return Swal.fire('Eksik', 'Ana masraf merkezi seçmelisiniz.', 'warning');
                if (!masrafKod) return Swal.fire('Eksik', 'Alt masraf merkezi seçmelisiniz.', 'warning');
                if (!depo) return Swal.fire('Eksik', 'Çıkış deposu seçmelisiniz.', 'warning');
                if (!stoklar.length) return Swal.fire('Eksik', 'En az bir stok eklemelisiniz.', 'warning');

                let payload = {
        SarfCikis: {
            sth_evrakno_seri: $('#evrakSeri').val().trim(),
            sth_evrakno_sira: parseInt($('#evrakSira').val()) || 1,
            masraf_merkezi_kodu: masrafKod,
            masraf_merkezi_ismi: masrafIsim,
            birim_adi: birimAdi,
            sth_cikis_depo_no: parseInt(depo),

            // ─── YENİ ───
            sorumluluk_merkezi_kodu: $('#sorumlulukMerkezi').val()?.trim() || "",
            // sorumluluk_merkezi_ismi: $('#sorumlulukMerkezi option:selected').text().trim() || ""   // isterseniz
        },
        Stoklar: stoklar
    };

                Swal.fire({title:'Kaydediliyor...', allowOutsideClick:false, didOpen:()=>Swal.showLoading()});

                $.ajax({
                    url: '@Url.Action("TalepKaydet", "SarfCikis")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success(r) {
                        if (r.success) {
                            Swal.fire('Başarılı', r.message || 'Talep kaydedildi', 'success')
                                .then(() => location.href = '@Url.Action("Tamamla", "SarfCikis")');
                        } else {
                            Swal.fire('Hata', r.message || 'Kayıt yapılamadı', 'error');
                        }
                    },
                    error() {
                        Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı', 'error');
                    }
                });
            });

            // Ana masraf → alt masraf yükleme
            $('#anaMasraf').change(function () {
                let prefix = $(this).val();
                let $alt = $('#masrafMerkezi').prop('disabled', true);

                if (!prefix) {
                    $alt.html('<option value="">Önce ana grup seçin</option>');
                    return;
                }

                $alt.html('<option value="">Yükleniyor...</option>');

                $.getJSON('@Url.Action("GetAltMasrafMerkezleri", "SarfCikis")', { anaPrefix: prefix }, function (res) {
                    if (res.success && res.data?.length) {
                        let html = '<option value="">Seçiniz...</option>';
                        res.data.forEach(item => {
                            html += `<option value="${item.Kod}">${item.Kod} - ${item.Isim}</option>`;
                        });
                        $alt.html(html).prop('disabled', false);
                    } else {
                        $alt.html('<option value="">Alt grup bulunamadı</option>');
                    }
                });
            });
        });
    </script>
