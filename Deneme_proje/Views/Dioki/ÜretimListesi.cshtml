@model IEnumerable<Deneme_proje.Repository.DiokiRepository.GenisletilmisBarkodTanimi>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
<link href="~/content/assets/css/site.css" rel="stylesheet" />

<style>
    /* Genel Stil */
    .main-content {
        margin-top: 50px;
        padding: 20px;
    }

    /* Sağ Üst İş Merkezi Alanı */
    .business-unit-container {
        position: absolute;
        top: 0;
        right: 0;
        padding: 10px 20px;
        color: #fff;
        background-color: #1E3559;
        border-radius: 0 0 0 8px;
        font-size: 14px;
        display: flex;
        align-items: center;
    }

        .business-unit-container select {
            background-color: #fff;
            color: #333;
            border: none;
            border-radius: 4px;
            padding: 5px 10px;
            font-size: 14px;
            cursor: pointer;
        }

            .business-unit-container select:focus {
                outline: none;
                box-shadow: 0 0 5px rgba(0, 0, 0, 0.2);
            }

    /* Kart Stili */
    .card {
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        background-color: #fff;
    }

    .card-header {
        background: radial-gradient(circle, rgba(0, 118, 168, 1) 0%, rgba(22, 46, 84, 1) 63%);
        padding: 15px 20px;
        border-radius: 8px 8px 0 0;
    }

    .card-header-text {
        color: #fff;
        font-size: 18px;
        font-weight: bold;
        margin: 0;
    }

    /* Tablo Stili */
    .table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .table th, .table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #e0e0e0;
        }

        .table th {
            background-color: #f4f4f4;
            font-weight: bold;
            color: #333;
        }

        .table tbody tr:hover {
            background-color: #f9f9f9;
        }

    /* Buton Stili */
    .barkod-button-yeni {
        padding: 8px 15px;
        background-color: #28A745;
        color: white;
        font-weight: bold;
        border: none;
        border-radius: 20px;
        cursor: pointer;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background-color 0.3s;
    }

        .barkod-button-yeni:hover {
            background-color: #218838;
        }

    /* Hata ve Uyarı Mesajları */
    .error-message {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        border-radius: 8px;
        padding: 15px;
        margin: 10px 0;
        font-weight: bold;
    }

    .success-message {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        border-radius: 8px;
        padding: 15px;
        margin: 10px 0;
        font-weight: bold;
    }

    /* Hatalı Durum Stili */
    .faulty-status {
        color: #dc3545; /* Kırmızı renk */
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .faulty-status i {
            font-size: 14px;
        }
</style>

<div class="main-content">
    <div class="px-lg-5 px-3">
        <div class="row">
            <div class="col-sm-12 p-0">
                <div class="main-header">
                    <h4>Üretim Listesi</h4>
                    <ol class="breadcrumb breadcrumb-title breadcrumb-arrow"></ol>
                </div>
            </div>
        </div>
        <div class="business-unit-container">
            @if (ViewBag.BusinessUnits != null && ViewBag.BusinessUnits.Count > 0)
            {
                @if (ViewBag.BusinessUnits.Count == 1)
                {
                    <span>Bu iş merkezinde üretim yapmaktasınız: @ViewBag.SelectedBusinessUnit</span>
                }
                else
                {
                    <select id="businessUnitSelector" onchange="selectBusinessUnit()">
                        @foreach (var unit in ViewBag.BusinessUnits)
                        {
                            if (unit == ViewBag.SelectedBusinessUnit)
                            {
                                <option value="@unit" selected>@unit</option>
                            }
                            else
                            {
                                <option value="@unit">@unit</option>
                            }
                        }
                    </select>
                }
            }
            else
            {
                <span>İş merkezi tanımlı değil</span>
            }
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-header-text">Üretim Listesi</h5>
                    </div>
                    <div class="card-block">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Barkod Kodu</th>
                                    <th>Stok Kodu</th>
                                    <th>Parti Kodu</th>
                                    <th>Lot No</th>
                                    <th>Kullanıcı</th>
                                    <th>İş Merkezi</th>
                                    <th>Hatalı Durum</th>
                                    <th>İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.bar_kodu</td>
                                        <td>@item.bar_stokkodu</td>
                                        <td>@item.bar_partikodu</td>
                                        <td>@item.bar_lotno</td>
                                        <td>@(string.IsNullOrEmpty(item.PersonelAdi) ? "-" : $"{item.PersonelAdi} {item.PersonelSoyadi}")</td>
                                        <td>@(string.IsNullOrEmpty(item.IsMerkezi) ? "-" : item.IsMerkezi)</td>
                                        <td>
                                            @if (item.HataliDurum == "001")
                                            {
                                                <span class="faulty-status">
                                                    Hatalı <i class="fas fa-exclamation-circle"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span>Normal</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.HataliDurum != "001")
                                            {
                                                <button class="barkod-button-yeni" onclick="markAsFaulty('@item.bar_kodu')">
                                                    <i class="fas fa-exclamation-triangle"></i> Hatalı İşaretle
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div id="outputMessage"></div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function selectBusinessUnit() {
        const selectedUnit = $('#businessUnitSelector').val();
        $.ajax({
            type: 'POST',
            url: '/Dioki/SelectBusinessUnit',
            data: { businessUnit: selectedUnit },
            success: function (response) {
                if (response.success) {
                    location.reload();
                } else {
                    $('#outputMessage').html(`
                        <div class="error-message">
                            <strong>Hata:</strong> ${response.message}
                        </div>`);
                }
            },
            error: function () {
                $('#outputMessage').html(`
                    <div class="error-message">
                        <strong>Hata:</strong> İş merkezi seçimi sırasında bir hata oluştu.
                    </div>`);
            }
        });
    }

    function markAsFaulty(barkod) {
        if (confirm('Bu barkodu hatalı olarak işaretlemek istediğinize emin misiniz?')) {
            $.ajax({
                type: 'POST',
                url: '/Dioki/UretimiHataliOlarakIsaretle',
                data: { barkod: barkod },
                success: function (response) {
                    if (response.success) {
                        $('#outputMessage').html(`
                            <div class="success-message">
                                <strong>Başarılı:</strong> ${response.message}
                            </div>`);
                        setTimeout(() => location.reload(), 2000);
                    } else {
                        $('#outputMessage').html(`
                            <div class="error-message">
                                <strong>Hata:</strong> ${response.message}
                            </div>`);
                    }
                },
                error: function () {
                    $('#outputMessage').html(`
                        <div class="error-message">
                            <strong>Hata:</strong> Barkod hatalı olarak işaretlenirken bir hata oluştu.
                        </div>`);
                }
            });
        }
    }
</script>