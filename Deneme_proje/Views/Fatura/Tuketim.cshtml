@model IEnumerable<Deneme_proje.Models.Entities.IsEmriModel>
@{
    ViewData["Title"] = "Malzeme Tüketimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content mt-5">
    <div class="card">
        <div class="card-header">
            <h3>Malzeme Tüketimi</h3>
            <div class="mt-2">
                <small class="text-light">
                    <i class="fas fa-info-circle"></i>
                    <span id="is-merkezi-bilgisi">Yetkili olduğunuz iş merkezleri yükleniyor...</span>
                </small>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="row mb-4">
                    <div class="col-md-8">
                        <label for="isEmriSelect" class="form-label"><strong>İş Emri Seçin:</strong></label>
                        <select id="isEmriSelect" class="form-select" onchange="isEmriSecildi()">
                            <option value="">-- İş Emri Seçiniz --</option>
                            @foreach (var isEmri in Model)
                            {
                                <option value="@isEmri.is_Kod"
                                        data-urun-kodu="@isEmri.UrunKodu"
                                        data-urun-adi="@isEmri.UrunAdi"
                                        data-miktar="@isEmri.Miktar"
                                        data-is-merkezi="@isEmri.IsMerkezi">
                                    @isEmri.is_Kod - @isEmri.UrunAdi (Miktar: @isEmri.Miktar) [@isEmri.IsMerkezi]
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="sarfInput" class="form-label"><strong>Sarf Alanı:</strong></label>
                        <div class="input-group">
                            <input type="number" id="sarfInput" class="form-control" placeholder="Miktar" step="0.01" min="0">
                            <button class="btn btn-success" type="button" onclick="sarfGiris()">Sarf Giriş</button>
                            <button class="btn btn-warning" type="button" onclick="sarfCikis()">Sarf Çıkış</button>
                        </div>
                    </div>
                </div>

                <div id="secili-isemri-bilgi" style="display:none;" class="alert alert-info mb-4">
                    <div class="row">
                        <div class="col-md-3"><strong>İş Emri:</strong> <span id="secili-isemri"></span></div>
                        <div class="col-md-3"><strong>Ürün Kodu:</strong> <span id="secili-urun-kodu"></span></div>
                        <div class="col-md-3"><strong>Ürün Adı:</strong> <span id="secili-urun-adi"></span></div>
                        <div class="col-md-3"><strong>Planlanan Miktar:</strong> <span id="secili-miktar"></span></div>
                    </div>
                </div>

                <div id="hesaplama-bolumu" style="display:none;" class="mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="row align-items-end">
                                <div class="col-md-3">
                                    <label for="hesaplaInput" class="form-label"><strong>Üretim Miktarı:</strong></label>
                                    <input type="number" id="hesaplaInput" class="form-control" placeholder="Üretim miktarı" step="0.01" min="0">
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-primary" onclick="hesapla()">Hesapla</button>
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-secondary" onclick="temizle()">Temizle</button>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-info" onclick="hammaddeEkleModalAc()">
                                        <i class="fas fa-plus"></i> Hammadde Ekle
                                    </button>
                                </div>
                                <div class="col-md-2">
                                    <div class="alert alert-warning mb-0" style="font-size: 0.8em; padding: 0.5rem;">
                                        <strong>Uyarı:</strong> ±%10 tolerans
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="malzeme-container" style="display:none;">
                    <div class="card">
                        <div class="card-header"><h5>Malzeme Listesi</h5></div>
                        <div class="card-body">
                            <div id="loading" style="text-align:center; display:none;">
                                <div class="spinner-border" role="status"><span class="visually-hidden">Yükleniyor...</span></div>
                                <p class="mt-2">Malzemeler yükleniyor...</p>
                            </div>

                            <div id="malzeme-tablo-container" style="display:none;">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Stok Kodu</th>
                                                <th>Malzeme Adı</th>
                                                <th>Birim</th>
                                                <th>Planlanan</th>
                                                <th>Tüketilen</th>
                                                <th>Kalan</th>
                                                <th style="background-color: #dc3545; color: white;">Depoda</th>
                                                <th style="background-color: #24783a;">Hesaplanan</th>
                                                <th>Parti Dağılımı</th>
                                                <th>Tüketilecek Miktar</th>
                                                <th>Durum</th>
                                                <th>Tip</th>
                                                <th>İşlem</th>
                                            </tr>
                                        </thead>
                                        <tbody id="malzeme-tbody"></tbody>
                                    </table>
                                </div>
                            </div>

                            <div id="error-msg" class="alert alert-danger" style="display:none;"></div>
                        </div>
                    </div>
                </div>

                <div id="kaydet-container" style="display:none;" class="text-center mt-4">
                    <button id="kaydet-btn" class="btn btn-success btn-lg" onclick="tuketimKaydet()">
                        <i class="fas fa-save"></i> Tüketimi Kaydet
                    </button>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <h5>Aktif İş Emri Bulunamadı</h5>
                    <p>Şu anda tüketim yapılabilecek aktif iş emri bulunmamaktadır.</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="hammaddeModal" tabindex="-1" aria-labelledby="hammaddeModalLabel" aria-hidden="true" style="z-index: 9999;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="hammaddeModalLabel">Hammadde Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-8">
                        <label for="stokAramaInput" class="form-label">Stok Ara (İsim veya Kod):</label>
                        <div class="input-group">
                            <input type="text" id="stokAramaInput" class="form-control"
                                   placeholder="Stok ismi veya kodu ile arayın..."
                                   onkeyup="stokAra()"
                                   onkeydown="if(event.key==='Enter') { event.preventDefault(); stokKoduIleEkle(); }">
                            <button class="btn btn-outline-secondary" type="button" onclick="stokKoduIleEkle()" title="Stok kodu ile direkt ekle">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                        <small class="text-muted">Stok kodu yazıp Enter'a basarak direkt ekleyebilirsiniz</small>
                    </div>
                    <div class="col-md-4">
                        <label for="hammaddeMiktarInput" class="form-label">Miktar:</label>
                        <input type="number" id="hammaddeMiktarInput" class="form-control" placeholder="Miktar" step="0.01" min="0">
                    </div>
                </div>

                <div id="stok-sonuclari" style="display:none;">
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover table-sm">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th width="80">Seç</th>
                                    <th>Stok Kodu</th>
                                    <th>Stok Adı</th>
                                    <th>Birim</th>
                                </tr>
                            </thead>
                            <tbody id="stok-sonuclari-tbody"></tbody>
                        </table>
                    </div>
                </div>

                <div id="stok-yukleniyor" style="display:none; text-align: center; padding: 20px;">
                    <div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Yükleniyor...</span></div>
                    <span class="ms-2">Stoklar yükleniyor...</span>
                </div>

                <div id="secili-stok-bilgisi" style="display:none;" class="alert alert-success">
                    <strong>Seçilen Stok:</strong> <span id="secili-stok-adi"></span> (<span id="secili-stok-kodu"></span>)
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" onclick="hammaddeEkle()">Malzeme Listesine Ekle</button>
            </div>
        </div>
    </div>
</div>

<script>
        let currentIsEmri = '';
    let currentUrun = '';
    let currentPlanlananMiktar = 0;
    let orijinalPlanlananMiktar = 0;
    let malzemeListesi = [];
    let eklenenMalzemeler = [];
    let secilenStok = null;
    let stokAramaTimeout;
    let partiKodlari = {};
    let manuelPartiDagilimlari = {};

    document.addEventListener('DOMContentLoaded', () => {
        console.log('Sayfa yüklendi');
        isMerkeziBilgisiniGetir();
    });

    async function isMerkeziBilgisiniGetir() {
        try {
            const response = await fetch('@Url.Action("GetIsMerkezleri", "Fatura")');
            const data = await response.json();
            const isMerkeziBilgisi = document.getElementById('is-merkezi-bilgisi');

            if (data.success && data.isMerkezleri?.length) {
                const isMerkezleri = data.isMerkezleri.map(im => `${im.kod} - ${im.aciklama}`).join(', ');
                isMerkeziBilgisi.innerHTML = `<strong>Yetkili İş Merkezleri:</strong> ${isMerkezleri}`;
            } else {
                isMerkeziBilgisi.innerHTML = '<strong>Yetkili İş Merkezleri:</strong> Bilgi alınamadı';
            }
        } catch (error) {
            console.error('İş merkezi bilgisi alınırken hata:', error);
            document.getElementById('is-merkezi-bilgisi').innerHTML = '<strong>Yetkili İş Merkezleri:</strong> Hata oluştu';
        }
    }

    function isEmriSecildi() {
        const select = document.getElementById('isEmriSelect');
        const selectedOption = select.options[select.selectedIndex];

        if (!select.value) {
            resetIsEmriFormu();
            return;
        }

        currentIsEmri = select.value;
        currentUrun = selectedOption.getAttribute('data-urun-kodu');
        currentPlanlananMiktar = parseFloat(selectedOption.getAttribute('data-miktar')) || 0;
        orijinalPlanlananMiktar = currentPlanlananMiktar;

        document.getElementById('secili-isemri').textContent = currentIsEmri;
        document.getElementById('secili-urun-kodu').textContent = currentUrun;
        document.getElementById('secili-urun-adi').textContent = selectedOption.getAttribute('data-urun-adi');
        document.getElementById('secili-miktar').textContent = currentPlanlananMiktar.toFixed(2);

        document.getElementById('secili-isemri-bilgi').style.display = 'block';
        document.getElementById('hesaplama-bolumu').style.display = 'block';
        document.getElementById('sarfInput').value = '';
        document.getElementById('hesaplaInput').value = '';

        eklenenMalzemeler = [];
        partiKodlari = {};
        manuelPartiDagilimlari = {};

        malzemeListesiniGetir();
    }

    function resetIsEmriFormu() {
        document.getElementById('secili-isemri-bilgi').style.display = 'none';
        document.getElementById('hesaplama-bolumu').style.display = 'none';
        document.getElementById('malzeme-container').style.display = 'none';
        document.getElementById('kaydet-container').style.display = 'none';
        eklenenMalzemeler = [];
        partiKodlari = {};
        manuelPartiDagilimlari = {};
    }

    function sarfGiris() {
        const sarfMiktar = parseFloat(document.getElementById('sarfInput').value);
        if (!sarfMiktar || sarfMiktar <= 0) {
            alert('Lütfen geçerli bir sarf miktarı girin.');
            return;
        }

        currentPlanlananMiktar += sarfMiktar;
        document.getElementById('secili-miktar').textContent = currentPlanlananMiktar.toFixed(2);
        document.getElementById('sarfInput').value = '';
        guncelHesaplamaYap();
        showToast(`Sarf giriş yapıldı: +${sarfMiktar}`, 'success');
    }

    function sarfCikis() {
        const sarfMiktar = parseFloat(document.getElementById('sarfInput').value);
        if (!sarfMiktar || sarfMiktar <= 0) {
            alert('Lütfen geçerli bir sarf miktarı girin.');
            return;
        }

        if (currentPlanlananMiktar - sarfMiktar < 0) {
            alert('Sarf çıkış miktarı planlanan miktardan fazla olamaz.');
            return;
        }

        currentPlanlananMiktar -= sarfMiktar;
        document.getElementById('secili-miktar').textContent = currentPlanlananMiktar.toFixed(2);
        document.getElementById('sarfInput').value = '';
        guncelHesaplamaYap();
        showToast(`Sarf çıkış yapıldı: -${sarfMiktar}`, 'warning');
    }

    function showToast(message, type) {
        const toast = document.createElement('div');
        toast.className = `alert alert-${type} position-fixed`;
        toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        toast.innerHTML = `${message}<button type="button" class="btn-close float-end ms-2" onclick="this.parentElement.remove()"></button>`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    async function malzemeListesiniGetir() {
        showLoading(true);
        try {
            const response = await fetch(`@Url.Action("GetMalzemePlanlama", "Fatura")?isEmriKodu=${encodeURIComponent(currentIsEmri)}`);
            const data = await response.json();
            malzemeListesi = (data.success && data.data?.length) ? data.data : [];

            await Promise.all(malzemeListesi.map(malzeme => fetchPartiKodlari(malzeme.stokKodu)));

            malzemeTablosuOlustur();
            showLoading(false);
            document.getElementById('malzeme-tablo-container').style.display = 'block';
            document.getElementById('kaydet-container').style.display = 'block';
        } catch (error) {
            console.error('Malzeme listesi hatası:', error);
            showLoading(false);
            document.getElementById('error-msg').textContent = 'Malzeme listesi yüklenirken hata oluştu.';
            document.getElementById('error-msg').style.display = 'block';
        }
    }

    function showLoading(show) {
        document.getElementById('malzeme-container').style.display = 'block';
        document.getElementById('loading').style.display = show ? 'block' : 'none';
        document.getElementById('malzeme-tablo-container').style.display = show ? 'none' : 'block';
        document.getElementById('error-msg').style.display = 'none';
    }

    async function fetchPartiKodlari(stokKodu) {
        try {
            const response = await fetch(`@Url.Action("GetPartiKodlari", "Fatura")?stokKodu=${encodeURIComponent(stokKodu.toUpperCase())}`);
            const data = await response.json();
            if (data.success && data.partiKodlari?.length) {
                partiKodlari[stokKodu] = data.partiKodlari;
            } else {
                partiKodlari[stokKodu] = [];
            }
        } catch (error) {
            console.error(`${stokKodu} parti kodları alınırken hata:`, error);
            partiKodlari[stokKodu] = [];
        }
    }

    function cokluPartiDagilimHesapla(stokKodu, istenenMiktar) {
        // Önce manuel seçim var mı kontrol et
        if (manuelPartiDagilimlari[stokKodu]) {
            const toplam = manuelPartiDagilimlari[stokKodu].reduce((sum, parti) => sum + parti.miktar, 0);
            if (Math.abs(toplam - istenenMiktar) <= 0.01) {
                return {
                    basarili: true,
                    mesaj: 'Manuel parti seçimi',
                    dagilim: manuelPartiDagilimlari[stokKodu].map(p => ({
                        partiKodu: p.PartiKodu,
                        lotNo: p.LotNo,
                        miktar: p.miktar,
                        partiMiktar: p.partiMiktar
                    }))
                };
            }
        }

        // Otomatik parti dağılımı
        const siraliPartiler = partiKodlari[stokKodu]?.length ? [...partiKodlari[stokKodu]].sort((a, b) => a.PartiKodu.localeCompare(b.PartiKodu)) : [];

        if (!siraliPartiler.length) {
            return { basarili: false, mesaj: 'Parti bulunamadı', dagilim: [] };
        }

        const dagilim = [];
        let kalanMiktar = istenenMiktar;

        for (const parti of siraliPartiler) {
            if (kalanMiktar <= 0) break;
            const kullanilacakMiktar = Math.min(kalanMiktar, parti.Miktar);
            if (kullanilacakMiktar > 0) {
                dagilim.push({
                    partiKodu: parti.PartiKodu,
                    lotNo: parti.LotNo || '-',
                    miktar: kullanilacakMiktar,
                    partiMiktar: parti.Miktar
                });
                kalanMiktar -= kullanilacakMiktar;
            }
        }

        if (kalanMiktar > 0) {
            return {
                basarili: false,
                mesaj: `Toplam parti miktarı yetersiz. Eksik: ${kalanMiktar.toFixed(2)}`,
                dagilim: dagilim
            };
        }

        return { basarili: true, mesaj: 'Başarılı', dagilim: dagilim };
    }

    function tuketimMiktarKontrol(input) {
    const miktar = parseFloat(input.value) || 0;
    const stokKodu = input.getAttribute('data-stok');
    const originalStok = input.getAttribute('data-original-stok') || stokKodu;
    const tip = input.getAttribute('data-tip');
    const durumBadge = document.querySelector(`[data-stok="${stokKodu}"].durum-badge`);

    input.classList.remove('is-invalid', 'is-valid', 'is-warning');
    if (durumBadge) durumBadge.innerHTML = '';

    if (miktar <= 0) {
        const partiDagilimCell = document.querySelector(`td.parti-dagilim[data-stok="${stokKodu}"]`);
        if (partiDagilimCell) {
            partiDagilimCell.innerHTML = '<small class="text-muted">Miktar girin</small>';
        }
        if (manuelPartiDagilimlari[originalStok]) {
            delete manuelPartiDagilimlari[originalStok];
        }
        return;
    }

    // Manuel parti seçimi ve tolerans kontrolü
    if (manuelPartiDagilimlari[originalStok]) {
        const toplam = manuelPartiDagilimlari[originalStok].reduce((sum, parti) => sum + parti.miktar, 0);
        const hedefMiktar = miktar; // Kullanıcının girdiği miktar
        const toleransAlt = hedefMiktar * 0.9;
        const toleransUst = hedefMiktar * 1.1;

        // Manuel seçim toplamı ile girilen miktar arasında tolerans kontrolü
        if (toplam < toleransAlt || toplam > toleransUst) {
            input.classList.add('is-invalid');
            if (durumBadge) {
                durumBadge.innerHTML = `
                    <span class="badge bg-danger">
                        Parti toplamı tolerans dışı!<br>
                        Seçilen: ${toplam.toFixed(2)} | Beklenen: ${hedefMiktar.toFixed(2)}<br>
                        Tolerans: ${toleransAlt.toFixed(2)} - ${toleransUst.toFixed(2)}
                    </span>
                `;
            }
            return;
        }

        partiDagilimiGoster(stokKodu, originalStok, manuelPartiDagilimlari[originalStok]);
        input.classList.add('is-valid');
        if (durumBadge) durumBadge.innerHTML = '<span class="badge bg-success">Manuel Parti Seçimi</span>';

        if (tip === 'eklenen') {
            const index = parseInt(input.getAttribute('data-index'));
            if (!isNaN(index) && eklenenMalzemeler[index]) {
                eklenenMalzemeler[index].miktar = miktar;
                eklenenMalzemeler[index].partiDagilim = manuelPartiDagilimlari[originalStok];
            }
        }
        return;
    }

        // Otomatik parti dağılımı
        const dagilim = cokluPartiDagilimHesapla(originalStok, miktar);
        const partiDagilimCell = document.querySelector(`td.parti-dagilim[data-stok="${stokKodu}"]`);

        if (partiDagilimCell) {
            if (dagilim.basarili) {
                let dagilimHTML = '<div class="parti-dagilim-detay">';
                dagilim.dagilim.forEach((d) => {
                    dagilimHTML += `
                        <div class="mb-1">
                            <small>
                                <strong>${d.partiKodu}</strong>
                                <span class="badge bg-info">${d.miktar.toFixed(2)}</span>
                                <span class="text-muted">(Lot: ${d.lotNo})</span>
                                <button class="btn btn-sm btn-outline-warning p-0 ms-1" style="font-size: 0.7em; line-height: 1;"
                                        onclick="partiSecimModalAc('${originalStok}', '', ${miktar})" title="Parti seçimini değiştir">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </small>
                        </div>
                    `;
                });
                dagilimHTML += '</div>';
                partiDagilimCell.innerHTML = dagilimHTML;
            } else {
                partiDagilimCell.innerHTML = `<small class="text-danger">${dagilim.mesaj}</small>`;
            }
        }

        // Orijinal kontroller
        if (tip === 'eklenen') {
            if (!dagilim.basarili) {
                input.classList.add('is-invalid');
                if (durumBadge) durumBadge.innerHTML = `<span class="badge bg-danger">${dagilim.mesaj}</span>`;
                return;
            }
            input.classList.add('is-valid');
            if (durumBadge) durumBadge.innerHTML = '<span class="badge bg-success">Uygun (Çoklu Parti)</span>';

            const index = parseInt(input.getAttribute('data-index'));
            if (!isNaN(index) && eklenenMalzemeler[index]) {
                eklenenMalzemeler[index].miktar = miktar;
                eklenenMalzemeler[index].partiDagilim = dagilim.dagilim;
            }
            return;
        }

        const malzeme = malzemeListesi.find(m => m.stokKodu === originalStok);
        const depodakiMiktar = malzeme?.depodakiMiktar || 0;
        const kalanMiktar = malzeme?.kalanMiktar || 0;
        const hesaplananSpan = document.querySelector(`[data-stok="${originalStok}"].hesaplanan-miktar`);
        const hesaplananMiktar = hesaplananSpan ? parseFloat(hesaplananSpan.textContent) || 0 : 0;

        const kalanToleransAlt = kalanMiktar * 0.9;
        const kalanToleransUst = kalanMiktar * 1.1;
        const hesaplananToleransAlt = hesaplananMiktar * 0.9;
        const hesaplananToleransUst = hesaplananMiktar * 1.1;

        if (miktar > depodakiMiktar) {
            input.classList.add('is-invalid');
            if (durumBadge) durumBadge.innerHTML = '<span class="badge bg-danger">Depoda yetersiz</span>';
        } else if (!dagilim.basarili) {
            input.classList.add('is-invalid');
            if (durumBadge) durumBadge.innerHTML = `<span class="badge bg-danger">${dagilim.mesaj}</span>`;
        } else if (miktar > kalanToleransUst) {
            input.classList.add('is-invalid');
            if (durumBadge) durumBadge.innerHTML = '<span class="badge bg-danger" title="Kalan miktarın %10 üzerinde">Kalan+%10 aşıyor</span>';
        } else {
            let uyariVar = false;
            let uyariMesaj = '';

            if (hesaplananMiktar > 0) {
                if (miktar < hesaplananToleransAlt) {
                    uyariVar = true;
                    uyariMesaj = 'Hesaplanan -10%';
                } else if (miktar > hesaplananToleransUst) {
                    uyariVar = true;
                    uyariMesaj = 'Hesaplanan +10%';
                }
            }

            if (miktar < kalanToleransAlt) {
                uyariVar = true;
                uyariMesaj = 'Kalan -10%';
            } else if (miktar > kalanMiktar && miktar <= kalanToleransUst) {
                uyariVar = true;
                uyariMesaj = 'Kalan +10% tol.';
            }

            if (uyariVar) {
                input.classList.add('is-warning');
                if (durumBadge) durumBadge.innerHTML = `<span class="badge bg-warning" title="${uyariMesaj}">${uyariMesaj}</span>`;
            } else {
                input.classList.add('is-valid');
                if (durumBadge) durumBadge.innerHTML = '<span class="badge bg-success">Uygun (Çoklu Parti)</span>';
            }
        }
    }

    // Parti dağılımını göstermek için yardımcı fonksiyon
    function partiDagilimiGoster(stokKodu, originalStok, dagilim) {
        const partiDagilimCell = document.querySelector(`td.parti-dagilim[data-stok="${stokKodu}"]`);
        if (partiDagilimCell) {
            let dagilimHTML = '<div class="parti-dagilim-detay">';
            dagilim.forEach((d) => {
                dagilimHTML += `
                    <div class="mb-1">
                        <small>
                            <strong>${d.PartiKodu}</strong>
                            <span class="badge bg-info">${d.miktar.toFixed(2)}</span>
                            <span class="text-muted">(Lot: ${d.LotNo})</span>
                            <button class="btn btn-sm btn-outline-warning p-0 ms-1" style="font-size: 0.7em; line-height: 1;"
                                    onclick="partiSecimModalAc('${originalStok}', '', ${d.miktar})" title="Parti seçimini değiştir">
                                <i class="fas fa-edit"></i>
                            </button>
                        </small>
                    </div>
                `;
            });
            dagilimHTML += '</div>';
            partiDagilimCell.innerHTML = dagilimHTML;
        }
    }

    function hesapla() {
        const hedefMiktar = parseFloat(document.getElementById('hesaplaInput').value);
        if (!hedefMiktar || hedefMiktar <= 0) {
            alert('Lütfen geçerli bir üretim miktarı girin.');
            return;
        }

        const oran = hedefMiktar / currentPlanlananMiktar;
        malzemeListesi.forEach(malzeme => {
            const hesaplananMiktar = malzeme.planlananMiktar * oran;
            const hesaplananSpan = document.querySelector(`[data-stok="${malzeme.stokKodu}"].hesaplanan-miktar`);
            if (hesaplananSpan) {
                hesaplananSpan.textContent = hesaplananMiktar.toFixed(2);
            }

            const tuketimInput = document.querySelector(`[data-stok="${malzeme.stokKodu}"].tuketim-input[data-tip="planlanan"]`);
            if (tuketimInput) {
                tuketimInput.value = hesaplananMiktar.toFixed(2);
                tuketimMiktarKontrol(tuketimInput);
            }
        });
    }

    function guncelHesaplamaYap() {
        const hedefMiktar = parseFloat(document.getElementById('hesaplaInput').value);
        if (hedefMiktar && hedefMiktar > 0) hesapla();
    }

    function temizle() {
        document.getElementById('hesaplaInput').value = '';
        document.querySelectorAll('.hesaplanan-miktar').forEach(span => span.textContent = '-');
        document.querySelectorAll('.tuketim-input[data-tip="planlanan"]').forEach(input => {
            input.value = '';
            input.classList.remove('is-invalid', 'is-warning', 'is-valid');
        });
        document.querySelectorAll('.durum-badge').forEach(badge => badge.innerHTML = '');
        document.querySelectorAll('.parti-dagilim').forEach(cell => {
            cell.innerHTML = '<small class="text-muted">Miktar girin</small>';
        });
        manuelPartiDagilimlari = {};
    }

    function hammaddeEkleModalAc() {
        if (!currentIsEmri) {
            alert('Önce bir iş emri seçin.');
            return;
        }

        document.getElementById('stokAramaInput').value = '';
        document.getElementById('hammaddeMiktarInput').value = '';
        document.getElementById('stok-sonuclari').style.display = 'none';
        document.getElementById('secili-stok-bilgisi').style.display = 'none';
        secilenStok = null;

        const modal = new bootstrap.Modal(document.getElementById('hammaddeModal'));
        modal.show();
    }

    function stokAra() {
        if (stokAramaTimeout) clearTimeout(stokAramaTimeout);
        stokAramaTimeout = setTimeout(stokAramaIslem, 300);
    }

    async function stokAramaIslem() {
        const aramaMetni = document.getElementById('stokAramaInput').value.trim();
        if (aramaMetni.length < 2) {
            document.getElementById('stok-sonuclari').style.display = 'none';
            return;
        }

        try {
            const response = await fetch(`@Url.Action("GetStokListesi", "Fatura")?arama=${encodeURIComponent(aramaMetni)}`);
            const data = await response.json();
            stokSonuclariGoster(data.success && data.data?.length ? data.data : []);
        } catch (error) {
            console.error('Stok arama hatası:', error);
            document.getElementById('stok-sonuclari').style.display = 'none';
        }
    }

    function stokSonuclariGoster(stoklar) {
        const tbody = document.getElementById('stok-sonuclari-tbody');
        tbody.innerHTML = '';

        stoklar.forEach(stok => {
            const row = tbody.insertRow();
            row.innerHTML = `
                <td><button class="btn btn-sm btn-primary" onclick="stokSec('${stok.StokKodu}', '${stok.StokAdi.replace(/'/g, '&#39;')}', '${stok.BirimAdi}')">Seç</button></td>
                <td><strong>${stok.StokKodu}</strong></td>
                <td>${stok.StokAdi}</td>
                <td class="text-center">${stok.BirimAdi}</td>
            `;
        });

        document.getElementById('stok-sonuclari').style.display = stoklar.length ? 'block' : 'none';
    }

    function stokSec(stokKodu, stokAdi, birimAdi) {
        secilenStok = { stokKodu, stokAdi, birimAdi };
        document.getElementById('secili-stok-kodu').textContent = stokKodu;
        document.getElementById('secili-stok-adi').textContent = stokAdi;
        document.getElementById('secili-stok-bilgisi').style.display = 'block';
        document.getElementById('stok-sonuclari').style.display = 'none';
    }

    async function stokKoduIleEkle() {
        const stokKodu = document.getElementById('stokAramaInput').value.trim().toUpperCase();
        if (!stokKodu) {
            alert('Lütfen stok kodu girin.');
            return;
        }

        try {
            const response = await fetch(`@Url.Action("GetStokDetayByKod", "Fatura")?stokKodu=${encodeURIComponent(stokKodu)}`);
            const data = await response.json();
            if (data.success && data.data) {
                stokSec(data.data.StokKodu, data.data.StokAdi, data.data.BirimAdi);
            } else {
                alert(`Stok bulunamadı: ${stokKodu}`);
            }
        } catch (error) {
            console.error('Stok detayı alınırken hata:', error);
            alert('Stok detayı alınırken hata oluştu.');
        }
    }

    async function hammaddeEkle() {
        if (!secilenStok) {
            alert('Lütfen önce bir stok seçin.');
            return;
        }

        const miktar = parseFloat(document.getElementById('hammaddeMiktarInput').value);
        if (!miktar || miktar <= 0) {
            alert('Lütfen geçerli bir miktar girin.');
            return;
        }

        try {
            const response = await fetch(`@Url.Action("GetStokDepodakiMiktar", "Fatura")?stokKodu=${encodeURIComponent(secilenStok.stokKodu)}&depoNo=1`);
            const data = await response.json();
            const depodakiMiktar = data.success ? data.miktar : 0;

            eklenenMalzemeler.push({
                stokKodu: secilenStok.stokKodu,
                stokAdi: secilenStok.stokAdi,
                birimAdi: secilenStok.birimAdi,
                miktar,
                depodakiMiktar
            });

            await fetchPartiKodlari(secilenStok.stokKodu);
            malzemeTablosuOlustur();
            $('#hammaddeModal').modal('hide');
            showToast(`Hammadde eklendi: ${secilenStok.stokAdi}`, 'success');
        } catch (error) {
            console.error('Hammadde eklenirken hata:', error);
            alert('Hammadde eklenirken bir hata oluştu.');
        }
    }

    function malzemeTablosuOlustur() {
        const tbody = document.getElementById('malzeme-tbody');
        const mevcutHesaplananlar = {};
        const mevcutInputDegerleri = {};

        document.querySelectorAll('.hesaplanan-miktar').forEach(span => {
            const stokKodu = span.getAttribute('data-stok');
            mevcutHesaplananlar[stokKodu] = span.textContent;
        });

        document.querySelectorAll('.tuketim-input[data-tip="planlanan"]').forEach(input => {
            const stokKodu = input.getAttribute('data-stok');
            if (input.value) {
                mevcutInputDegerleri[stokKodu] = input.value;
            }
        });

        tbody.innerHTML = '';

        malzemeListesi.forEach(malzeme => {
            const row = tbody.insertRow();
            const depodakiMiktar = malzeme.depodakiMiktar || 0;
            const planliMiktar = malzeme.planlananMiktar || 0;
            const kalanMiktar = malzeme.kalanMiktar || 0;
            const toleransliMaxMiktar = kalanMiktar * 1.1;
            const depoRenk = depodakiMiktar >= planliMiktar ? 'color: green; font-weight: bold;' : 'color: red; font-weight: bold;';
            const hesaplananDeger = mevcutHesaplananlar[malzeme.stokKodu] || '-';
            const inputDeger = mevcutInputDegerleri[malzeme.stokKodu] || '';

            row.innerHTML = `
                <td><strong>${malzeme.stokKodu}</strong></td>
                <td>${malzeme.stokAdi}</td>
                <td class="text-center">${malzeme.birimAdi}</td>
                <td class="text-end">${malzeme.planlananMiktar.toFixed(2)}</td>
                <td class="text-end">${malzeme.tuketilenMiktar.toFixed(2)}</td>
                <td class="text-end"><strong>${malzeme.kalanMiktar.toFixed(2)}</strong> <small class="text-muted">(+10%: ${toleransliMaxMiktar.toFixed(2)})</small></td>
                <td class="text-end" style="${depoRenk}">${depodakiMiktar.toFixed(2)}</td>
                <td class="text-end" style="background-color: #f8f9fa;"><span class="hesaplanan-miktar" data-stok="${malzeme.stokKodu}">${hesaplananDeger}</span></td>
                <td class="parti-dagilim" data-stok="${malzeme.stokKodu}"><small class="text-muted">Miktar girin</small></td>
                <td><input type="number" class="form-control tuketim-input" data-stok="${malzeme.stokKodu}" data-planlanan="${malzeme.planlananMiktar}" data-kalan="${malzeme.kalanMiktar}" data-tip="planlanan" min="0" max="${toleransliMaxMiktar}" step="0.01" onchange="tuketimMiktarKontrol(this)" style="width: 120px;" value="${inputDeger}"></td>
                <td><span class="durum-badge" data-stok="${malzeme.stokKodu}"></span></td>
                <td><span class="badge bg-primary">Planlanan</span></td>
                <td><button class="btn btn-sm btn-warning" onclick="planliMalzemeyiTemizle('${malzeme.stokKodu}')"><i class="fas fa-times"></i></button></td>
            `;
        });

        eklenenMalzemeler.forEach((malzeme, index) => {
            const row = tbody.insertRow();
            const uniqueStokId = `${malzeme.stokKodu}_eklenen_${index}`;

            row.innerHTML = `
                <td><strong>${malzeme.stokKodu}</strong> <small class="text-muted">(#${index + 1})</small></td>
                <td>${malzeme.stokAdi}</td>
                <td class="text-center">${malzeme.birimAdi}</td>
                <td class="text-end">-</td>
                <td class="text-end">-</td>
                <td class="text-end">-</td>
                <td class="text-end" style="color: #888;">Parti'de</td>
                <td class="text-end" style="background-color: #f8f9fa;">-</td>
                <td class="parti-dagilim" data-stok="${uniqueStokId}"><small class="text-muted">Miktar girin</small></td>
                <td><input type="number" class="form-control tuketim-input" data-stok="${uniqueStokId}" data-original-stok="${malzeme.stokKodu}" data-planlanan="0" data-tip="eklenen" data-index="${index}" value="${malzeme.miktar || ''}" min="0" step="0.01" onchange="tuketimMiktarKontrol(this)" style="width: 120px;"></td>
                <td><span class="durum-badge" data-stok="${uniqueStokId}"></span></td>
                <td><span class="badge bg-warning">Eklenen</span></td>
                <td><button class="btn btn-sm btn-danger" onclick="eklenenMalzemeyiSil(${index})"><i class="fas fa-trash"></i></button></td>
            `;
        });

        setTimeout(() => {
            document.querySelectorAll('.tuketim-input').forEach(input => {
                if (input.value) {
                    tuketimMiktarKontrol(input);
                }
            });
        }, 100);
    }

    function planliMalzemeyiTemizle(stokKodu) {
        if (!confirm('Bu malzemenin tüketim miktarını temizlemek istediğinizden emin misiniz?')) {
            return;
        }

        const tuketimInput = document.querySelector(`[data-stok="${stokKodu}"].tuketim-input[data-tip="planlanan"]`);
        if (tuketimInput) {
            tuketimInput.value = '';
            tuketimMiktarKontrol(tuketimInput);
        }

        const partiDagilimCell = document.querySelector(`td.parti-dagilim[data-stok="${stokKodu}"]`);
        if (partiDagilimCell) {
            partiDagilimCell.innerHTML = '<small class="text-muted">Miktar girin</small>';
        }

        // Manuel parti seçimini temizle
        if (manuelPartiDagilimlari[stokKodu]) {
            delete manuelPartiDagilimlari[stokKodu];
        }

        malzemeTablosuOlustur();
        showToast(`Malzeme tüketimi temizlendi: ${stokKodu}`, 'info');
    }

    function eklenenMalzemeyiSil(index) {
        if (!confirm('Bu malzemeyi listeden çıkarmak istediğinizden emin misiniz?')) return;

        // Manuel parti seçimini temizle
        const stokKodu = eklenenMalzemeler[index]?.stokKodu;
        if (stokKodu && manuelPartiDagilimlari[stokKodu]) {
            delete manuelPartiDagilimlari[stokKodu];
        }

        eklenenMalzemeler.splice(index, 1);
        malzemeTablosuOlustur();
        showToast('Malzeme listeden çıkarıldı.', 'info');
    }

    // PARTİ SEÇİM MODAL FONKSİYONLARI
    let secilenPartiModal = {
        stokKodu: '',
        stokAdi: '',
        toplamMiktar: 0,
        mevcutPartiler: [],
        secilenPartiler: []
    };
    // Parti seçim modalını aç fonksiyonuna tolerans bilgisi ekle
        function partiSecimModalAc(stokKodu, stokAdi, istenenMiktar) {
        if (!partiKodlari[stokKodu] || !partiKodlari[stokKodu].length) {
            alert('Bu stok için parti bulunamadı.');
            return;
        }

        secilenPartiModal.stokKodu = stokKodu;
        secilenPartiModal.stokAdi = stokAdi;
        secilenPartiModal.toplamMiktar = istenenMiktar;
        secilenPartiModal.mevcutPartiler = [...partiKodlari[stokKodu]].sort((a, b) => a.PartiKodu.localeCompare(b.PartiKodu));

        // MEVCUT PARTİ DAĞILIMINI YÜKLE (manuel veya otomatik)
        secilenPartiModal.secilenPartiler = mevcutPartiDagiliminiGetir(stokKodu, istenenMiktar);

        // Modal içeriğini doldur
        const toleransAlt = istenenMiktar * 0.9;
        const toleransUst = istenenMiktar * 1.1;

        document.getElementById('partiSecimStokKodu').textContent = stokKodu;
        document.getElementById('partiSecimStokAdi').textContent = stokAdi || '-';
        document.getElementById('partiSecimToplamMiktar').innerHTML = `
            ${istenenMiktar.toFixed(2)}
            <br><small class="text-muted">Tolerans: ${toleransAlt.toFixed(2)} - ${toleransUst.toFixed(2)}</small>
        `;

        partiSecimTablosuOlustur();

        const modal = new bootstrap.Modal(document.getElementById('partiSecimModal'));
        modal.show();
    }

        function mevcutPartiDagiliminiGetir(stokKodu, istenenMiktar) {
        // 1. Önce manuel parti seçimi var mı kontrol et
        if (manuelPartiDagilimlari[stokKodu]) {
            console.log('Manuel parti seçimi bulundu:', manuelPartiDagilimlari[stokKodu]);
            return [...manuelPartiDagilimlari[stokKodu]];
        }

        // 2. Manuel yoksa, otomatik parti dağılımını hesapla
        const otomatikDagilim = cokluPartiDagilimHesapla(stokKodu, istenenMiktar);
        if (otomatikDagilim.basarili) {
            console.log('Otomatik parti dağılımı kullanılıyor:', otomatikDagilim.dagilim);
            return otomatikDagilim.dagilim.map(d => ({
                PartiKodu: d.partiKodu,
                LotNo: d.lotNo,
                miktar: d.miktar,
                partiMiktar: d.partiMiktar
            }));
        }

        // 3. Otomatik dağılım da başarısızsa boş döndür
        console.log('Parti dağılımı bulunamadı');
        return [];
    }


    function partiSecimTablosuOlustur() {
        const tbody = document.getElementById('partiSecimTbody');
        tbody.innerHTML = '';

        secilenPartiModal.mevcutPartiler.forEach((parti, index) => {
            const row = tbody.insertRow();

            // Bu partinin mevcut dağılımda olup olmadığını kontrol et
            const secilenParti = secilenPartiModal.secilenPartiler.find(p => p.PartiKodu === parti.PartiKodu);
            const kullanilacakMiktar = secilenParti ? secilenParti.miktar : 0;

            row.innerHTML = `
                <td>
                    <input type="checkbox" class="parti-secim-checkbox"
                           data-index="${index}"
                           ${kullanilacakMiktar > 0 ? 'checked' : ''}
                           onchange="partiSecimCheckboxChange(this)">
                </td>
                <td><strong>${parti.PartiKodu}</strong></td>
                <td>${parti.LotNo || '-'}</td>
                <td class="text-end">${parti.Miktar.toFixed(2)}</td>
                <td>
                    <input type="number" class="form-control form-control-sm parti-miktar-input"
                           data-index="${index}"
                           value="${kullanilacakMiktar.toFixed(2)}"
                           min="0" max="${parti.Miktar}" step="0.01"
                           onchange="partiMiktarChange(this)"
                           ${kullanilacakMiktar > 0 ? '' : 'disabled'}>
                </td>
                <td>
                    <span class="parti-durum-badge" data-index="${index}"></span>
                </td>
            `;

            partiMiktarDurumGuncelle(index);
        });

        partiSecimToplamGuncelle();

        // Mevcut dağılım bilgisini göster
        mevcutDagilimBilgisiniGoster();
    }

        function mevcutDagilimBilgisiniGoster() {
        const toplam = secilenPartiModal.secilenPartiler.reduce((sum, parti) => sum + parti.miktar, 0);
        const infoDiv = document.getElementById('partiSecimHata');

        if (secilenPartiModal.secilenPartiler.length > 0) {
            infoDiv.style.display = 'block';
            infoDiv.className = 'alert alert-info mt-3';

            let dagilimDetay = '';
            secilenPartiModal.secilenPartiler.forEach((parti, index) => {
                dagilimDetay += `${parti.PartiKodu}: ${parti.miktar.toFixed(2)}`;
                if (index < secilenPartiModal.secilenPartiler.length - 1) {
                    dagilimDetay += ' | ';
                }
            });

            const dagilimTuru = manuelPartiDagilimlari[secilenPartiModal.stokKodu] ? 'Manuel' : 'Otomatik';

            infoDiv.innerHTML = `
                <strong>Mevcut ${dagilimTuru} Parti Dağılımı:</strong><br>
                ${dagilimDetay}<br>
                <strong>Toplam:</strong> ${toplam.toFixed(2)} / ${secilenPartiModal.toplamMiktar.toFixed(2)}
            `;
        } else {
            infoDiv.style.display = 'none';
        }
    }


    function partiSecimCheckboxChange(checkbox) {
        const index = parseInt(checkbox.getAttribute('data-index'));
        const parti = secilenPartiModal.mevcutPartiler[index];
        const miktarInput = document.querySelector(`.parti-miktar-input[data-index="${index}"]`);

        if (checkbox.checked) {
            miktarInput.disabled = false;

            // Eğer bu parti zaten mevcut dağılımda varsa, o miktarı koru
            const mevcutSecim = secilenPartiModal.secilenPartiler.find(p => p.PartiKodu === parti.PartiKodu);
            if (mevcutSecim) {
                miktarInput.value = mevcutSecim.miktar.toFixed(2);
            } else {
                // Yeni parti seçiliyorsa, kalan ihtiyacı doldur
                const kalanIhtiyac = secilenPartiModal.toplamMiktar - secilenPartiModal.secilenPartiler.reduce((sum, p) => sum + p.miktar, 0);
                const otomatikMiktar = Math.min(parti.Miktar, kalanIhtiyac);

                miktarInput.value = otomatikMiktar.toFixed(2);
            }

            partiMiktarChange(miktarInput);
        } else {
            miktarInput.disabled = true;
            miktarInput.value = '0';
            secilenPartiModal.secilenPartiler = secilenPartiModal.secilenPartiler.filter(p => p.PartiKodu !== parti.PartiKodu);
            partiMiktarDurumGuncelle(index);
            partiSecimToplamGuncelle();
        }
    }

    // Parti miktar değişimi fonksiyonunu güncelle
    function partiMiktarChange(input) {
        const index = parseInt(input.getAttribute('data-index'));
        const parti = secilenPartiModal.mevcutPartiler[index];
        const miktar = parseFloat(input.value) || 0;

        // Temel miktar kontrolleri
        if (miktar > parti.Miktar) {
            input.classList.add('is-invalid');
            input.value = parti.Miktar.toFixed(2);
            showPartiHata(`Parti miktarını aşıyor! Maksimum: ${parti.Miktar.toFixed(2)}`);
            return;
        }

        if (miktar < 0) {
            input.classList.add('is-invalid');
            input.value = '0';
            showPartiHata('Miktar negatif olamaz!');
            return;
        }

        input.classList.remove('is-invalid');

        // Toplam miktar tolerans kontrolü
        const mevcutToplam = secilenPartiModal.secilenPartiler.reduce((sum, p) => sum + p.miktar, 0);
        const mevcutToplamDisindaki = mevcutToplam - (secilenPartiModal.secilenPartiler.find(p => p.PartiKodu === parti.PartiKodu)?.miktar || 0);
        const yeniToplam = mevcutToplamDisindaki + miktar;

        const toleransAlt = secilenPartiModal.toplamMiktar * 0.9;  // -%10
        const toleransUst = secilenPartiModal.toplamMiktar * 1.1;  // +%10

        if (yeniToplam < toleransAlt) {
            input.classList.add('is-warning');
            showPartiHata(`Toplam miktar hedeflenenin %10 altında! Minimum: ${toleransAlt.toFixed(2)}`, 'warning');
        } else if (yeniToplam > toleransUst) {
            input.classList.add('is-invalid');
            showPartiHata(`Toplam miktar hedeflenenin %10 üstünde! Maksimum: ${toleransUst.toFixed(2)}`);
            return;
        } else {
            input.classList.remove('is-warning', 'is-invalid');
            document.getElementById('partiSecimHata').style.display = 'none';
        }

        // Seçilen partileri güncelle
        const existingIndex = secilenPartiModal.secilenPartiler.findIndex(p => p.PartiKodu === parti.PartiKodu);

        if (miktar > 0) {
            if (existingIndex === -1) {
                secilenPartiModal.secilenPartiler.push({
                    PartiKodu: parti.PartiKodu,
                    LotNo: parti.LotNo || '-',
                    miktar: miktar,
                    partiMiktar: parti.Miktar
                });
            } else {
                secilenPartiModal.secilenPartiler[existingIndex].miktar = miktar;
            }
        } else {
            if (existingIndex !== -1) {
                secilenPartiModal.secilenPartiler.splice(existingIndex, 1);
            }
        }

        partiMiktarDurumGuncelle(index);
        partiSecimToplamGuncelle();
    }
        function showPartiHata(mesaj, tip = 'danger') {
        const hataDiv = document.getElementById('partiSecimHata');
        hataDiv.style.display = 'block';
        hataDiv.className = `alert alert-${tip} mt-3`;
        hataDiv.innerHTML = `<strong>${tip === 'danger' ? 'Hata:' : 'Uyarı:'}</strong> ${mesaj}`;
    }

    function partiMiktarDurumGuncelle(index) {
        const parti = secilenPartiModal.mevcutPartiler[index];
        const secilenParti = secilenPartiModal.secilenPartiler.find(p => p.PartiKodu === parti.PartiKodu);
        const durumBadge = document.querySelector(`.parti-durum-badge[data-index="${index}"]`);

        if (!durumBadge) return;

        if (secilenParti) {
            if (secilenParti.miktar > 0) {
                durumBadge.innerHTML = `<span class="badge bg-success">Seçildi</span>`;
            } else {
                durumBadge.innerHTML = `<span class="badge bg-secondary">Seçilmedi</span>`;
            }
        } else {
            durumBadge.innerHTML = `<span class="badge bg-secondary">Seçilmedi</span>`;
        }
    }

    function partiSecimToplamGuncelle() {
        const toplam = secilenPartiModal.secilenPartiler.reduce((sum, parti) => sum + parti.miktar, 0);
        document.getElementById('partiSecimSecilenToplam').textContent = toplam.toFixed(2);

        const toleransAlt = secilenPartiModal.toplamMiktar * 0.9;
        const toleransUst = secilenPartiModal.toplamMiktar * 1.1;

        const hataDiv = document.getElementById('partiSecimHata');

        if (toplam < toleransAlt) {
            hataDiv.style.display = 'block';
            hataDiv.className = 'alert alert-warning mt-3';
            hataDiv.innerHTML = `
                <strong>Uyarı:</strong> Seçilen toplam miktar (${toplam.toFixed(2)}) hedeflenenin <strong>%10 altında</strong>!
                <br>Minimum: ${toleransAlt.toFixed(2)} | Hedef: ${secilenPartiModal.toplamMiktar.toFixed(2)} | Maksimum: ${toleransUst.toFixed(2)}
            `;
        } else if (toplam > toleransUst) {
            hataDiv.style.display = 'block';
            hataDiv.className = 'alert alert-danger mt-3';
            hataDiv.innerHTML = `
                <strong>Hata:</strong> Seçilen toplam miktar (${toplam.toFixed(2)}) hedeflenenin <strong>%10 üstünde</strong>!
                <br>Minimum: ${toleransAlt.toFixed(2)} | Hedef: ${secilenPartiModal.toplamMiktar.toFixed(2)} | Maksimum: ${toleransUst.toFixed(2)}
            `;
        } else if (toplam !== secilenPartiModal.toplamMiktar) {
            hataDiv.style.display = 'block';
            hataDiv.className = 'alert alert-info mt-3';
            hataDiv.innerHTML = `
                <strong>Bilgi:</strong> Seçilen toplam miktar (${toplam.toFixed(2)}) hedeflenen (${secilenPartiModal.toplamMiktar.toFixed(2)}) ile ±%10 tolerans içinde.
                <br>Tolerans Aralığı: ${toleransAlt.toFixed(2)} - ${toleransUst.toFixed(2)}
            `;
        } else {
            hataDiv.style.display = 'none';
        }

        // Onay butonunu duruma göre güncelle
        const onayBtn = document.querySelector('#partiSecimModal .btn-primary');
        if (toplam < toleransAlt || toplam > toleransUst) {
            onayBtn.disabled = true;
            onayBtn.title = 'Toplam miktar tolerans aralığında değil';
        } else {
            onayBtn.disabled = false;
            onayBtn.title = '';
        }
    }

    function partiSecimiOnayla() {
        const toplam = secilenPartiModal.secilenPartiler.reduce((sum, parti) => sum + parti.miktar, 0);
        const toleransAlt = secilenPartiModal.toplamMiktar * 0.9;
        const toleransUst = secilenPartiModal.toplamMiktar * 1.1;

        // Tolerans kontrolü
        if (toplam < toleransAlt || toplam > toleransUst) {
            alert(`Toplam miktar (${toplam.toFixed(2)}) tolerans aralığında değil!\nKabul edilen aralık: ${toleransAlt.toFixed(2)} - ${toleransUst.toFixed(2)}`);
            return;
        }

        // Manuel parti dağılımını kaydet
        manuelPartiDagilimlari[secilenPartiModal.stokKodu] = secilenPartiModal.secilenPartiler;

        // Modal'ı kapat
        $('#partiSecimModal').modal('hide');

        // İlgili input'u bul ve güncelle
        const originalStok = secilenPartiModal.stokKodu;
        const input = document.querySelector(`.tuketim-input[data-original-stok="${originalStok}"]`) ||
                      document.querySelector(`.tuketim-input[data-stok="${originalStok}"]`);

        if (input) {
            // Miktarı manuel seçilen toplam ile güncelle
            input.value = toplam.toFixed(2);

            // Durumu güncelle
            input.classList.remove('is-invalid', 'is-warning');
            input.classList.add('is-valid');

            const stokKodu = input.getAttribute('data-stok');
            const durumBadge = document.querySelector(`.durum-badge[data-stok="${stokKodu}"]`);
            if (durumBadge) {
                durumBadge.innerHTML = '<span class="badge bg-success">Manuel Parti Seçimi</span>';
            }

            // Parti dağılımını göster
            partiDagilimiGoster(stokKodu, originalStok, secilenPartiModal.secilenPartiler);

            // Tüketim miktar kontrolünü tetikle
            tuketimMiktarKontrol(input);
        }

        showToast(`Parti seçimi güncellendi: ${secilenPartiModal.stokAdi || secilenPartiModal.stokKodu}`, 'success');
    }

    // Parti dağılımını göster fonksiyonuna tolerans bilgisi ekle
    function partiDagilimiGoster(stokKodu, originalStok, dagilim) {
        const partiDagilimCell = document.querySelector(`td.parti-dagilim[data-stok="${stokKodu}"]`);
        if (partiDagilimCell) {
            const toplamMiktar = dagilim.reduce((sum, d) => sum + d.miktar, 0);
            const hedefMiktar = secilenPartiModal.toplamMiktar;
            const toleransAlt = hedefMiktar * 0.9;
            const toleransUst = hedefMiktar * 1.1;

            let durumClass = 'bg-success';
            let durumText = 'Tolerans içinde';

            if (toplamMiktar < toleransAlt) {
                durumClass = 'bg-warning';
                durumText = '-%10 altında';
            } else if (toplamMiktar > toleransUst) {
                durumClass = 'bg-danger';
                durumText = '+%10 üstünde';
            }

            let dagilimHTML = `
                <div class="parti-dagilim-detay">
                    <div class="mb-2">
                        <small class="badge ${durumClass}">Toplam: ${toplamMiktar.toFixed(2)} | ${durumText}</small>
                    </div>
            `;

            dagilim.forEach((d) => {
                dagilimHTML += `
                    <div class="mb-1">
                        <small>
                            <strong>${d.PartiKodu}</strong>
                            <span class="badge bg-info">${d.miktar.toFixed(2)}</span>
                            <span class="text-muted">(Lot: ${d.LotNo})</span>
                            <button class="btn btn-sm btn-outline-warning p-0 ms-1" style="font-size: 0.7em; line-height: 1;"
                                    onclick="partiSecimModalAc('${originalStok}', '', ${hedefMiktar})" title="Parti seçimini değiştir">
                                <i class="fas fa-edit"></i>
                            </button>
                        </small>
                    </div>
                `;
            });
            dagilimHTML += '</div>';
            partiDagilimCell.innerHTML = dagilimHTML;
        }
    }

    async function tuketimKaydet() {
        if (!currentIsEmri) {
            alert('İş emri seçilmedi.');
            return;
        }

        const gecersizInputlar = document.querySelectorAll('.tuketim-input.is-invalid');
        if (gecersizInputlar.length) {
            alert('Kırmızı işaretli alanları düzeltin.');
            return;
        }

        const tuketimVerileri = [];
        let hataVar = false;

        document.querySelectorAll('.tuketim-input').forEach(input => {
            const miktar = parseFloat(input.value) || 0;
            if (miktar > 0) {
                const stokKodu = input.getAttribute('data-stok');
                const originalStok = input.getAttribute('data-original-stok') || stokKodu;
                const tip = input.getAttribute('data-tip');

                let dagilim;

                // Manuel parti seçimi varsa onu kullan
                if (manuelPartiDagilimlari[originalStok]) {
                    dagilim = {
                        basarili: true,
                        dagilim: manuelPartiDagilimlari[originalStok].map(p => ({
                            partiKodu: p.PartiKodu,
                            lotNo: p.LotNo,
                            miktar: p.miktar
                        }))
                    };
                } else {
                    // Otomatik parti dağılımı
                    dagilim = cokluPartiDagilimHesapla(originalStok, miktar);
                }

                if (!dagilim.basarili) {
                    alert(`Stok ${originalStok}: ${dagilim.mesaj}`);
                    hataVar = true;
                    return;
                }

                dagilim.dagilim.forEach(parti => {
                    tuketimVerileri.push({
                        StokKodu: originalStok,
                        Miktar: parti.miktar,
                        PartiKodu: parti.partiKodu,
                        Tip: tip,
                        Aciklama: `${parti.partiKodu} - Lot: ${parti.lotNo} (${parti.miktar.toFixed(2)}/${miktar.toFixed(2)})`
                    });
                });
            }
        });

        if (hataVar) return;

        if (!tuketimVerileri.length) {
            alert('Tüketilecek malzeme seçilmedi.');
            return;
        }

        const groupedData = tuketimVerileri.reduce((acc, item) => {
            const key = `${item.StokKodu}-${item.PartiKodu}-${item.Tip}`;
            if (acc[key]) {
                acc[key].Miktar += item.Miktar;
            } else {
                acc[key] = { ...item };
            }
            return acc;
        }, {});

        const finalTuketimVerileri = Object.values(groupedData);
        const planliTuketimListesi = finalTuketimVerileri
            .filter(t => t.Tip === 'planlanan')
            .map(t => ({
                StokKodu: t.StokKodu,
                Miktar: t.Miktar,
                PartiKodu: t.PartiKodu,
                Aciklama: t.Aciklama
            }));

        const eklenenTuketimListesi = finalTuketimVerileri
            .filter(t => t.Tip === 'eklenen')
            .map(t => ({
                StokKodu: t.StokKodu,
                Miktar: t.Miktar,
                PartiKodu: t.PartiKodu,
                Aciklama: t.Aciklama
            }));

        const requestData = {
            IsEmriKodu: currentIsEmri,
            TuketimListesi: planliTuketimListesi,
            EklenenMalzemeler: eklenenTuketimListesi,
            UretimMiktari: parseFloat(document.getElementById('hesaplaInput').value) || null
        };

        console.log('Gönderilecek veri:', JSON.stringify(requestData, null, 2));

        const btn = document.getElementById('kaydet-btn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>İşleniyor...';

        try {
            const response = await fetch('@Url.Action("MalzemeTuketimi", "Fatura")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(requestData)
            });

            const data = await response.json();
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save"></i> Tüketimi Kaydet';

            if (data.success) {
                alert(`Başarılı: ${data.message}`);
                location.reload();
            } else {
                alert(`Hata: ${data.message}`);
            }
        } catch (error) {
            console.error('AJAX Hata:', error);
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save"></i> Tüketimi Kaydet';
            alert(`Hata: ${error.message}`);
        }
    }
</script>
