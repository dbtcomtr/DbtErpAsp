@model IEnumerable<Deneme_proje.Models.Entities.IsEmriModel>
@{
    ViewData["Title"] = "Malzeme Tüketimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content mt-5">
    <div class="card">
        <div class="card-header">
            <h3>Malzeme Tüketimi</h3>
            <!-- İş Merkezi Bilgisi -->
            <div class="mt-2">
                <small class="text-light">
                    <i class="fas fa-info-circle"></i>
                    <span id="is-merkezi-bilgisi">Yetkili olduğunuz iş merkezleri yükleniyor...</span>
                </small>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <!-- İş Emri Seçim Bölümü -->
                <div class="row mb-4">
                    <div class="col-md-8">
                        <label for="isEmriSelect" class="form-label"><strong>İş Emri Seçin:</strong></label>
                        <select id="isEmriSelect" class="form-select" onchange="isEmriSecildi()">
                            <option value="">-- İş Emri Seçiniz --</option>
                            @foreach (var isEmri in Model)
                            {
                                <option value="@isEmri.is_Kod"
                                        data-urun-kodu="@isEmri.UrunKodu"
                                        data-urun-adi="@isEmri.UrunAdi"
                                        data-miktar="@isEmri.Miktar"
                                        data-is-merkezi="@isEmri.IsMerkezi">
                                    @isEmri.is_Kod - @isEmri.UrunAdi (Miktar: @isEmri.Miktar) [@isEmri.IsMerkezi]
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="sarfInput" class="form-label"><strong>Sarf Alanı:</strong></label>
                        <div class="input-group">
                            <input type="number" id="sarfInput" class="form-control" placeholder="Miktar" step="0.01" min="0">
                            <button class="btn btn-success" type="button" onclick="sarfGiris()">Sarf Giriş</button>
                            <button class="btn btn-warning" type="button" onclick="sarfCikis()">Sarf Çıkış</button>
                        </div>
                    </div>
                </div>

                <!-- Seçili İş Emri Bilgileri -->
                <div id="secili-isemri-bilgi" style="display:none;" class="alert alert-info mb-4">
                    <div class="row">
                        <div class="col-md-3">
                            <strong>İş Emri:</strong> <span id="secili-isemri"></span>
                        </div>
                        <div class="col-md-3">
                            <strong>Ürün Kodu:</strong> <span id="secili-urun-kodu"></span>
                        </div>
                        <div class="col-md-3">
                            <strong>Ürün Adı:</strong> <span id="secili-urun-adi"></span>
                        </div>
                        <div class="col-md-3">
                            <strong>Planlanan Miktar:</strong> <span id="secili-miktar"></span>
                        </div>
                    </div>
                </div>

                <!-- Hesaplama Bölümü -->
                <div id="hesaplama-bolumu" style="display:none;" class="mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="row align-items-end">
                                <div class="col-md-3">
                                    <label for="hesaplaInput" class="form-label"><strong>Üretim Miktarı:</strong></label>
                                    <input type="number" id="hesaplaInput" class="form-control" placeholder="Üretim miktarı" step="0.01" min="0">
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-primary" onclick="hesapla()">Hesapla</button>
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-secondary" onclick="temizle()">Temizle</button>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-info" onclick="hammaddeEkleModalAc()">
                                        <i class="fas fa-plus"></i> Hammadde Ekle
                                    </button>
                                </div>
                                <div class="col-md-2">
                                    <div class="alert alert-warning mb-0" style="font-size: 0.8em; padding: 0.5rem;">
                                        <strong>Uyarı:</strong> ±%10 tolerans
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Malzeme Listesi -->
                <div id="malzeme-container" style="display:none;">
                    <div class="card">
                        <div class="card-header">
                            <h5>Malzeme Listesi</h5>
                        </div>
                        <div class="card-body">
                            <div id="loading" style="text-align:center; display:none;">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">Yükleniyor...</span>
                                </div>
                                <p class="mt-2">Malzemeler yükleniyor...</p>
                            </div>

                            <div id="malzeme-tablo-container" style="display:none;">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Stok Kodu</th>
                                                <th>Malzeme Adı</th>
                                                <th>Birim</th>
                                                <th>Planlanan</th>
                                                <th>Tüketilen</th>
                                                <th>Kalan</th>
                                                <th style="background-color: #dc3545; color: white;">Depoda</th>
                                                <th style="background-color: #24783a;">Hesaplanan</th>
                                                <th>Parti Kodu</th>
                                                <th>Tüketilecek Miktar</th>
                                                <th>Durum</th>
                                                <th>Tip</th>
                                                <th>İşlem</th>
                                            </tr>
                                        </thead>
                                        <tbody id="malzeme-tbody">
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div id="error-msg" class="alert alert-danger" style="display:none;"></div>
                        </div>
                    </div>
                </div>

                <!-- Kaydet Butonu -->
                <div id="kaydet-container" style="display:none;" class="text-center mt-4">
                    <button id="kaydet-btn" class="btn btn-success btn-lg" onclick="tuketimKaydet()">
                        <i class="fas fa-save"></i> Tüketimi Kaydet
                    </button>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <h5>Aktif İş Emri Bulunamadı</h5>
                    <p>Şu anda tüketim yapılabilecek aktif iş emri bulunmamaktadır.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Hammadde Ekleme Modalı -->
<div class="modal fade" id="hammaddeModal" tabindex="-1" aria-labelledby="hammaddeModalLabel" aria-hidden="true" style="z-index: 9999;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="hammaddeModalLabel">Hammadde Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-8">
                        <label for="stokAramaInput" class="form-label">Stok Ara (İsim veya Kod):</label>
                        <div class="input-group">
                            <input type="text" id="stokAramaInput" class="form-control"
                                   placeholder="Stok ismi veya kodu ile arayın..."
                                   onkeyup="stokAra()"
                                   onkeydown="if(event.key==='Enter') { event.preventDefault(); stokKoduIleEkle(); }">
                            <button class="btn btn-outline-secondary" type="button" onclick="stokKoduIleEkle()" title="Stok kodu ile direkt ekle">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                        <small class="text-muted">Stok kodu yazıp Enter'a basarak direkt ekleyebilirsiniz</small>
                    </div>
                    <div class="col-md-4">
                        <label for="hammaddeMiktarInput" class="form-label">Miktar:</label>
                        <input type="number" id="hammaddeMiktarInput" class="form-control" placeholder="Miktar" step="0.01" min="0">
                    </div>
                </div>

                <div id="stok-sonuclari" style="display:none;">
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover table-sm">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th width="80">Seç</th>
                                    <th>Stok Kodu</th>
                                    <th>Stok Adı</th>
                                    <th>Birim</th>

                                </tr>
                            </thead>
                            <tbody id="stok-sonuclari-tbody">
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="stok-yukleniyor" style="display:none; text-align: center; padding: 20px;">
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                    <span class="ms-2">Stoklar yükleniyor...</span>
                </div>

                <div id="secili-stok-bilgisi" style="display:none;" class="alert alert-success">
                    <strong>Seçilen Stok:</strong> <span id="secili-stok-adi"></span> (<span id="secili-stok-kodu"></span>)
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" onclick="hammaddeEkle()">Malzeme Listesine Ekle</button>
            </div>
        </div>
    </div>
</div>

 <script>
    // Global değişkenler
    let currentIsEmri = '';
    let currentUrun = '';
    let currentPlanlananMiktar = 0;
    let orijinalPlanlananMiktar = 0;
    let malzemeListesi = [];
    let eklenenMalzemeler = [];
    let secilenStok = null;
    let stokAramaTimeout;
    let partiKodlari = {};

    // DOM yüklendiğinde
    document.addEventListener('DOMContentLoaded', () => {
        console.log('Sayfa yüklendi');
        isMerkeziBilgisiniGetir();
    });

    // İş merkezi bilgisini getir
    async function isMerkeziBilgisiniGetir() {
        try {
            const response = await fetch('@Url.Action("GetIsMerkezleri", "Fatura")');
            const data = await response.json();

            const isMerkeziBilgisi = document.getElementById('is-merkezi-bilgisi');
            if (data.success && data.isMerkezleri?.length) {
                const isMerkezleri = data.isMerkezleri.map(im => `${im.kod} - ${im.aciklama}`).join(', ');
                isMerkeziBilgisi.innerHTML = `<strong>Yetkili İş Merkezleri:</strong> ${isMerkezleri}`;
            } else {
                isMerkeziBilgisi.innerHTML = '<strong>Yetkili İş Merkezleri:</strong> Bilgi alınamadı';
            }
        } catch (error) {
            console.error('İş merkezi bilgisi alınırken hata:', error);
            document.getElementById('is-merkezi-bilgisi').innerHTML = '<strong>Yetkili İş Merkezleri:</strong> Hata oluştu';
        }
    }

    // İş emri seçildiğinde
    function isEmriSecildi() {
        const select = document.getElementById('isEmriSelect');
        const selectedOption = select.options[select.selectedIndex];

        if (!select.value) {
            resetIsEmriFormu();
            return;
        }

        currentIsEmri = select.value;
        currentUrun = selectedOption.getAttribute('data-urun-kodu');
        currentPlanlananMiktar = parseFloat(selectedOption.getAttribute('data-miktar')) || 0;
        orijinalPlanlananMiktar = currentPlanlananMiktar;

        // UI güncellemeleri
        document.getElementById('secili-isemri').textContent = currentIsEmri;
        document.getElementById('secili-urun-kodu').textContent = currentUrun;
        document.getElementById('secili-urun-adi').textContent = selectedOption.getAttribute('data-urun-adi');
        document.getElementById('secili-miktar').textContent = currentPlanlananMiktar.toFixed(2);
        document.getElementById('secili-isemri-bilgi').style.display = 'block';
        document.getElementById('hesaplama-bolumu').style.display = 'block';

        // Formu sıfırla
        document.getElementById('sarfInput').value = '';
        document.getElementById('hesaplaInput').value = '';
        eklenenMalzemeler = [];
        partiKodlari = {};

        // Malzeme listesini yükle
        malzemeListesiniGetir();
    }

    // Formu sıfırlama
    function resetIsEmriFormu() {
        document.getElementById('secili-isemri-bilgi').style.display = 'none';
        document.getElementById('hesaplama-bolumu').style.display = 'none';
        document.getElementById('malzeme-container').style.display = 'none';
        document.getElementById('kaydet-container').style.display = 'none';
        eklenenMalzemeler = [];
        partiKodlari = {};
    }

    // Sarf giriş/çıkış fonksiyonları
    function sarfGiris() {
        const sarfMiktar = parseFloat(document.getElementById('sarfInput').value);
        if (!sarfMiktar || sarfMiktar <= 0) {
            alert('Lütfen geçerli bir sarf miktarı girin.');
            return;
        }

        currentPlanlananMiktar += sarfMiktar;
        document.getElementById('secili-miktar').textContent = currentPlanlananMiktar.toFixed(2);
        document.getElementById('sarfInput').value = '';
        guncelHesaplamaYap();
        showToast(`Sarf giriş yapıldı: +${sarfMiktar}`, 'success');
    }

    function sarfCikis() {
        const sarfMiktar = parseFloat(document.getElementById('sarfInput').value);
        if (!sarfMiktar || sarfMiktar <= 0) {
            alert('Lütfen geçerli bir sarf miktarı girin.');
            return;
        }

        if (currentPlanlananMiktar - sarfMiktar < 0) {
            alert('Sarf çıkış miktarı planlanan miktardan fazla olamaz.');
            return;
        }

        currentPlanlananMiktar -= sarfMiktar;
        document.getElementById('secili-miktar').textContent = currentPlanlananMiktar.toFixed(2);
        document.getElementById('sarfInput').value = '';
        guncelHesaplamaYap();
        showToast(`Sarf çıkış yapıldı: -${sarfMiktar}`, 'warning');
    }

    // Toast mesajı göster
    function showToast(message, type) {
        const toast = document.createElement('div');
        toast.className = `alert alert-${type} position-fixed`;
        toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        toast.innerHTML = `${message}<button type="button" class="btn-close float-end ms-2" onclick="this.parentElement.remove()"></button>`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    // Malzeme listesini getir
    async function malzemeListesiniGetir() {
        showLoading(true);

        try {
            const response = await fetch(`@Url.Action("GetMalzemePlanlama", "Fatura")?isEmriKodu=${encodeURIComponent(currentIsEmri)}`);
            const data = await response.json();

            malzemeListesi = (data.success && data.data?.length) ? data.data : [];

            // Parti kodlarını yükle
            await Promise.all(malzemeListesi.map(malzeme => fetchPartiKodlari(malzeme.stokKodu)));

            malzemeTablosuOlustur();
            showLoading(false);
            document.getElementById('malzeme-tablo-container').style.display = 'block';
            document.getElementById('kaydet-container').style.display = 'block';
        } catch (error) {
            console.error('Malzeme listesi hatası:', error);
            showLoading(false);
            document.getElementById('error-msg').textContent = 'Malzeme listesi yüklenirken hata oluştu.';
            document.getElementById('error-msg').style.display = 'block';
        }
    }

    // Yükleniyor göstergesini yönet
    function showLoading(show) {
        document.getElementById('malzeme-container').style.display = 'block';
        document.getElementById('loading').style.display = show ? 'block' : 'none';
        document.getElementById('malzeme-tablo-container').style.display = show ? 'none' : 'block';
        document.getElementById('error-msg').style.display = 'none';
    }

    // Parti kodlarını getir
    async function fetchPartiKodlari(stokKodu) {
        try {
            console.log(`Parti kodları getiriliyor: ${stokKodu}`);
            const response = await fetch(`@Url.Action("GetPartiKodlari", "Fatura")?stokKodu=${encodeURIComponent(stokKodu.toUpperCase())}`);
            const data = await response.json();

            if (data.success && data.partiKodlari?.length) {
                partiKodlari[stokKodu] = data.partiKodlari;
                console.log(`${stokKodu} için ${data.partiKodlari.length} parti kodu alındı:`, data.partiKodlari);
            } else {
                partiKodlari[stokKodu] = [];
                console.log(`${stokKodu} için parti kodu bulunamadı`);
            }
        } catch (error) {
            console.error(`${stokKodu} parti kodları alınırken hata:`, error);
            partiKodlari[stokKodu] = [];
        }
    }

    // Parti seçildiğinde
    function partiSecildi(selectElement) {
        const stokKodu = selectElement.getAttribute('data-stok');
        const tuketimInput = document.querySelector(`input.tuketim-input[data-stok="${stokKodu}"]`);

        if (tuketimInput && tuketimInput.value) {
            tuketimMiktarKontrol(tuketimInput);
        }
    }


    // Tüketim miktar kontrolü - Güncellenmiş versiyon
    function tuketimMiktarKontrol(input) {
         const miktar = parseFloat(input.value) || 0;
         const stokKodu = input.getAttribute('data-stok');
         const originalStok = input.getAttribute('data-original-stok') || stokKodu;
         const tip = input.getAttribute('data-tip');
         const durumBadge = document.querySelector(`[data-stok="${stokKodu}"].durum-badge`);

         // Parti bilgilerini al
         const partiSelect = document.querySelector(`select.parti-select[data-stok="${stokKodu}"]`);
         const selectedOption = partiSelect?.selectedOptions[0];
         const partiMiktar = selectedOption ? parseFloat(selectedOption.getAttribute('data-miktar') || 0) : 0;
         const partiKodu = selectedOption ? selectedOption.value : '';

         // Hesaplanan miktarı al (tolerans kontrolü için)
         const hesaplananSpan = document.querySelector(`[data-stok="${originalStok}"].hesaplanan-miktar`);
         const hesaplananMiktar = hesaplananSpan ? parseFloat(hesaplananSpan.textContent) || 0 : 0;

         input.classList.remove('is-invalid', 'is-valid', 'is-warning');
         durumBadge.innerHTML = '';

         if (tip === 'eklenen') {
             // Eklenen malzemeler için parti miktar kontrolü (değişiklik yok)
             if (miktar <= 0) {
                 return;
             }

             if (!partiKodu) {
                 input.classList.add('is-warning');
                 durumBadge.innerHTML = '<span class="badge bg-warning">Parti seçin</span>';
                 return;
             }

             if (miktar > partiMiktar) {
                 input.classList.add('is-invalid');
                 durumBadge.innerHTML = '<span class="badge bg-danger">Partide yetersiz</span>';
                 return;
             }

             input.classList.add('is-valid');
             durumBadge.innerHTML = '<span class="badge bg-success">Uygun</span>';

             const index = parseInt(input.getAttribute('data-index'));
             if (!isNaN(index) && eklenenMalzemeler[index]) {
                 eklenenMalzemeler[index].miktar = miktar;
             }

             return;
         }

         // Planlanan malzemeler için kontroller - TOLERANS İLE GÜNCELLENDİ
         const malzeme = malzemeListesi.find(m => m.stokKodu === originalStok);
         const depodakiMiktar = malzeme?.depodakiMiktar || 0;
         const kalanMiktar = malzeme?.kalanMiktar || 0;

         // Tolerans hesaplamaları
         const kalanToleransAlt = kalanMiktar * 0.9;  // Kalan miktar -10%
         const kalanToleransUst = kalanMiktar * 1.1;  // Kalan miktar +10%
         const hesaplananToleransAlt = hesaplananMiktar * 0.9;  // Hesaplanan -10%
         const hesaplananToleransUst = hesaplananMiktar * 1.1;  // Hesaplanan +10%

         // Miktar 0 ise kontrole gerek yok
         if (miktar <= 0) {
             return;
         }

         // Öncelik sırası: Depoda miktar > Parti miktar > Toleranslı kalan miktar > Toleranslı hesaplanan miktar
         if (miktar > depodakiMiktar) {
             input.classList.add('is-invalid');
             durumBadge.innerHTML = '<span class="badge bg-danger">Depoda yetersiz</span>';
         } else if (partiKodu && miktar > partiMiktar) {
             input.classList.add('is-invalid');
             durumBadge.innerHTML = '<span class="badge bg-danger">Partide yetersiz</span>';
         } else if (miktar > kalanToleransUst) {
             input.classList.add('is-invalid');
             durumBadge.innerHTML = '<span class="badge bg-danger" title="Kalan miktarın %10 üzerinde">Kalan+%10 aşıyor</span>';
         } else if (!partiKodu && partiKodlari[originalStok]?.length > 0) {
             input.classList.add('is-warning');
             durumBadge.innerHTML = '<span class="badge bg-warning">Parti seçin</span>';
         } else {
             // Tolerans aralıklarını kontrol et
             if (hesaplananMiktar > 0) {
                 if (miktar < hesaplananToleransAlt) {
                     input.classList.add('is-warning');
                     durumBadge.innerHTML = '<span class="badge bg-warning" title="Hesaplanan miktardan %10 düşük">Hesaplanan -10%</span>';
                 } else if (miktar > hesaplananToleransUst) {
                     input.classList.add('is-warning');
                     durumBadge.innerHTML = '<span class="badge bg-warning" title="Hesaplanan miktardan %10 yüksek">Hesaplanan +10%</span>';
                 } else if (miktar < kalanToleransAlt) {
                     input.classList.add('is-warning');
                     durumBadge.innerHTML = '<span class="badge bg-warning" title="Kalan miktardan %10 düşük">Kalan -10%</span>';
                 } else if (miktar > kalanMiktar && miktar <= kalanToleransUst) {
                     input.classList.add('is-warning');
                     durumBadge.innerHTML = '<span class="badge bg-warning" title="Kalan miktarın %10 toleransında">Kalan +10% tol.</span>';
                 } else {
                     // Her şey normal aralıkta
                     input.classList.add('is-valid');
                     durumBadge.innerHTML = '<span class="badge bg-success">Uygun</span>';
                 }
             } else {
                 // Hesaplanan miktar yoksa sadece kalan miktar toleransı
                 if (miktar < kalanToleransAlt) {
                     input.classList.add('is-warning');
                     durumBadge.innerHTML = '<span class="badge bg-warning" title="Kalan miktardan %10 düşük">Kalan -10%</span>';
                 } else if (miktar > kalanMiktar && miktar <= kalanToleransUst) {
                     input.classList.add('is-warning');
                     durumBadge.innerHTML = '<span class="badge bg-warning" title="Kalan miktarın %10 toleransında">Kalan +10% tol.</span>';
                 } else {
                     input.classList.add('is-valid');
                     durumBadge.innerHTML = '<span class="badge bg-success">Uygun</span>';
                 }
             }
         }
     }

    // Tolerans uyarı mesajını da güncelleyelim
    function updateToleranceWarning() {
        const warningDiv = document.querySelector('.alert-warning');
        if (warningDiv) {
            warningDiv.innerHTML = '<strong>Uyarı:</strong> Hesaplanan miktara göre ±%10 tolerans kontrolü yapılır';
        }
    }

    // Hesaplama fonksiyonu
    function hesapla() {
        const hedefMiktar = parseFloat(document.getElementById('hesaplaInput').value);
        if (!hedefMiktar || hedefMiktar <= 0) {
            alert('Lütfen geçerli bir üretim miktarı girin.');
            return;
        }

        const oran = hedefMiktar / currentPlanlananMiktar;

        // Önce mevcut çoklu satırları temizle
        temizleCokluPartiSatirlari();

        malzemeListesi.forEach(malzeme => {
            const hesaplananMiktar = malzeme.planlananMiktar * oran;
            const hesaplananSpan = document.querySelector(`[data-stok="${malzeme.stokKodu}"].hesaplanan-miktar`);

            if (hesaplananSpan) {
                hesaplananSpan.textContent = hesaplananMiktar.toFixed(2);
            }

            // Parti kontrolü ve çoklu satır oluşturma
            const partiListesi = partiKodlari[malzeme.stokKodu] || [];
            if (partiListesi.length > 0) {
                createMultiPartiRows(malzeme, hesaplananMiktar, partiListesi);
            } else {
                // Parti yoksa normal input'u güncelle
                const tuketimInput = document.querySelector(`[data-stok="${malzeme.stokKodu}"].tuketim-input[data-tip="planlanan"]`);
                if (tuketimInput) {
                    tuketimInput.value = hesaplananMiktar.toFixed(2);
                    tuketimMiktarKontrol(tuketimInput);
                }
            }
        });
    }

    // createPartiSelectHtml fonksiyonunu değiştirin:
    function createPartiSelectHtml(stokKodu, siraliPartiKodlari) {
        let partiSelect = `<select class="form-select parti-select" data-stok="${stokKodu}" style="width: 150px;" onchange="tuketimMiktarKontrol(document.querySelector('[data-stok=\\'${stokKodu}\\'].tuketim-input'))">`;
        partiSelect += '<option value="">-- Parti Seç --</option>';

        if (siraliPartiKodlari.length) {
            // EN KÜÇÜK PARTİ KODUNA göre sıralama
            const partiKodunaGoreSirali = [...siraliPartiKodlari].sort((a, b) => {
                return a.PartiKodu.localeCompare(b.PartiKodu);
            });

            partiKodunaGoreSirali.forEach((parti, index) => {
                // İlk parti (en küçük parti kodu) otomatik seçili
                const selected = index === 0 ? 'selected' : '';
                partiSelect += `<option value="${parti.PartiKodu}" data-miktar="${parti.Miktar}" ${selected}>${parti.PartiKodu} (Miktar: ${parti.Miktar.toFixed(2)}, Lot: ${parti.LotNo || '-'})</option>`;
            });
        } else {
            partiSelect += '<option value="">Parti bulunamadı</option>';
        }
        partiSelect += '</select>';

        return partiSelect;
    }

    // createMultiPartiRows fonksiyonunu da güncelleyin:
    function createMultiPartiRows(malzeme, gerekliMiktar, partiListesi) {
        // Partileri parti koduna göre sırala (alfabetik olarak en küçük önce)
        const siraliPartiler = [...partiListesi].sort((a, b) => {
            return a.PartiKodu.localeCompare(b.PartiKodu);
        });

        let kalanMiktar = gerekliMiktar;
        let satirIndex = 0;

        // Ana satırdaki input'u bul
        const anaInput = document.querySelector(`[data-stok="${malzeme.stokKodu}"].tuketim-input[data-tip="planlanan"]`);
        const anaRow = anaInput ? anaInput.closest('tr') : null;

        siraliPartiler.forEach((parti, index) => {
            if (kalanMiktar <= 0) return;

            const kullanilacakMiktar = Math.min(kalanMiktar, parti.Miktar);

            if (satirIndex === 0) {
                // İlk parti için ana satırı kullan
                if (anaInput) {
                    anaInput.value = kullanilacakMiktar.toFixed(2);

                    // Parti seçimini güncelle
                    const partiSelect = anaRow.querySelector('.parti-select');
                    if (partiSelect) {
                        partiSelect.value = parti.PartiKodu;
                    }

                    tuketimMiktarKontrol(anaInput);
                }
            } else {
                // Ek satır oluştur
                createAdditionalPartiRow(malzeme, parti, kullanilacakMiktar, anaRow, satirIndex);
            }

            kalanMiktar -= kullanilacakMiktar;
            satirIndex++;
        });

        // Eğer hala kalan miktar varsa uyarı ver
        if (kalanMiktar > 0.01) {
            console.warn(`${malzeme.stokKodu} için ${kalanMiktar.toFixed(2)} miktar partilerde bulunamadı`);
        }
    }

    // Ek parti satırı oluşturma fonksiyonu
    function createAdditionalPartiRow(malzeme, parti, miktar, anaRow, satirIndex) {
        const tbody = document.getElementById('malzeme-tbody');
        const newRow = tbody.insertRow(anaRow.rowIndex);

        // Ana satırdan sonra ekle
        anaRow.parentNode.insertBefore(newRow, anaRow.nextSibling);

        const partiSelect = `<select class="form-select parti-select" data-stok="${malzeme.stokKodu}-${satirIndex}" style="width: 150px;" onchange="tuketimMiktarKontrol(document.querySelector('[data-stok=\\'${malzeme.stokKodu}-${satirIndex}\\'].tuketim-input'))">
            <option value="${parti.PartiKodu}" data-miktar="${parti.Miktar}" selected>${parti.PartiKodu} (Miktar: ${parti.Miktar.toFixed(2)}, Lot: ${parti.LotNo || '-'})</option>
        </select>`;

        newRow.innerHTML = `
            <td><strong>${malzeme.stokKodu}</strong> <small class="text-muted">(#${satirIndex + 1})</small></td>
            <td>${malzeme.stokAdi} <small class="text-muted">(Devam)</small></td>
            <td class="text-center">${malzeme.birimAdi}</td>
            <td class="text-end"><small class="text-muted">-</small></td>
            <td class="text-end"><small class="text-muted">-</small></td>
            <td class="text-end"><small class="text-muted">-</small></td>
            <td class="text-end" style="color: green; font-weight: bold;">${parti.Miktar.toFixed(2)}</td>
            <td class="text-end" style="background-color: #f8f9fa;"><span class="hesaplanan-miktar" data-stok="${malzeme.stokKodu}-${satirIndex}">-</span></td>
            <td>${partiSelect}</td>
            <td><input type="number" class="form-control tuketim-input multi-parti-input" data-stok="${malzeme.stokKodu}-${satirIndex}" data-original-stok="${malzeme.stokKodu}" data-planlanan="${miktar}" data-tip="planlanan" min="0" max="${parti.Miktar}" step="0.01" onchange="tuketimMiktarKontrol(this)" style="width: 120px;" value="${miktar.toFixed(2)}"></td>
            <td><span class="durum-badge" data-stok="${malzeme.stokKodu}-${satirIndex}"></span></td>
            <td><span class="badge bg-info">Parti-${satirIndex + 1}</span></td>
            <td><button class="btn btn-sm btn-warning" onclick="removeMultiPartiRow(this)" title="Bu parti satırını kaldır"><i class="fas fa-times"></i></button></td>`;

        // CSS sınıfı ekle (görsel ayrım için)
        newRow.classList.add('multi-parti-row');
        newRow.style.backgroundColor = '#f8f9fa';

        // Kontrol et
        const newInput = newRow.querySelector('.tuketim-input');
        if (newInput) {
            tuketimMiktarKontrol(newInput);
        }
    }

    // Çoklu parti satırlarını temizleme fonksiyonu
    function temizleCokluPartiSatirlari() {
        document.querySelectorAll('.multi-parti-row').forEach(row => row.remove());
    }

    // Parti satırını kaldırma fonksiyonu
    function removeMultiPartiRow(button) {
        const row = button.closest('tr');
        if (row && row.classList.contains('multi-parti-row')) {
            row.remove();
        }
    }

    // Güncel hesaplama
    function guncelHesaplamaYap() {
        const hedefMiktar = parseFloat(document.getElementById('hesaplaInput').value);
        if (hedefMiktar && hedefMiktar > 0) hesapla();
    }

    // Formu temizle
    function temizle() {
        document.getElementById('hesaplaInput').value = '';
        document.querySelectorAll('.hesaplanan-miktar').forEach(span => span.textContent = '-');
        document.querySelectorAll('.tuketim-input[data-tip="planlanan"]').forEach(input => {
            input.value = '';
            input.classList.remove('is-invalid', 'is-warning', 'is-valid');
        });
        document.querySelectorAll('.parti-select').forEach(select => select.value = '');
        document.querySelectorAll('.durum-badge').forEach(badge => badge.innerHTML = '');
    }

    // Hammadde ekleme modalını aç
    function hammaddeEkleModalAc() {
        if (!currentIsEmri) {
            alert('Önce bir iş emri seçin.');
            return;
        }

        document.getElementById('stokAramaInput').value = '';
        document.getElementById('hammaddeMiktarInput').value = '';
        document.getElementById('stok-sonuclari').style.display = 'none';
        document.getElementById('secili-stok-bilgisi').style.display = 'none';
        secilenStok = null;

        const modal = new bootstrap.Modal(document.getElementById('hammaddeModal'));
        modal.show();
    }

    // Stok arama
    function stokAra() {
        if (stokAramaTimeout) clearTimeout(stokAramaTimeout);
        stokAramaTimeout = setTimeout(stokAramaIslem, 300);
    }

    // Stok arama işlemi
    async function stokAramaIslem() {
        const aramaMetni = document.getElementById('stokAramaInput').value.trim();
        if (aramaMetni.length < 2) {
            document.getElementById('stok-sonuclari').style.display = 'none';
            return;
        }

        try {
            const response = await fetch(`@Url.Action("GetStokListesi", "Fatura")?arama=${encodeURIComponent(aramaMetni)}`);
            const data = await response.json();
            stokSonuclariGoster(data.success && data.data?.length ? data.data : []);
        } catch (error) {
            console.error('Stok arama hatası:', error);
            document.getElementById('stok-sonuclari').style.display = 'none';
        }
    }

    // Stok sonuçlarını göster
    function stokSonuclariGoster(stoklar) {
        const tbody = document.getElementById('stok-sonuclari-tbody');
        tbody.innerHTML = '';

        stoklar.forEach(stok => {
            const row = tbody.insertRow();
            row.innerHTML = `
             <td><button class="btn btn-sm btn-primary" onclick="stokSec('${stok.StokKodu}', '${stok.StokAdi.replace(/'/g, '&#39;')}', '${stok.BirimAdi}')">Seç</button></td>
                <td><strong>${stok.StokKodu}</strong></td>
                <td>${stok.StokAdi}</td>
                <td class="text-center">${stok.BirimAdi}</td>
               `;
        });

        document.getElementById('stok-sonuclari').style.display = stoklar.length ? 'block' : 'none';
    }

    // Stok seç
    function stokSec(stokKodu, stokAdi, birimAdi) {
        secilenStok = { stokKodu, stokAdi, birimAdi };
        document.getElementById('secili-stok-kodu').textContent = stokKodu;
        document.getElementById('secili-stok-adi').textContent = stokAdi;
        document.getElementById('secili-stok-bilgisi').style.display = 'block';
        document.getElementById('stok-sonuclari').style.display = 'none';
    }

    // Stok kodu ile doğrudan ekleme
    async function stokKoduIleEkle() {
        const stokKodu = document.getElementById('stokAramaInput').value.trim().toUpperCase();
        if (!stokKodu) {
            alert('Lütfen stok kodu girin.');
            return;
        }

        try {
            const response = await fetch(`@Url.Action("GetStokDetayByKod", "Fatura")?stokKodu=${encodeURIComponent(stokKodu)}`);
            const data = await response.json();
            if (data.success && data.data) {
                stokSec(data.data.StokKodu, data.data.StokAdi, data.data.BirimAdi);
            } else {
                alert(`Stok bulunamadı: ${stokKodu}`);
            }
        } catch (error) {
            console.error('Stok detayı alınırken hata:', error);
            alert('Stok detayı alınırken hata oluştu.');
        }
    }

    // Hammadde ekle
    async function hammaddeEkle() {
        console.log('Hammadde ekleniyor...');
        if (!secilenStok) {
            alert('Lütfen önce bir stok seçin.');
            return;
        }

        const miktar = parseFloat(document.getElementById('hammaddeMiktarInput').value);
        if (!miktar || miktar <= 0) {
            alert('Lütfen geçerli bir miktar girin.');
            return;
        }

        try {
            const response = await fetch(`@Url.Action("GetStokDepodakiMiktar", "Fatura")?stokKodu=${encodeURIComponent(secilenStok.stokKodu)}&depoNo=1`);
            const data = await response.json();
            const depodakiMiktar = data.success ? data.miktar : 0;

            // Malzemeyi listeye ekle
            eklenenMalzemeler.push({
                stokKodu: secilenStok.stokKodu,
                stokAdi: secilenStok.stokAdi,
                birimAdi: secilenStok.birimAdi,
                miktar,
                depodakiMiktar
            });

            console.log(`Hammadde eklendi: ${secilenStok.stokKodu}`);

            // Parti kodlarını getir ve bekle
            await fetchPartiKodlari(secilenStok.stokKodu);
            console.log(`Parti kodları getirildi: ${secilenStok.stokKodu}`, partiKodlari[secilenStok.stokKodu]);

            // Tabloyu yeniden oluştur
            malzemeTablosuOlustur();

            // Modal'ı kapat
            $('#hammaddeModal').modal('hide');

            showToast(`Hammadde eklendi: ${secilenStok.stokAdi}`, 'success');
        } catch (error) {
            console.error('Hammadde eklenirken hata:', error);
            alert('Hammadde eklenirken bir hata oluştu.');
        }
    }
        // Malzeme tablosu oluştur (güncellenmiş versiyon - silme özelliği ile)
    function malzemeTablosuOlustur() {
           console.log('Malzeme tablosu oluşturuluyor...');
           const tbody = document.getElementById('malzeme-tbody');

           // Mevcut hesaplanan değerleri ve input değerlerini sakla
           const mevcutHesaplananlar = {};
           const mevcutInputDegerleri = {};

           document.querySelectorAll('.hesaplanan-miktar').forEach(span => {
               const stokKodu = span.getAttribute('data-stok');
               mevcutHesaplananlar[stokKodu] = span.textContent;
           });

           document.querySelectorAll('.tuketim-input[data-tip="planlanan"]').forEach(input => {
               const stokKodu = input.getAttribute('data-stok');
               if (input.value) {
                   mevcutInputDegerleri[stokKodu] = input.value;
               }
           });

           tbody.innerHTML = '';

           // Planlanan malzemeleri ekle
           malzemeListesi.forEach(malzeme => {
               const row = tbody.insertRow();
               const depodakiMiktar = malzeme.depodakiMiktar || 0;
               const planliMiktar = malzeme.planlananMiktar || 0;
               const kalanMiktar = malzeme.kalanMiktar || 0;

               // Toleranslı maksimum miktar hesaplama (kalan miktar + %10)
               const toleransliMaxMiktar = kalanMiktar * 1.1; // +%10 tolerans

               const depoRenk = depodakiMiktar >= planliMiktar ? 'color: green; font-weight: bold;' : 'color: red; font-weight: bold;';

               // Parti kodlarını miktara göre sırala (EN KÜÇÜK MİKTAR ÖNCE)
               const siraliPartiKodlari = partiKodlari[malzeme.stokKodu]?.length
                   ? [...partiKodlari[malzeme.stokKodu]].sort((a, b) => a.Miktar - b.Miktar)
                   : [];

               let partiSelect = createPartiSelectHtml(malzeme.stokKodu, siraliPartiKodlari);

               // Saklanan değerleri geri yükle
               const hesaplananDeger = mevcutHesaplananlar[malzeme.stokKodu] || '-';
               const inputDeger = mevcutInputDegerleri[malzeme.stokKodu] || '';

               let silmeButonu = `<button class="btn btn-sm btn-warning" onclick="planliMalzemeyiTemizle('${malzeme.stokKodu}')"><i class="fas fa-times"></i></button>`;

               row.innerHTML = `
                   <td><strong>${malzeme.stokKodu}</strong></td>
                   <td>${malzeme.stokAdi}</td>
                   <td class="text-center">${malzeme.birimAdi}</td>
                   <td class="text-end">${malzeme.planlananMiktar.toFixed(2)}</td>
                   <td class="text-end">${malzeme.tuketilenMiktar.toFixed(2)}</td>
                   <td class="text-end"><strong>${malzeme.kalanMiktar.toFixed(2)}</strong> <small class="text-muted">(+10%: ${toleransliMaxMiktar.toFixed(2)})</small></td>
                   <td class="text-end" style="${depoRenk}">${depodakiMiktar.toFixed(2)}</td>
                   <td class="text-end" style="background-color: #f8f9fa;"><span class="hesaplanan-miktar" data-stok="${malzeme.stokKodu}">${hesaplananDeger}</span></td>
                   <td>${partiSelect}</td>
                   <td><input type="number" class="form-control tuketim-input" data-stok="${malzeme.stokKodu}" data-planlanan="${malzeme.planlananMiktar}" data-kalan="${malzeme.kalanMiktar}" data-tip="planlanan" min="0" max="${toleransliMaxMiktar}" step="0.01" onchange="tuketimMiktarKontrol(this)" style="width: 120px;" value="${inputDeger}"></td>
                   <td><span class="durum-badge" data-stok="${malzeme.stokKodu}"></span></td>
                   <td><span class="badge bg-primary">Planlanan</span></td>
                   <td>${silmeButonu}</td>`;
           });

           // Eklenen malzemeleri ekle (değişiklik yok)
           eklenenMalzemeler.forEach((malzeme, index) => {
               const row = tbody.insertRow();
               const uniqueStokId = `${malzeme.stokKodu}_eklenen_${index}`;

               const siraliPartiKodlari = partiKodlari[malzeme.stokKodu]?.length
                   ? [...partiKodlari[malzeme.stokKodu]].sort((a, b) => a.Miktar - b.Miktar)
                   : [];

               let partiSelect = createPartiSelectHtml(uniqueStokId, siraliPartiKodlari);

               row.innerHTML = `
                   <td><strong>${malzeme.stokKodu}</strong> <small class="text-muted">(#${index + 1})</small></td>
                   <td>${malzeme.stokAdi}</td>
                   <td class="text-center">${malzeme.birimAdi}</td>
                   <td class="text-end">-</td>
                   <td class="text-end">-</td>
                   <td class="text-end">-</td>
                   <td class="text-end" style="color: #888;">Parti'de</td>
                   <td class="text-end" style="background-color: #f8f9fa;">-</td>
                   <td>${partiSelect}</td>
                   <td><input type="number" class="form-control tuketim-input" data-stok="${uniqueStokId}" data-original-stok="${malzeme.stokKodu}" data-planlanan="0" data-tip="eklenen" data-index="${index}" value="${malzeme.miktar || ''}" min="0" step="0.01" onchange="tuketimMiktarKontrol(this)" style="width: 120px;"></td>
                   <td><span class="durum-badge" data-stok="${uniqueStokId}"></span></td>
                   <td><span class="badge bg-warning">Eklenen</span></td>
                   <td><button class="btn btn-sm btn-danger" onclick="eklenenMalzemeyiSil(${index})"><i class="fas fa-trash"></i></button></td>`;
           });

           // Tüketim miktarlarını kontrol et
           setTimeout(() => {
               document.querySelectorAll('.tuketim-input').forEach(input => {
                   tuketimMiktarKontrol(input);
               });
           }, 100);
       }

    // Planlı malzeme tüketimini temizleme fonksiyonu
    function planliMalzemeyiTemizle(stokKodu) {
        if (!confirm('Bu malzemenin tüketim miktarını temizlemek istediğinizden emin misiniz?')) {
            return;
        }

        // Input'u temizle
        const tuketimInput = document.querySelector(`[data-stok="${stokKodu}"].tuketim-input[data-tip="planlanan"]`);
        if (tuketimInput) {
            tuketimInput.value = '';
            tuketimMiktarKontrol(tuketimInput);
        }

        // Parti seçimini temizle
        const partiSelect = document.querySelector(`[data-stok="${stokKodu}"].parti-select`);
        if (partiSelect) {
            partiSelect.value = '';
        }

        // Tabloyu yeniden oluştur (silme butonunu gizlemek için)
        malzemeTablosuOlustur();

        showToast(`Malzeme tüketimi temizlendi: ${stokKodu}`, 'info');
    }

    // Mevcut eklenenMalzemeyiSil fonksiyonunu güncelle
    function eklenenMalzemeyiSil(index) {
        if (!confirm('Bu malzemeyi listeden çıkarmak istediğinizden emin misiniz?')) return;

        eklenenMalzemeler.splice(index, 1); // Index ile sil
        malzemeTablosuOlustur();
        showToast('Malzeme listeden çıkarıldı.', 'info');
    }

    // Tüketim kaydet fonksiyonunu da güncelle (değişiklik yok, mevcut kod çalışır)
    async function tuketimKaydet() {
        console.log('Tüketim kaydediliyor...');

        if (!currentIsEmri) {
            alert('İş emri seçilmedi.');
            return;
        }

        const gecersizInputlar = document.querySelectorAll('.tuketim-input.is-invalid');
        if (gecersizInputlar.length) {
            alert('Kırmızı işaretli alanları düzeltin.');
            return;
        }

        const partiHatalari = [];
        const tuketimVerileri = [];

        document.querySelectorAll('.tuketim-input').forEach(input => {
            const miktar = parseFloat(input.value) || 0;
            if (miktar > 0) {
                const stokKodu = input.getAttribute('data-stok');
                const originalStok = input.getAttribute('data-original-stok') || stokKodu; // Çoklu parti için orijinal stok kodu
                const partiSelect = document.querySelector(`[data-stok="${stokKodu}"].parti-select`);
                const partiKodu = partiSelect?.value || '';
                const selectedOption = partiSelect?.selectedOptions[0];
                const partiMiktar = selectedOption ? parseFloat(selectedOption.getAttribute('data-miktar') || 0) : 0;

                if (partiKodlari[originalStok]?.length > 0) {
                    if (!partiKodu) {
                        partiHatalari.push(`${originalStok}: Parti seçilmedi`);
                        return;
                    }
                    if (miktar > partiMiktar) {
                        partiHatalari.push(`${originalStok}: Miktar (${miktar}) > Parti Miktarı (${partiMiktar})`);
                        return;
                    }
                }

                tuketimVerileri.push({
                    StokKodu: originalStok, // Orijinal stok kodunu kullan
                    Miktar: miktar,
                    PartiKodu: partiKodu || '',
                    Tip: input.getAttribute('data-tip')
                });
            }
        });

        if (partiHatalari.length) {
            alert(`Parti hataları:\n${partiHatalari.join('\n')}`);
            return;
        }

        if (!tuketimVerileri.length) {
            alert('Tüketilecek malzeme seçilmedi.');
            return;
        }

        // Aynı stok kodunu grupla ve topla
        const groupedData = tuketimVerileri.reduce((acc, item) => {
            const key = `${item.StokKodu}-${item.PartiKodu}-${item.Tip}`;
            if (acc[key]) {
                acc[key].Miktar += item.Miktar;
            } else {
                acc[key] = { ...item };
            }
            return acc;
        }, {});

        const finalTuketimVerileri = Object.values(groupedData);

        const planliTuketimListesi = finalTuketimVerileri.filter(t => t.Tip === 'planlanan').map(t => ({
            StokKodu: t.StokKodu,
            Miktar: t.Miktar,
            PartiKodu: t.PartiKodu
        }));

        const eklenenTuketimListesi = finalTuketimVerileri.filter(t => t.Tip === 'eklenen').map(t => ({
            StokKodu: t.StokKodu,
            Miktar: t.Miktar,
            PartiKodu: t.PartiKodu
        }));

        const requestData = {
            IsEmriKodu: currentIsEmri,
            TuketimListesi: planliTuketimListesi,
            EklenenMalzemeler: eklenenTuketimListesi,
            UretimMiktari: parseFloat(document.getElementById('hesaplaInput').value) || null
        };

        console.log('Gönderilecek veri:', JSON.stringify(requestData, null, 2));

        const btn = document.getElementById('kaydet-btn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>İşleniyor...';

        try {
            const response = await fetch('@Url.Action("MalzemeTuketimi", "Fatura")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(requestData)
            });

            const data = await response.json();
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save"></i> Tüketimi Kaydet';

            if (data.success) {
                alert(`Başarılı: ${data.message}`);
                location.reload();
            } else {
                alert(`Hata: ${data.message}`);
            }
        } catch (error) {
            console.error('AJAX Hata:', error);
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save"></i> Tüketimi Kaydet';
            alert(`Hata: ${error.message}`);
        }
    }

</script>


