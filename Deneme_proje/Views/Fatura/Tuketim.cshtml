@model IEnumerable<Deneme_proje.Models.Entities.IsEmriModel>
@{
	ViewData["Title"] = "Malzeme Tüketimi";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content mt-5">
	<div class="card">
		<div class="card-header">
			<h3>Malzeme Tüketimi</h3>
			<!-- İş Merkezi Bilgisi -->
			<div class="mt-2">
				<small class="text-light">
					<i class="fas fa-info-circle"></i>
					<span id="is-merkezi-bilgisi">Yetkili olduğunuz iş merkezleri yükleniyor...</span>
				</small>
			</div>
		</div>
		<div class="card-body">
			@if (Model.Any())
			{
				<!-- İş Emri Seçim Bölümü -->
				<div class="row mb-4">
					<div class="col-md-8">
						<label for="isEmriSelect" class="form-label"><strong>İş Emri Seçin:</strong></label>
						<select id="isEmriSelect" class="form-select" onchange="isEmriSecildi()">
							<option value="">-- İş Emri Seçiniz --</option>
							@foreach (var isEmri in Model)
							{
								<option value="@isEmri.is_Kod"
										data-urun-kodu="@isEmri.UrunKodu"
										data-urun-adi="@isEmri.UrunAdi"
										data-miktar="@isEmri.Miktar"
										data-is-merkezi="@isEmri.IsMerkezi">
									@isEmri.is_Kod - @isEmri.UrunAdi (Miktar: @isEmri.Miktar) [@isEmri.IsMerkezi]
								</option>
							}
						</select>
					</div>
					<div class="col-md-4">
						<label for="sarfInput" class="form-label"><strong>Sarf Alanı:</strong></label>
						<div class="input-group">
							<input type="number" id="sarfInput" class="form-control" placeholder="Miktar" step="0.01" min="0">
							<button class="btn btn-success" type="button" onclick="sarfGiris()">Sarf Giriş</button>
							<button class="btn btn-warning" type="button" onclick="sarfCikis()">Sarf Çıkış</button>
						</div>
					</div>
				</div>

				<!-- Seçili İş Emri Bilgileri -->
				<div id="secili-isemri-bilgi" style="display:none;" class="alert alert-info mb-4">
					<div class="row">
						<div class="col-md-3">
							<strong>İş Emri:</strong> <span id="secili-isemri"></span>
						</div>
						<div class="col-md-3">
							<strong>Ürün Kodu:</strong> <span id="secili-urun-kodu"></span>
						</div>
						<div class="col-md-3">
							<strong>Ürün Adı:</strong> <span id="secili-urun-adi"></span>
						</div>
						<div class="col-md-3">
							<strong>Planlanan Miktar:</strong> <span id="secili-miktar"></span>
						</div>
					</div>
				</div>

				<!-- Hesaplama Bölümü -->
				<div id="hesaplama-bolumu" style="display:none;" class="mb-4">
					<div class="card">
						<div class="card-body">
							<div class="row align-items-end">
								<div class="col-md-3">
									<label for="hesaplaInput" class="form-label"><strong>Üretim Miktarı:</strong></label>
									<input type="number" id="hesaplaInput" class="form-control" placeholder="Üretim miktarı" step="0.01" min="0">
								</div>
								<div class="col-md-2">
									<button class="btn btn-primary" onclick="hesapla()">Hesapla</button>
								</div>
								<div class="col-md-2">
									<button class="btn btn-secondary" onclick="temizle()">Temizle</button>
								</div>
								<div class="col-md-3">
									<button class="btn btn-info" onclick="hammaddeEkleModalAc()">
										<i class="fas fa-plus"></i> Hammadde Ekle
									</button>
								</div>
								<div class="col-md-2">
									<div class="alert alert-warning mb-0" style="font-size: 0.8em; padding: 0.5rem;">
										<strong>Uyarı:</strong> ±%10 tolerans
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Malzeme Listesi -->
				<div id="malzeme-container" style="display:none;">
					<div class="card">
						<div class="card-header">
							<h5>Malzeme Listesi</h5>
						</div>
						<div class="card-body">
							<div id="loading" style="text-align:center; display:none;">
								<div class="spinner-border" role="status">
									<span class="visually-hidden">Yükleniyor...</span>
								</div>
								<p class="mt-2">Malzemeler yükleniyor...</p>
							</div>

							<div id="malzeme-tablo-container" style="display:none;">
								<div class="table-responsive">
									<table class="table table-striped table-hover">
										<thead class="table-dark">
											<tr>
												<th>Stok Kodu</th>
												<th>Malzeme Adı</th>
												<th>Birim</th>
												<th>Planlanan</th>
												<th>Tüketilen</th>
												<th>Kalan</th>
												<th style="background-color: #e3f2fd;">Hesaplanan</th>
												<th>Tüketilecek Miktar</th>
												<th>Durum</th>
												<th>Tip</th>
												<th>İşlem</th>
											</tr>
										</thead>
										<tbody id="malzeme-tbody">
										</tbody>
									</table>
								</div>
							</div>

							<div id="error-msg" class="alert alert-danger" style="display:none;"></div>
						</div>
					</div>
				</div>

				<!-- Kaydet Butonu -->
				<div id="kaydet-container" style="display:none;" class="text-center mt-4">
					<button id="kaydet-btn" class="btn btn-success btn-lg" onclick="tuketimKaydet()">
						<i class="fas fa-save"></i> Tüketimi Kaydet
					</button>
				</div>
			}
			else
			{
				<div class="alert alert-warning text-center">
					<h5>Aktif İş Emri Bulunamadı</h5>
					<p>Şu anda tüketim yapılabilecek aktif iş emri bulunmamaktadır.</p>
				</div>
			}
		</div>
	</div>
</div>

<!-- Hammadde Ekleme Modalı -->
<!-- Hammadde Ekleme Modalı -->
<div class="modal fade" id="hammaddeModal" tabindex="-1" aria-labelledby="hammaddeModalLabel" aria-hidden="true" style="z-index: 9999;">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="hammaddeModalLabel">Hammadde Ekle</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div class="row mb-3">
					<div class="col-md-8">
						<label for="stokAramaInput" class="form-label">Stok Ara (İsim veya Kod):</label>
						<div class="input-group">
							<input type="text" id="stokAramaInput" class="form-control"
								   placeholder="Stok ismi veya kodu ile arayın..."
								   onkeyup="stokAra()"
								   onkeydown="if(event.key==='Enter') { event.preventDefault(); stokKoduIleEkle(); }">
							<button class="btn btn-outline-secondary" type="button" onclick="stokKoduIleEkle()" title="Stok kodu ile direkt ekle">
								<i class="fas fa-search"></i>
							</button>
						</div>
						<small class="text-muted">Stok kodu yazıp Enter'a basarak direkt ekleyebilirsiniz</small>
					</div>
					<div class="col-md-4">
						<label for="hammaddeMiktarInput" class="form-label">Miktar:</label>
						<input type="number" id="hammaddeMiktarInput" class="form-control" placeholder="Miktar" step="0.01" min="0">
					</div>
				</div>

				<div id="stok-sonuclari" style="display:none;">
					<div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
						<table class="table table-hover table-sm">
							<thead class="table-light sticky-top">
								<tr>
									<th>Stok Kodu</th>
									<th>Stok Adı</th>
									<th>Birim</th>
									<th width="80">Seç</th>
								</tr>
							</thead>
							<tbody id="stok-sonuclari-tbody">
							</tbody>
						</table>
					</div>
				</div>

				<div id="stok-yukleniyor" style="display:none; text-align: center; padding: 20px;">
					<div class="spinner-border spinner-border-sm" role="status">
						<span class="visually-hidden">Yükleniyor...</span>
					</div>
					<span class="ms-2">Stoklar yükleniyor...</span>
				</div>

				<div id="secili-stok-bilgisi" style="display:none;" class="alert alert-success">
					<strong>Seçilen Stok:</strong> <span id="secili-stok-adi"></span> (<span id="secili-stok-kodu"></span>)
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
				<button type="button" class="btn btn-primary" onclick="hammaddeEkle()">Malzeme Listesine Ekle</button>
			</div>
		</div>
	</div>
</div>
 <script>
	// Global değişkenler
	var currentIsEmri = '';
	var currentUrun = '';
	var currentPlanlananMiktar = 0;
	var orijinalPlanlananMiktar = 0;
	var malzemeListesi = [];
	var eklenenMalzemeler = []; // Yeni eklenen malzemeler
	var secilenStok = null;

	// Sayfa yüklendiğinde iş merkezi bilgisini al
	document.addEventListener('DOMContentLoaded', function() {
		isMerkeziBilgisiniGetir();
	});
	
	// İş merkezi bilgisini getir
	function isMerkeziBilgisiniGetir() {
		fetch('@Url.Action("GetIsMerkezleri", "Fatura")')
			.then(response => response.json())
			.then(data => {
				if (data.success && data.isMerkezleri) {
					var isMerkezleri = data.isMerkezleri.map(im => im.kod + ' - ' + im.aciklama).join(', ');
					document.getElementById('is-merkezi-bilgisi').innerHTML =
						'<strong>Yetkili İş Merkezleri:</strong> ' + (isMerkezleri || 'Tüm iş merkezleri');
				} else {
					 document.getElementById('is-merkezi-bilgisi').innerHTML ='<strong>Yetkili İş Merkezleri:</strong> Bilgi alınamadı';
				}
			})
			.catch(error => {
				console.error('İş merkezi bilgisi alınırken hata:', error);
				document.getElementById('is-merkezi-bilgisi').innerHTML =
					'<strong>Yetkili İş Merkezleri:</strong> Hata oluştu';
			});
	}

	// İş emri seçildiğinde
	function isEmriSecildi() {
		var select = document.getElementById('isEmriSelect');
		var selectedOption = select.options[select.selectedIndex];

		if (select.value === '') {
			// Hiçbir iş emri seçilmemiş
			document.getElementById('secili-isemri-bilgi').style.display = 'none';
			document.getElementById('hesaplama-bolumu').style.display = 'none';
			document.getElementById('malzeme-container').style.display = 'none';
			document.getElementById('kaydet-container').style.display = 'none';
			eklenenMalzemeler = []; // Eklenen malzemeleri temizle
			return;
		}

		// Seçili iş emri bilgilerini al
		currentIsEmri = select.value;
		currentUrun = selectedOption.getAttribute('data-urun-kodu');
		currentPlanlananMiktar = parseFloat(selectedOption.getAttribute('data-miktar'));
		orijinalPlanlananMiktar = currentPlanlananMiktar;

		// Bilgileri göster
		document.getElementById('secili-isemri').textContent = currentIsEmri;
		document.getElementById('secili-urun-kodu').textContent = currentUrun;
		document.getElementById('secili-urun-adi').textContent = selectedOption.getAttribute('data-urun-adi');
		document.getElementById('secili-miktar').textContent = currentPlanlananMiktar;

		document.getElementById('secili-isemri-bilgi').style.display = 'block';
		document.getElementById('hesaplama-bolumu').style.display = 'block';

		// Sarf inputunu temizle
		document.getElementById('sarfInput').value = '';
		document.getElementById('hesaplaInput').value = '';
		eklenenMalzemeler = []; // Eklenen malzemeleri temizle

		// Malzemeleri getir
		malzemeListesiniGetir();
	}

	// Sarf giriş fonksiyonu
	function sarfGiris() {
		var sarfMiktar = parseFloat(document.getElementById('sarfInput').value);
		if (!sarfMiktar || sarfMiktar <= 0) {
			alert('Lütfen geçerli bir sarf miktarı girin.');
			return;
		}

		currentPlanlananMiktar += sarfMiktar;
		document.getElementById('secili-miktar').textContent = currentPlanlananMiktar;
		document.getElementById('sarfInput').value = '';

		guncelHesaplamaYap();
		showToast('Sarf giriş yapıldı: +' + sarfMiktar, 'success');
	}

	// Sarf çıkış fonksiyonu
	function sarfCikis() {
		var sarfMiktar = parseFloat(document.getElementById('sarfInput').value);
		if (!sarfMiktar || sarfMiktar <= 0) {
			alert('Lütfen geçerli bir sarf miktarı girin.');
			return;
		}

		if (currentPlanlananMiktar - sarfMiktar < 0) {
			alert('Sarf çıkış miktarı planlanan miktardan fazla olamaz.');
			return;
		}

		currentPlanlananMiktar -= sarfMiktar;
		document.getElementById('secili-miktar').textContent = currentPlanlananMiktar;
		document.getElementById('sarfInput').value = '';

		guncelHesaplamaYap();
		showToast('Sarf çıkış yapıldı: -' + sarfMiktar, 'warning');
	}

	// Toast mesajı göster
	function showToast(message, type) {
		var toast = document.createElement('div');
		toast.className = `alert alert-${type} position-fixed top-0 end-0 m-3`;
		toast.style.zIndex = '9999';
		toast.style.minWidth = '300px';
		toast.innerHTML = message + '<button type="button" class="btn-close float-end" onclick="this.parentElement.remove()"></button>';
		document.body.appendChild(toast);

		setTimeout(() => {
			if (toast.parentElement) {
				toast.remove();
			}
		}, 3000);
	}

	// Malzeme listesini getir
	function malzemeListesiniGetir() {
		document.getElementById('malzeme-container').style.display = 'block';
		document.getElementById('loading').style.display = 'block';
		document.getElementById('malzeme-tablo-container').style.display = 'none';
		document.getElementById('error-msg').style.display = 'none';
		document.getElementById('kaydet-container').style.display = 'none';

		fetch('@Url.Action("GetMalzemePlanlama", "Fatura")?isEmriKodu=' + encodeURIComponent(currentIsEmri))
			.then(response => response.json())
			.then(data => {
				document.getElementById('loading').style.display = 'none';

				if (data.success && data.data.length > 0) {
					malzemeListesi = data.data;
					malzemeTablosuOlustur();
					document.getElementById('malzeme-tablo-container').style.display = 'block';
					document.getElementById('kaydet-container').style.display = 'block';
				} else {
					// Planlanan malzeme yoksa da tablou oluştur (sadece eklenen malzemeler için)
					malzemeListesi = [];
					malzemeTablosuOlustur();
					document.getElementById('malzeme-tablo-container').style.display = 'block';
					document.getElementById('kaydet-container').style.display = 'block';
				}
			})
			.catch(error => {
				console.error('Hata:', error);
				document.getElementById('loading').style.display = 'none';
				document.getElementById('error-msg').textContent = 'Malzeme listesi yüklenirken hata oluştu.';
				document.getElementById('error-msg').style.display = 'block';
			});
	}

	// Malzeme tablosu oluştur
	function malzemeTablosuOlustur() {
		var tbody = document.getElementById('malzeme-tbody');
		tbody.innerHTML = '';

		// Planlanan malzemeleri ekle
		malzemeListesi.forEach(function(malzeme, index) {
			var row = tbody.insertRow();
			row.innerHTML = `
				<td><strong>${malzeme.stokKodu}</strong></td>
				<td>${malzeme.stokAdi}</td>
				<td class="text-center">${malzeme.birimAdi}</td>
				<td class="text-end">${malzeme.planlananMiktar.toFixed(2)}</td>
				<td class="text-end">${malzeme.tuketilenMiktar.toFixed(2)}</td>
				<td class="text-end"><strong>${malzeme.kalanMiktar.toFixed(2)}</strong></td>
				<td class="text-end" style="background-color: #f8f9fa;">
					<span class="hesaplanan-miktar" data-stok="${malzeme.stokKodu}">-</span>
				</td>
				<td>
					<input type="number" class="form-control tuketim-input" data-stok="${malzeme.stokKodu}"
						   data-planlanan="${malzeme.planlananMiktar}" data-tip="planlanan"
						   min="0" max="${malzeme.kalanMiktar}" step="0.01"
						   onchange="tuketimMiktarKontrol(this)"
						   style="width: 120px;">
				</td>
				<td>
					<span class="durum-badge" data-stok="${malzeme.stokKodu}"></span>
				</td>
				<td><span class="badge bg-primary">Planlanan</span></td>
				<td>-</td>
			`;
		});

		// Eklenen malzemeleri ekle
		eklenenMalzemeler.forEach(function(malzeme, index) {
			var row = tbody.insertRow();
			row.innerHTML = `
				<td><strong>${malzeme.stokKodu}</strong></td>
				<td>${malzeme.stokAdi}</td>
				<td class="text-center">${malzeme.birimAdi}</td>
				<td class="text-end">-</td>
				<td class="text-end">-</td>
				<td class="text-end">-</td>
				<td class="text-end" style="background-color: #f8f9fa;">-</td>
				<td>
					<input type="number" class="form-control tuketim-input" data-stok="${malzeme.stokKodu}"
						   data-planlanan="0" data-tip="eklenen" value="${malzeme.miktar}"
						   min="0" step="0.01"
						   onchange="tuketimMiktarKontrol(this)"
						   style="width: 120px;">
				</td>
				<td>
					<span class="durum-badge" data-stok="${malzeme.stokKodu}">
						<span class="badge bg-success">Uygun</span>
					</span>
				</td>
				<td><span class="badge bg-warning">Eklenen</span></td>
				<td>
					<button class="btn btn-sm btn-danger" onclick="eklenenMalzemeyiSil('${malzeme.stokKodu}')">
						<i class="fas fa-trash"></i>
					</button>
				</td>
			`;
		});
	}

	// Tüketim miktar kontrolü
	function tuketimMiktarKontrol(input) {
		var miktar = parseFloat(input.value) || 0;
		var stokKodu = input.getAttribute('data-stok');
		var tip = input.getAttribute('data-tip');
		var durumBadge = document.querySelector(`[data-stok="${stokKodu}"].durum-badge`);

		if (tip === 'eklenen') {
			// Eklenen malzemeler için sadece pozitif kontrol
			if (miktar > 0) {
				input.classList.add('is-valid');
				input.classList.remove('is-invalid');
				durumBadge.innerHTML = '<span class="badge bg-success">Uygun</span>';

				// Eklenen malzemeler listesindeki miktarı güncelle
				var eklenen = eklenenMalzemeler.find(m => m.stokKodu === stokKodu);
				if (eklenen) {
					eklenen.miktar = miktar;
				}
			} else {
				input.classList.remove('is-invalid', 'is-valid');
				durumBadge.innerHTML = '';
			}
			return;
		}

		// Planlanan malzemeler için normal kontrol
		var planlananMiktar = parseFloat(input.getAttribute('data-planlanan'));
		var maxMiktar = parseFloat(input.getAttribute('max'));

		var hesaplananSpan = document.querySelector(`[data-stok="${stokKodu}"].hesaplanan-miktar`);
		var referansMiktar = planlananMiktar;
		if (hesaplananSpan && hesaplananSpan.textContent !== '-') {
			referansMiktar = parseFloat(hesaplananSpan.textContent);
		}

		var minTolerans = referansMiktar * 0.9;
		var maxTolerans = referansMiktar * 1.1;

		if (miktar > maxMiktar) {
			input.classList.add('is-invalid');
			durumBadge.innerHTML = '<span class="badge bg-danger">Kalan miktarı aşıyor</span>';
		} else if (miktar > 0 && (miktar < minTolerans || miktar > maxTolerans)) {
			input.classList.add('is-warning');
			input.classList.remove('is-invalid', 'is-valid');
			durumBadge.innerHTML = '<span class="badge bg-warning">%10 tolerans dışında</span>';
		} else if (miktar > 0) {
			input.classList.add('is-valid');
			input.classList.remove('is-invalid', 'is-warning');
			durumBadge.innerHTML = '<span class="badge bg-success">Uygun</span>';
		} else {
			input.classList.remove('is-invalid', 'is-warning', 'is-valid');
			durumBadge.innerHTML = '';
		}
	}

	// Hesapla fonksiyonu
	function hesapla() {
		var hedefMiktar = parseFloat(document.getElementById('hesaplaInput').value);

		if (!hedefMiktar || hedefMiktar <= 0) {
			alert('Lütfen geçerli bir üretim miktarı girin.');
			return;
		}

		var oran = hedefMiktar / currentPlanlananMiktar;

		malzemeListesi.forEach(function(malzeme) {
			var hesaplananMiktar = malzeme.planlananMiktar * oran;
			var hesaplananSpan = document.querySelector(`[data-stok="${malzeme.stokKodu}"].hesaplanan-miktar`);
			var tuketimInput = document.querySelector(`[data-stok="${malzeme.stokKodu}"].tuketim-input[data-tip="planlanan"]`);

			if (hesaplananSpan) {
				hesaplananSpan.textContent = hesaplananMiktar.toFixed(2);
			}

			if (tuketimInput) {
				tuketimInput.value = hesaplananMiktar.toFixed(2);
				tuketimMiktarKontrol(tuketimInput);
			}
		});
	}

	// Güncel hesaplama
	function guncelHesaplamaYap() {
		var hedefMiktar = parseFloat(document.getElementById('hesaplaInput').value);
		if (hedefMiktar && hedefMiktar > 0) {
			hesapla();
		}
	}

	// Temizle fonksiyonu
	function temizle() {
		document.getElementById('hesaplaInput').value = '';

		var hesaplananSpanlar = document.querySelectorAll('.hesaplanan-miktar');
		hesaplananSpanlar.forEach(function(span) {
			span.textContent = '-';
		});

		var tuketimInputlar = document.querySelectorAll('.tuketim-input[data-tip="planlanan"]');
		tuketimInputlar.forEach(function(input) {
			input.value = '';
			input.classList.remove('is-invalid', 'is-warning', 'is-valid');
		});

		var durumBadges = document.querySelectorAll('.durum-badge');
		durumBadges.forEach(function(badge) {
			var stokKodu = badge.getAttribute('data-stok');
			var input = document.querySelector(`[data-stok="${stokKodu}"].tuketim-input`);
			if (input && input.getAttribute('data-tip') === 'planlanan') {
				badge.innerHTML = '';
			}
		});
	}

	// Hammadde ekleme modalını aç
	// Hammadde ekleme modalını aç
	function hammaddeEkleModalAc() {
		if (!currentIsEmri) {
			alert('Önce bir iş emri seçin.');
			return;
		}

		// Modal içeriğini temizle
		document.getElementById('stokAramaInput').value = '';
		document.getElementById('hammaddeMiktarInput').value = '';
		document.getElementById('stok-sonuclari').style.display = 'none';
		document.getElementById('secili-stok-bilgisi').style.display = 'none';
		secilenStok = null;

		// Modalı aç ve tüm stokları yükle
		var modal = new bootstrap.Modal(document.getElementById('hammaddeModal'));
		modal.show();

		// Modal açıldıktan sonra tüm stokları yükle
		setTimeout(() => {
			tumStoklariYukle();
		}, 300);
	}

	// Tüm stokları yükle
	function tumStoklariYukle() {
		fetch('@Url.Action("GetStokListesi", "Fatura")')
			.then(response => response.json())
			.then(data => {
				if (data.success && data.data.length > 0) {
					stokSonuclariGoster(data.data);
				} else {
					document.getElementById('stok-sonuclari').style.display = 'none';
				}
			})
			.catch(error => {
				console.error('Tüm stoklar yüklenirken hata:', error);
			});
	}

	// Stok arama - debounce ile
	let stokAramaTimeout;
	function stokAra() {
		// Önceki timeout'u temizle
		if (stokAramaTimeout) {
			clearTimeout(stokAramaTimeout);
		}

		// 300ms sonra ara
		stokAramaTimeout = setTimeout(() => {
			stokAramaIslem();
		}, 300);
	}

	// Stok arama işlemi
	function stokAramaIslem() {
		var aramaMetni = document.getElementById('stokAramaInput').value.trim();

		if (aramaMetni.length === 0) {
			// Arama metni boşsa tüm stokları göster
			tumStoklariYukle();
			return;
		}

		if (aramaMetni.length < 2) {
			document.getElementById('stok-sonuclari').style.display = 'none';
			return;
		}

		fetch('@Url.Action("GetStokListesi", "Fatura")?arama=' + encodeURIComponent(aramaMetni))
			.then(response => response.json())
			.then(data => {
				if (data.success && data.data.length > 0) {
					stokSonuclariGoster(data.data);
				} else {
					document.getElementById('stok-sonuclari').style.display = 'none';
				}
			})
			.catch(error => {
				console.error('Stok arama hatası:', error);
				document.getElementById('stok-sonuclari').style.display = 'none';
			});
	}

	// Stok sonuçlarını göster
	function stokSonuclariGoster(stoklar) {
		var tbody = document.getElementById('stok-sonuclari-tbody');
		tbody.innerHTML = '';

		stoklar.forEach(function(stok) {
			var row = tbody.insertRow();
			row.innerHTML = `
				<td><strong>${stok.StokKodu}</strong></td>
				<td>${stok.StokAdi || 'N/A'}</td>
				<td class="text-center">${stok.BirimAdi || 'Adet'}</td>
				<td>
					<button class="btn btn-sm btn-primary" onclick="stokSec('${stok.StokKodu}', '${(stok.StokAdi || '').replace(/'/g, '&#39;')}', '${stok.BirimAdi || 'Adet'}')">
						Seç
					</button>
				</td>
			`;
		});

		document.getElementById('stok-sonuclari').style.display = 'block';
	}

	// Stok seç
	function stokSec(stokKodu, stokAdi, birimAdi) {
		// Zaten eklenmiş mi kontrol et
		var mevcutMu = eklenenMalzemeler.some(m => m.stokKodu === stokKodu) ||
					   malzemeListesi.some(m => m.stokKodu === stokKodu);

		if (mevcutMu) {
			alert('Bu stok zaten listede mevcut.');
			return;
		}

		secilenStok = {
			stokKodu: stokKodu,
			stokAdi: stokAdi,
			birimAdi: birimAdi
		};

		document.getElementById('secili-stok-kodu').textContent = stokKodu;
		document.getElementById('secili-stok-adi').textContent = stokAdi;
		document.getElementById('secili-stok-bilgisi').style.display = 'block';
		document.getElementById('stok-sonuclari').style.display = 'none';

		// Arama inputunu temizle
		document.getElementById('stokAramaInput').value = '';
	}

	// Stok kodu ile doğrudan ekleme için yeni fonksiyon
	function stokKoduIleEkle() {
		var stokKodu = document.getElementById('stokAramaInput').value.trim().toUpperCase();

		if (stokKodu.length === 0) {
			alert('Lütfen stok kodu girin.');
			return;
		}

		// Zaten eklenmiş mi kontrol et
		var mevcutMu = eklenenMalzemeler.some(m => m.stokKodu === stokKodu) ||
					   malzemeListesi.some(m => m.stokKodu === stokKodu);

		if (mevcutMu) {
			alert('Bu stok zaten listede mevcut.');
			return;
		}

		// Stok detayını getir
		fetch('@Url.Action("GetStokDetayByKod", "Fatura")?stokKodu=' + encodeURIComponent(stokKodu))
			.then(response => response.json())
			.then(data => {
				if (data.success && data.data) {
					stokSec(data.data.StokKodu, data.data.StokAdi, data.data.BirimAdi);
				} else {
					alert('Stok bulunamadı: ' + stokKodu);
				}
			})
			.catch(error => {
				console.error('Stok detayı alınırken hata:', error);
				alert('Stok detayı alınırken hata oluştu.');
			});
	}

	// Hammadde ekle
	function hammaddeEkle() {
		if (!secilenStok) {
			alert('Lütfen önce bir stok seçin.');
			return;
		}

		var miktar = parseFloat(document.getElementById('hammaddeMiktarInput').value);
		if (!miktar || miktar <= 0) {
			alert('Lütfen geçerli bir miktar girin.');
			return;
		}

		// Listeye ekle
		eklenenMalzemeler.push({
			stokKodu: secilenStok.stokKodu,
			stokAdi: secilenStok.stokAdi,
			birimAdi: secilenStok.birimAdi,
			miktar: miktar
		});

		// Tabloyu yenile
		malzemeTablosuOlustur();

		// Modalı kapat
		var modal = bootstrap.Modal.getInstance(document.getElementById('hammaddeModal'));
		modal.hide();

		showToast('Hammadde eklendi: ' + secilenStok.stokAdi, 'success');
	}

	// Eklenen malzemeyi sil
	function eklenenMalzemeyiSil(stokKodu) {
		if (!confirm('Bu malzemeyi listeden çıkarmak istediğinizden emin misiniz?')) {
			return;
		}

		eklenenMalzemeler = eklenenMalzemeler.filter(m => m.stokKodu !== stokKodu);
		malzemeTablosuOlustur();
		showToast('Malzeme listeden çıkarıldı.', 'info');
	}

	// Tüketim kaydet
	function tuketimKaydet() {
		var planliTuketimListesi = [];
		var eklenenTuketimListesi = [];

		// Planlanan malzemeler
		var planliInputlar = document.querySelectorAll('.tuketim-input[data-tip="planlanan"]');
		planliInputlar.forEach(function(input) {
			var miktar = parseFloat(input.value) || 0;
			var stokKodu = input.getAttribute('data-stok');

			if (miktar > 0) {
				planliTuketimListesi.push({
					StokKodu: stokKodu,
					Miktar: miktar
				});
			}
		});

		// Eklenen malzemeler
		var eklenenInputlar = document.querySelectorAll('.tuketim-input[data-tip="eklenen"]');
		eklenenInputlar.forEach(function(input) {
			var miktar = parseFloat(input.value) || 0;
			var stokKodu = input.getAttribute('data-stok');

			if (miktar > 0) {
				eklenenTuketimListesi.push({
					StokKodu: stokKodu,
					Miktar: miktar
				});
			}
		});

		if (planliTuketimListesi.length === 0 && eklenenTuketimListesi.length === 0) {
			alert('Tüketilecek malzeme seçilmedi. Lütfen miktar girin.');
			return;
		}

		// Geçersiz girişleri kontrol et
		var gecersizInputlar = document.querySelectorAll('.tuketim-input.is-invalid');
		if (gecersizInputlar.length > 0) {
			alert('Kalan miktarı aşan girişler var. Lütfen kontrol edin.');
			return;
		}

		var toplamMalzeme = planliTuketimListesi.length + eklenenTuketimListesi.length;
		if (!confirm(`${toplamMalzeme} adet malzeme tüketilecek. İş Emri: ${currentIsEmri}\n\nDevam edilsin mi?`)) {
			return;
		}

		// Butonu devre dışı bırak
		var btn = document.getElementById('kaydet-btn');
		btn.disabled = true;
		btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Kaydediliyor...';

		// FormData oluştur
		var formData = new FormData();
		formData.append('isEmriKodu', currentIsEmri);

		// Planlanan malzemeler
		planliTuketimListesi.forEach(function(item, index) {
			formData.append(`tuketimListesi[${index}].StokKodu`, item.StokKodu);
			formData.append(`tuketimListesi[${index}].Miktar`, item.Miktar);
		});

		// Eklenen malzemeler
		eklenenTuketimListesi.forEach(function(item, index) {
			formData.append(`eklenenMalzemeler[${index}].StokKodu`, item.StokKodu);
			formData.append(`eklenenMalzemeler[${index}].Miktar`, item.Miktar);
		});

		fetch('@Url.Action("MalzemeTuketimi", "Fatura")', {
			method: 'POST',
			body: formData
		})
		.then(response => response.json())
		.then(data => {
			btn.disabled = false;
			btn.innerHTML = '<i class="fas fa-save"></i> Tüketimi Kaydet';

			if (data.success) {
				alert('Başarılı: ' + data.message);
				location.reload();
			} else {
				alert('Hata: ' + data.message);
			}
		})
		.catch(error => {
			console.error('AJAX Hata:', error);
			btn.disabled = false;
			btn.innerHTML = '<i class="fas fa-save"></i> Tüketimi Kaydet';
			alert('Tüketim işlemi sırasında hata oluştu.');
		});
	}
</script>
 
