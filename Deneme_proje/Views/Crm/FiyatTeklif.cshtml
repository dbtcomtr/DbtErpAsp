</div>

 <script>
		// ==================== GLOBAL DEĞİŞKENLER ====================
	const StokUrl = '@Url.Action("GetStoklar", "Crm")';
	let rowCounter = 0;
	let currentStokRow = null;
	let StokListesi = [];

	// ==================== SAYFA YÜKLENME ====================
	document.addEventListener('DOMContentLoaded', function() {
		loadStoklar();
		addProductRow();
		calculateBitisTarihi();
		document.getElementById('defaultOpen').click();
	});

	// ==================== TAB FONKSİYONLARI ====================
	function openTab(evt, tabName) {
		const tabContents = document.getElementsByClassName('tab-content');
		for (let i = 0; i < tabContents.length; i++) {
			tabContents[i].classList.remove('active');
		}
		const tabButtons = document.getElementsByClassName('tab-button');
		for (let i = 0; i < tabButtons.length; i++) {
			tabButtons[i].classList.remove('active');
		}
		document.getElementById(tabName).classList.add('active');
		if (evt && evt.currentTarget) {
			evt.currentTarget.classList.add('active');
		} else {
			for (let i = 0; i < tabButtons.length; i++) {
				if (tabButtons[i].getAttribute('onclick').includes(tabName)) {
					tabButtons[i].classList.add('active');
					break;
				}
			}
		}
		if (tabName === 'adayCariTab') {
			loadYeniAdayCariKodu();
		}
	}

	function switchToAdayCariTab() {
		const adayTabButton = document.querySelector('[onclick*="adayCariTab"]');
		if (adayTabButton) {
			adayTabButton.click();
		}
	}

	// ==================== ADAY CARİ FONKSİYONLARI ====================
	function loadYeniAdayCariKodu() {
		fetch('/Crm/GetYeniAdayCariKodu')
			.then(response => response.json())
			.then(data => {
				if (data.success || data.Success) {
					document.getElementById('adayCariKod').value = data.kod || data.Kod || 'CRM001';
				}
			})
			.catch(error => {
				console.error('Aday cari kodu alınamadı:', error);
				document.getElementById('adayCariKod').value = 'CRM001';
			});
	}

	function resetAdayCariForm() {
		document.getElementById('adayCariForm').reset();
		loadYeniAdayCariKodu();
		document.getElementById('adayCariMessages').innerHTML = '';
	}

	document.getElementById('adayCariForm').addEventListener('submit', function(e) {
		e.preventDefault();
		const formData = new FormData(this);
		const jsonData = {};
		formData.forEach((value, key) => {
			jsonData[key] = value;
		});
		const submitBtn = this.querySelector('button[type="submit"]');
		const originalText = submitBtn.innerHTML;
		submitBtn.disabled = true;
		submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Kaydediliyor...';
		fetch('/api/crm/adaycari', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json',
				'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
			},
			body: JSON.stringify(jsonData)
		})
		.then(response => {
			if (!response.ok) {
				throw new Error(`HTTP error! status: ${response.status}`);
			}
			return response.json();
		})
		.then(data => {
			if (data.success) {
				document.getElementById('adayCariMessages').innerHTML = `
					<div class="alert-success">
						<i class="fas fa-check-circle"></i>
						<span>${data.message}</span>
					</div>`;
				refreshCariList();
				resetAdayCariForm();
				setTimeout(() => {
					openTab(null, 'teklifTab');
					if (data.data && data.data.cariKod) {
						document.getElementById('cariSelect').value = data.data.cariKod;
					}
				}, 1500);
			} else {
				document.getElementById('adayCariMessages').innerHTML = `
					<div class="alert-danger">
						<i class="fas fa-exclamation-triangle"></i>
						<span>${data.message}</span>
					</div>`;
			}
		})
		.catch(error => {
			console.error('API hatası:', error);
			document.getElementById('adayCariMessages').innerHTML = `
				<div class="alert-danger">
					<i class="fas fa-exclamation-triangle"></i>
					<span>Bağlantı hatası: ${error.message}</span>
				</div>`;
		})
		.finally(() => {
			submitBtn.disabled = false;
			submitBtn.innerHTML = originalText;
		});
	});

	function refreshCariList() {
		fetch('/Crm/GetCariHesaplar')
			.then(response => response.json())
			.then(data => {
				if (data.Success || data.success) {
					const cariSelect = document.getElementById('cariSelect');
					const cariler = data.Data || data.data;
					cariSelect.innerHTML = '<option value="">Firma Seçiniz</option>';
					cariler.forEach(cari => {
						const option = document.createElement('option');
						option.value = cari.Value;
						option.textContent = cari.Text;
						cariSelect.appendChild(option);
					});
					const cariTableBody = document.getElementById('cariTableBody');
					cariTableBody.innerHTML = '';
					cariler.forEach(cari => {
						const cariKod = cari.Value || '';
						const cariText = cari.Text || '';
						const parts = cariText.split(' - ');
						const cariAdi = parts.length > 1 ? parts[1] : cariText;
						const row = document.createElement('tr');
						row.className = 'select-row';
						row.onclick = function() { selectCari(cariKod, cariAdi); };
						row.innerHTML = `
							<td>${cariKod}</td>
							<td>${cariText}</td>
							<td>-</td>
							<td>-</td>
						`;
						cariTableBody.appendChild(row);
					});
				}
			})
			.catch(error => {
				console.error('Cari listesi yenilenemedi:', error);
			});
	}

	// ==================== CARİ SEÇİM FONKSİYONLARI ====================
	function openCariModal() {
		document.getElementById('cariModal').style.display = 'block';
	}

	function closeCariModal() {
		document.getElementById('cariModal').style.display = 'none';
	}

	function selectCari(cariKod, cariAdi) {
		document.getElementById('cariSelect').value = cariKod;
		const cariSelect = document.getElementById('cariSelect');
		for (let i = 0; i < cariSelect.options.length; i++) {
			if (cariSelect.options[i].value === cariKod) {
				cariSelect.selectedIndex = i;
				break;
			}
		}
		loadCariPersonelleri(cariKod);
		closeCariModal();
	}

	function searchCari() {
		const input = document.getElementById('cariSearchInput').value.toLowerCase();
		const rows = document.querySelectorAll('#cariTableBody tr');
		rows.forEach(row => {
			const text = row.textContent.toLowerCase();
			if (text.includes(input)) {
				row.style.display = '';
			} else {
				row.style.display = 'none';
			}
		});
	}

	function loadCariPersonelleri(cariKod) {
		if (!cariKod) return;
		fetch(`/Crm/GetCariPersonelleri?cariKod=${cariKod}`)
			.then(response => response.json())
			.then(data => {
				if (data.Success) {
					const personelSelect = document.getElementById('personelSelect');
					personelSelect.innerHTML = '<option value="">Seçiniz</option>';
					data.Data.forEach(personel => {
						const option = document.createElement('option');
						option.value = personel.Value;
						option.textContent = personel.Text;
						personelSelect.appendChild(option);
					});
				}
			})
			.catch(error => {
				console.error('Personeller yüklenirken hata:', error);
			});
	}

	// ==================== STOK FONKSİYONLARI ====================
	function loadStoklar() {
		console.log('Loading Stoklar from: ' + StokUrl);
		fetch(StokUrl)
			.then(response => {
				if (!response.ok) {
					throw new Error('Network response was not ok ' + response.statusText);
				}
				return response.json();
			})
			.then(data => {
				console.log('Stok data received:', data);
				if (data.Success || data.success) {
					StokListesi = data.Data || data.data;
					console.log('StokListesi set to:', StokListesi);
					const fotografliStokSayisi = StokListesi.filter(s => {
						const imageData = s.imageData || s.ImageData || '';
						return imageData && imageData.trim() !== '';
					}).length;
					console.log(`Toplam ${StokListesi.length} stok yüklendi, ${fotografliStokSayisi} tanesi fotoğraflı`);
					populateStokModal();
				} else {
					console.error('Stoklar yüklenemedi:', data.Message || data.message || 'Bilinmeyen hata');
					alert('Stoklar yüklenemedi: ' + (data.Message || data.message || 'Bilinmeyen hata'));
				}
			})
			.catch(error => {
				console.error('Stoklar yüklenirken hata:', error);
				alert('Stoklar yüklenirken hata oluştu: ' + error.message);
			});
	}

	function populateStokModal() {
		const tbody = document.getElementById('StokTableBody');
		if (!tbody) {
			console.error('StokTableBody elementi bulunamadı');
			return;
		}
		tbody.innerHTML = '';
		console.log('populateStokModal çalışıyor, StokListesi:', StokListesi);
		if (!StokListesi || StokListesi.length === 0) {
			tbody.innerHTML = '<tr><td colspan="5" class="text-center">Stok bulunamadı</td></tr>';
			return;
		}
		StokListesi.forEach((stok, index) => {
			const row = document.createElement('tr');
			row.className = 'select-row';
			row.style.cursor = 'pointer';
			const stokKod = stok.StokKod || stok.stokKod || '';
			const stokAdi = stok.StokAdi || stok.stokAdi || '';
			const kisaIsim = stok.KisaIsim || stok.kisaIsim || '';
			const birim = stok.Birim1 || stok.birim1 || 'Adet';
			const imageData = stok.imageData || stok.ImageData || '';
			row.onclick = function() {
				selectStok(stokKod, stokAdi, birim);
			};
			let imageHtml = '';
			if (imageData && imageData.trim() !== '') {
				try {
					imageHtml = `<img src="data:image/jpeg;base64,${imageData}"
									 alt="${stokAdi}"
									 class="product-image"
									 style="width: 40px; height: 40px; border-radius: 4px; object-fit: cover; cursor: pointer;"
									 onclick="event.stopPropagation(); showImageModal('data:image/jpeg;base64,${imageData}', '${stokAdi}')" />`;
				} catch (error) {
					console.error(`Fotoğraf işlenirken hata (${stokKod}):`, error);
					imageHtml = '<span style="color: #e74c3c; font-size: 12px;">Hatalı fotoğraf</span>';
				}
			} else {
				imageHtml = '<span style="color: #95a5a6; font-size: 12px;">Fotoğraf Yok</span>';
			}
			row.innerHTML = `
				<td>${stokKod}</td>
				<td>${stokAdi}</td>
				<td>${kisaIsim}</td>
				<td>${birim}</td>
				<td style="text-align: center;">${imageHtml}</td>
			`;
			tbody.appendChild(row);
		});
		const fotografliStokSayisi = StokListesi.filter(s => {
			const imageData = s.imageData || s.ImageData || '';
			return imageData && imageData.trim() !== '';
		}).length;
		console.log(`populateStokModal tamamlandı: ${StokListesi.length} stok satırı eklendi, ${fotografliStokSayisi} tanesi fotoğraflı`);
	}

	function showImageModal(imageSrc, stokAdi) {
		const modal = document.createElement('div');
		modal.style.cssText = `
			display: block;
			position: fixed;
			z-index: 10000;
			left: 0;
			top: 0;
			width: 100%;
			height: 100%;
			background-color: rgba(0,0,0,0.8);
			cursor: pointer;
		`;
		modal.innerHTML = `
			<div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
				<img src="${imageSrc}" alt="${stokAdi}" style="max-width: 90vw; max-height: 90vh; border-radius: 8px;" />
				<div style="color: white; margin-top: 10px; font-size: 18px;">${stokAdi}</div>
				<div style="color: #ccc; margin-top: 5px; font-size: 14px;">Kapatmak için tıklayın</div>
			</div>
		`;
		modal.onclick = function() {
			document.body.removeChild(modal);
		};
		document.body.appendChild(modal);
	}

	function getStokFiyati(stokKod, callback) {
		if (!stokKod || stokKod.trim() === '') {
			console.log('Stok kodu boş, fiyat 0 olarak ayarlanıyor');
			callback(0);
			return;
		}
		console.log(`Fiyat alınıyor: ${stokKod}`);
		fetch(`/Crm/GetStokFiyati?StokKod=${encodeURIComponent(stokKod)}&dovizCinsi=0`)
			.then(response => {
				if (!response.ok) {
					throw new Error(`HTTP Error: ${response.status}`);
				}
				return response.json();
			})
			.then(data => {
				console.log('Fiyat response:', data);
				const success = data.Success || data.success;
				const fiyat = data.Fiyat || data.fiyat;
				if (success === true) {
					console.log(`Fiyat başarıyla alındı: ${fiyat}`);
					callback(fiyat || 0);
				} else {
					console.warn(`${stokKod} için fiyat bulunamadı`);
					callback(0);
				}
			})
			.catch(error => {
				console.error('Fiyat getirilirken hata:', error);
				callback(0);
			});
	}

	function searchStok() {
		const searchTerm = document.getElementById('StokSearchInput').value.toLowerCase();
		const rows = document.querySelectorAll('#StokTableBody tr');
		rows.forEach(row => {
			const text = row.textContent.toLowerCase();
			if (text.includes(searchTerm)) {
				row.style.display = '';
			} else {
				row.style.display = 'none';
			}
		});
	}

	function openStokModal(rowIndex) {
		currentStokRow = rowIndex;
		document.getElementById('StokModal').style.display = 'block';
		document.getElementById('StokSearchInput').value = '';
		if (StokListesi.length === 0) {
			loadStoklar();
		} else {
			populateStokModal();
		}
	}

	function closeStokModal() {
		document.getElementById('StokModal').style.display = 'none';
		currentStokRow = null;
	}

	function selectStok(StokKod, StokAdi, birim) {
		if (currentStokRow !== null) {
			const row = document.querySelector(`#productTableBody tr:nth-child(${currentStokRow + 1})`);
			if (row) {
				row.querySelector('[name*="].StokKod"]').value = StokKod || '';
				const StokAdiInput = row.querySelector('[name*="].StokAdi"]');
				if (StokAdiInput) {
					StokAdiInput.value = StokAdi || '';
				}
				updateSelectedStokDisplay(currentStokRow, StokAdi);
				const selectedStok = StokListesi.find(s => (s.StokKod || s.stokKod) === StokKod);
				updateProductRowImage(currentStokRow, selectedStok, StokAdi);
				getStokFiyati(StokKod, function(fiyat) {
					row.querySelector('[name*="].BirimFiyat"]').value = fiyat;
					const indirimliFiyatInput = row.querySelector('[name*="].IndirimliFiyat"]');
					if (indirimliFiyatInput) {
						indirimliFiyatInput.value = fiyat;
					}
					calculateRowTotal(row);
				});
			}
		}
		closeStokModal();
	}

	function updateSelectedStokDisplay(rowIndex, StokAdi) {
		const nameDisplay = document.getElementById(`selectedStokName_${rowIndex}`);
		if (nameDisplay) {
			nameDisplay.textContent = StokAdi || 'Ürün seçilmedi';
			nameDisplay.className = StokAdi ? 'selected-product-name text-success' : 'selected-product-name text-muted';
		}
	}

	// ==================== ÜRÜN SATIRI FONKSİYONLARI ====================
	function addProductRow() {
		const tbody = document.getElementById('productTableBody');
		const row = document.createElement('tr');

		row.innerHTML = `
			<td>${rowCounter + 1}</td>
			<td>
				<div class="product-image-container">
					<div style="flex-shrink: 0;">
						<img id="productImage_${rowCounter}"
							 src=""
							 alt=""
							 style="display: none; width: 50px; height: 50px; border-radius: 6px; object-fit: cover; border: 1px solid #e0e6ed; cursor: pointer;"
							 onclick="showImageModal(this.src, document.querySelector('input[name=&quot;Teklif.Urunler[${rowCounter}].StokAdi&quot;]').value)" />
						<div id="noImagePlaceholder_${rowCounter}" class="product-placeholder">
							Fotoğraf<br>Yok
						</div>
					</div>
					<div class="product-select-area">
						<div class="input-group">
							<input type="text" name="Teklif.Urunler[${rowCounter}].StokKod" readonly placeholder="Stok Kodu" />
							<button type="button" class="btn btn-secondary" onclick="openStokModal(${rowCounter})">Seç</button>
						</div>
						<input type="hidden" name="Teklif.Urunler[${rowCounter}].StokAdi" />
						<span id="selectedStokName_${rowCounter}" class="selected-product-name text-muted">Ürün seçilmedi</span>
					</div>
				</div>
			</td>
			<td>
				<input type="text" name="Teklif.Urunler[${rowCounter}].Aciklama" placeholder="Her ürün için ayrı açıklama..." />
			</td>
			<td>
				<input type="number"
					   name="Teklif.Urunler[${rowCounter}].Miktar"
					   value="1"
					   min="0.01"
					   step="0.01"
					   lang="tr"
					   onchange="calculateRowTotal(this.closest('tr'))" />
			</td>
			<td>
				<input type="number"
					   name="Teklif.Urunler[${rowCounter}].BirimFiyat"
					   value="0"
					   min="0"
					   step="0.01"
					   lang="tr"
					   onchange="calculateRowTotal(this.closest('tr'))"
					   readonly />
			</td>
			<td>
				<input type="number"
					   name="Teklif.Urunler[${rowCounter}].IndirimliFiyat"
					   value="0"
					   min="0"
					   step="0.01"
					   lang="tr"
					   onchange="calculateRowTotal(this.closest('tr'))" />
			</td>
			<td>
				<select name="Teklif.Urunler[${rowCounter}].KdvOrani" onchange="calculateRowTotal(this.closest('tr'))">
					<option value="0">%0</option>
					<option value="1">%1</option>
					<option value="10">%10</option>
					<option value="20" selected>%20</option>
					<option value="30">%30</option>
				</select>
			</td>
			<td>
				<input type="number"
					   name="Teklif.Urunler[${rowCounter}].Toplam"
					   value="0"
					   readonly
					   class="row-total"
					   step="0.01"
					   lang="tr" />
			</td>
			<td>
				<button type="button" class="remove-product-btn" onclick="removeProductRow(this)">Sil</button>
			</td>
		`;

		tbody.appendChild(row);
		rowCounter++;
	}

	// ✅ KDV DAHİL HESAPLAMA
	function calculateRowTotal(row) {
		const miktarInput = row.querySelector('[name*="].Miktar"]');
		const indirimliFiyatInput = row.querySelector('[name*="].IndirimliFiyat"]');
		const birimFiyatInput = row.querySelector('[name*="].BirimFiyat"]');
		const kdvOraniSelect = row.querySelector('[name*="].KdvOrani"]');

		let miktarValue = miktarInput.value.replace(',', '.');
		let indirimliFiyatValue = indirimliFiyatInput.value.replace(',', '.');
		let birimFiyatValue = birimFiyatInput.value.replace(',', '.');

		const miktar = parseFloat(miktarValue) || 0;
		const indirimliFiyat = parseFloat(indirimliFiyatValue) || 0;
		const birimFiyat = parseFloat(birimFiyatValue) || 0;
		const kdvOrani = parseInt(kdvOraniSelect.value) || 0;

		const kullanilacakFiyat = indirimliFiyat > 0 ? indirimliFiyat : birimFiyat;
		const araToplam = miktar * kullanilacakFiyat;
		const kdvTutari = (araToplam * kdvOrani) / 100;
		const toplam = araToplam + kdvTutari;

		row.querySelector('[name*="].Toplam"]').value = toplam.toFixed(2);

		calculateTotal();
	}

	function removeProductRow(button) {
		const row = button.closest('tr');
		if (document.querySelectorAll('#productTableBody tr').length > 1) {
			row.remove();
			calculateTotal();
			updateRowNumbers();
		} else {
			alert('En az bir ürün satırı olmalıdır.');
		}
	}

	function updateRowNumbers() {
		const rows = document.querySelectorAll('#productTableBody tr');
		rows.forEach((row, index) => {
			row.querySelector('td:first-child').textContent = index + 1;
		});
	}

	function updateProductRowImage(rowIndex, stok, stokAdi) {
		const productImage = document.getElementById(`productImage_${rowIndex}`);
		const noImagePlaceholder = document.getElementById(`noImagePlaceholder_${rowIndex}`);

		if (!productImage || !noImagePlaceholder) {
			console.log(`Fotoğraf elementleri bulunamadı: row ${rowIndex}`);
			return;
		}

		if (stok && (stok.imageData || stok.ImageData)) {
			const imageData = stok.imageData || stok.ImageData;
			if (imageData && imageData.trim() !== '') {
				productImage.src = `data:image/jpeg;base64,${imageData}`;
				productImage.alt = stokAdi || 'Ürün fotoğrafı';
				productImage.title = `${stokAdi} - Büyütmek için tıklayın`;
				productImage.style.display = 'block';
				noImagePlaceholder.style.display = 'none';

				console.log(`Ürün satırına fotoğraf eklendi: ${stok.StokKod || stok.stokKod}`);
				return;
			}
		}

		productImage.style.display = 'none';
		noImagePlaceholder.style.display = 'flex';
		console.log(`Ürün satırında fotoğraf bulunamadı: ${stok?.StokKod || stok?.stokKod || 'Bilinmeyen'}`);
	}

	// ==================== HESAPLAMA FONKSİYONLARI ====================
	// ✅ TOPLAM KDV HESAPLAMASI DAHİL
	function calculateTotal() {
		let subTotal = 0;
		let totalKdv = 0;

		// Her satırı işle
		document.querySelectorAll('#productTableBody tr').forEach(row => {
			const miktarInput = row.querySelector('[name*="].Miktar"]');
			const indirimliFiyatInput = row.querySelector('[name*="].IndirimliFiyat"]');
			const birimFiyatInput = row.querySelector('[name*="].BirimFiyat"]');
			const kdvOraniSelect = row.querySelector('[name*="].KdvOrani"]');

			if (miktarInput && indirimliFiyatInput && kdvOraniSelect) {
				const miktar = parseFloat(miktarInput.value.replace(',', '.')) || 0;
				const indirimliFiyat = parseFloat(indirimliFiyatInput.value.replace(',', '.')) || 0;
				const birimFiyat = parseFloat(birimFiyatInput.value.replace(',', '.')) || 0;
				const kdvOrani = parseInt(kdvOraniSelect.value) || 0;

				const kullanilacakFiyat = indirimliFiyat > 0 ? indirimliFiyat : birimFiyat;
				const araToplam = miktar * kullanilacakFiyat;
				const kdvTutari = (araToplam * kdvOrani) / 100;

				subTotal += araToplam;
				totalKdv += kdvTutari;
			}
		});

		const grandTotal = subTotal + totalKdv;

		document.getElementById('subTotal').textContent = formatCurrency(subTotal);
		document.getElementById('kdvAmount').textContent = formatCurrency(totalKdv);
		document.getElementById('grandTotal').textContent = formatCurrency(grandTotal);
	}

	function formatCurrency(amount) {
		return new Intl.NumberFormat('tr-TR', {
			style: 'currency',
			currency: 'TRY'
		}).format(amount);
	}

	function syncDatesAndCalculate() {
		const tarihInput = document.querySelector('input[name="Teklif.Tarih"]');
		const baslangicTarihiInput = document.querySelector('input[name="Teklif.BaslangicTarihi"]');

		if (tarihInput && baslangicTarihiInput) {
			baslangicTarihiInput.value = tarihInput.value;
			console.log('Tarihler senkronize edildi:', tarihInput.value);
		}

		calculateBitisTarihi();
	}

	function calculateBitisTarihi() {
		const tarihInput = document.querySelector('input[name="Teklif.Tarih"]');
		const gecerlilikSuresiSelect = document.querySelector('select[name="Teklif.GecerlilikSuresi"]');
		const bitisTarihiDisplay = document.getElementById('BitisTarihiDisplay');
		const gecerlilikMesaji = document.getElementById('gecerlilikMesaji');

		if (!tarihInput || !gecerlilikSuresiSelect || !bitisTarihiDisplay) {
			console.log('Gerekli elementler bulunamadı');
			return;
		}

		const tarihValue = tarihInput.value;
		const gecerlilikSuresi = parseInt(gecerlilikSuresiSelect.value) || 7;

		console.log('Hesaplama:', { tarihValue, gecerlilikSuresi });

		if (tarihValue && gecerlilikSuresi > 0) {
			const baslangicTarihi = new Date(tarihValue);
			const bitisTarihiObj = new Date(baslangicTarihi);
			bitisTarihiObj.setDate(bitisTarihiObj.getDate() + gecerlilikSuresi);

			const bitisTarihi = bitisTarihiObj.toISOString().split('T')[0];
			bitisTarihiDisplay.value = bitisTarihi;

			if (gecerlilikMesaji) {
				const gunYazisi = getGunYazisi(gecerlilikSuresi);
				gecerlilikMesaji.textContent = `Bu teklifin geçerlilik süresi düzenleme tarihinden itibaren ${gecerlilikSuresi} (${gunYazisi}) iş günüdür.`;
			}

			console.log(`Bitiş tarihi hesaplandı: ${bitisTarihi} (${gecerlilikSuresi} gün sonra)`);
		} else {
			bitisTarihiDisplay.value = '';

			if (gecerlilikMesaji) {
				gecerlilikMesaji.textContent = 'Bu teklifin geçerlilik süresi düzenleme tarihinden itibaren 7 (yedi) iş günüdür.';
			}
		}
	}

	function getGunYazisi(gun) {
		switch(gun) {
			case 7: return 'yedi';
			case 14: return 'on dört';
			case 30: return 'otuz';
			default: return gun.toString();
		}
	}

	// ==================== FORM SUBMIT ====================
	document.getElementById('teklifForm').addEventListener('submit', function(e) {
		const numberInputs = this.querySelectorAll('input[type="number"]');
		numberInputs.forEach(input => {
			if (input.value && input.value.includes(',')) {
				input.value = input.value.replace(',', '.');
			}
		});

		let hasProducts = false;
		const rows = document.querySelectorAll('#productTableBody tr');

		rows.forEach(row => {
			const StokKod = row.querySelector('[name*="].StokKod"]')?.value;
			const miktar = parseFloat(row.querySelector('[name*="].Miktar"]')?.value || 0);
			if (StokKod && miktar > 0) {
				hasProducts = true;
			}
		});

		if (!hasProducts) {
			alert('Lütfen en az bir ürün ekleyiniz.');
			e.preventDefault();
			return;
		}
	});

	// ==================== EVENT LISTENERS ====================
	document.querySelector('input[name="Teklif.BaslangicTarihi"]').addEventListener('change', calculateBitisTarihi);
	document.querySelector('select[name="Teklif.GecerlilikSuresi"]').addEventListener('change', calculateBitisTarihi);

	window.addEventListener('click', function(event) {
		const cariModal = document.getElementById('cariModal');
		const StokModal = document.getElementById('StokModal');

		if (event.target === cariModal) {
			closeCariModal();
		}
		if (event.target === StokModal) {
			closeStokModal();
		}
	});
</script>