		<!-- Stok Seçim Modal -->
		<div id="StokModal" class="modal">
			<div class="modal-content">
				<div class="modal-header">
					<h4 class="modal-title">Ürün Seçin</h4>
					<span class="close" onclick="closeStokModal()">&times;</span>
				</div>
				<div class="modal-body">
					<input type="text" class="search-input" placeholder="Ürün adı ile arayın..." onkeyup="searchStok()" id="StokSearchInput">
					<div class="table-responsive">
						<table class="table table-striped" id="StokTable">
							<thead>
								<tr>
									<th>Stok Kodu</th>
									<th>Ürün Adı</th>
									<th>Kısa İsim</th>
									<th>Birim</th>
									<th>Fotoğraf</th>
								</tr>
							</thead>
							<tbody id="StokTableBody">
