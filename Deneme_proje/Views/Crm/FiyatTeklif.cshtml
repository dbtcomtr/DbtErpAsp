											<input type="text" name="urunAdi[]" value="BELLA ÇALIŞMA / TOPLANTI KOLTUĞU" placeholder="Ürün adı" />
											<div class="product-dimensions">Ofis Koltuğu</div>
										</td>
										<td><input type="number" name="adet[]" value="6" min="0" onchange="calculateRowTotal(this)" /></td>
										<td><input type="number" name="birimFiyat[]" value="5043" step="0.01" onchange="calculateRowTotal(this)" /></td>
										<td><input type="number" name="indirimliFiyat[]" value="4000" step="0.01" onchange="calculateRowTotal(this)" /></td>
										<td><span class="row-total">24.000,00 TL</span></td>
										<td>
											<button type="button" class="remove-product-btn" onclick="removeProductRow(this)">🗑️</button>
										</td>
									</tr>
									<tr>
										<td>8</td>
										<td class="product-image-cell">
											<div class="product-image">
												<input type="file" accept="image/*" onchange="previewImage(this)">
												<div class="image-placeholder">Görsel<br>Seç</div>
											</div>
										</td>
										<td class="product-name-cell">
											<input type="text" name="urunAdi[]" value="BELLA MÜDÜR KOLTUĞU" placeholder="Ürün adı" />
											<div class="product-dimensions">Müdür Koltuğu</div>
										</td>
										<td><input type="number" name="adet[]" value="1" min="0" onchange="calculateRowTotal(this)" /></td>
										<td><input type="number" name="birimFiyat[]" value="5371" step="0.01" onchange="calculateRowTotal(this)" /></td>
										<td><input type="number" name="indirimliFiyat[]" value="4300" step="0.01" onchange="calculateRowTotal(this)" /></td>
										<td><span class="row-total">4.300,00 TL</span></td>
										<td>
											<button type="button" class="remove-product-btn" onclick="removeProductRow(this)">🗑️</button>
										</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>

				<!-- Toplam Bilgileri -->
				<div class="totals-section">
					<h4 style="margin-bottom: 20px; color: #2c3e50; font-size: 1.1rem;">💰 Toplam Bilgileri</h4>
					<div class="totals-row"><span>Ara Toplam</span><span id="subTotal">90.800,00 TL</span></div>
					<div class="totals-row"><span>KDV (%18)</span><span id="kdvAmount">16.344,00 TL</span></div>
					<div class="totals-row"><span>KDV'li Toplam</span><span id="grandTotal">107.144,00 TL</span></div>
				</div>

				<!-- Şartlar ve Koşullar -->
				<div class="terms-section">
					<div class="terms-title">📋 Şartlar ve Koşullar</div>
					<ul class="terms-list">
						<li><strong>KDV Bilgisi:</strong> Fiyatlara KDV dahil değildir.</li>
						<li><strong>Teslimat:</strong> Nakliye ve montaj firmamıza aittir.</li>
						<li><strong>Geçerlilik:</strong> Bu teklifin geçerlilik süresi 7 iş günüdür.</li>

					</ul>
				</div>
			</div>

			<!-- Form Actions -->
			<div class="form-actions">
				<div>
					<button type="button" class="btn btn-secondary" onclick="calculateTotal()">🔄 Hesapla</button>
					<button type="button" class="btn btn-secondary" onclick="clearForm()">🧹 Temizle</button>
				</div>
				<div style="display: flex; gap: 10px;">
					<button type="button" class="btn btn-secondary">❌ İptal</button>
					<button type="button" class="btn btn-primary" onclick="printOffer()">🖨️ Yazdır</button>
					<button type="button" class="btn btn-success" onclick="saveOffer()">💾 Kaydet</button>
				</div>
			</div>
		</form>
	</div>
</div>

<script>
		let rowCounter = 8;

		function addProductRow() {
			rowCounter++;
			const tbody = document.getElementById('productTableBody');
			const newRow = `
				<tr>
					<td>${rowCounter}</td>
					<td class="product-image-cell">
						<div class="product-image">
							<input type="file" accept="image/*" onchange="previewImage(this)">
							<div class="image-placeholder">Görsel<br>Seç</div>
						</div>
					</td>
					<td class="product-name-cell">
						<input type="text" name="urunAdi[]" placeholder="Ürün adı" />
						<div class="product-dimensions">Ölçüler</div>
					</td>
					<td><input type="number" name="adet[]" value="1" min="0" onchange="calculateRowTotal(this)" /></td>
					<td><input type="number" name="birimFiyat[]" value="0" step="0.01" onchange="calculateRowTotal(this)" /></td>
					<td><input type="number" name="indirimliFiyat[]" value="0" step="0.01" onchange="calculateRowTotal(this)" /></td>
					<td><span class="row-total">0,00 TL</span></td>
					<td>
						<button type="button" class="remove-product-btn" onclick="removeProductRow(this)">🗑️</button>
					</td>
				</tr>
			`;
			tbody.insertAdjacentHTML('beforeend', newRow);
		}

		function previewImage(input) {
			const file = input.files[0];
			if (file) {
				const reader = new FileReader();
				reader.onload = function(e) {
					const imageContainer = input.parentElement;
					const placeholder = imageContainer.querySelector('.image-placeholder');

					// Mevcut görseli kaldır
					const existingImg = imageContainer.querySelector('img');
					if (existingImg) {
						existingImg.remove();
					}

					// Yeni görseli ekle
					const img = document.createElement('img');
					img.src = e.target.result;
					img.alt = 'Ürün Görseli';
					imageContainer.appendChild(img);

					// Placeholder'ı gizle
					if (placeholder) {
						placeholder.style.display = 'none';
					}
				};
				reader.readAsDataURL(file);
			}
		}

		function removeProductRow(button) {
			const row = button.closest('tr');
			if (document.querySelectorAll('#productTableBody tr').length > 1) {
				row.remove();
				calculateTotal();
				updateRowNumbers();
			}
		}

		function updateRowNumbers() {
			const rows = document.querySelectorAll('#productTableBody tr');
			rows.forEach((row, index) => {
				row.cells[0].textContent = index + 1;
			});
			rowCounter = rows.length;
		}

		function calculateRowTotal(input) {
			const row = input.closest('tr');
			const adet = parseFloat(row.querySelector('input[name="adet[]"]').value) || 0;
			const indirimliFiyat = parseFloat(row.querySelector('input[name="indirimliFiyat[]"]').value) || 0;
			const total = adet * indirimliFiyat;

			row.querySelector('.row-total').textContent =
				new Intl.NumberFormat('tr-TR', {
					minimumFractionDigits: 2,
					maximumFractionDigits: 2
				}).format(total) + ' TL';

			calculateTotal();
		}

		function calculateTotal() {
			let subTotal = 0;

			const rows = document.querySelectorAll('#productTableBody tr');
			rows.forEach(row => {
				const adet = parseFloat(row.querySelector('input[name="adet[]"]')?.value || 0);
				const indirimliFiyat = parseFloat(row.querySelector('input[name="indirimliFiyat[]"]')?.value || 0);
				subTotal += adet * indirimliFiyat;
			});

			const kdvAmount = subTotal * 0.18;
			const grandTotal = subTotal + kdvAmount;

			document.getElementById('subTotal').textContent =
				new Intl.NumberFormat('tr-TR', {
					minimumFractionDigits: 2,
					maximumFractionDigits: 2
				}).format(subTotal) + ' TL';

			document.getElementById('kdvAmount').textContent =
				new Intl.NumberFormat('tr-TR', {
					minimumFractionDigits: 2,
					maximumFractionDigits: 2
				}).format(kdvAmount) + ' TL';

			document.getElementById('grandTotal').textContent =
				new Intl.NumberFormat('tr-TR', {
					minimumFractionDigits: 2,
					maximumFractionDigits: 2
				}).format(grandTotal) + ' TL';
		}

		function saveOffer() {
			// Form verilerini topla
			const formData = new FormData(document.getElementById('offerForm'));

			// Başarı mesajı göster
			alert('✅ Teklif başarıyla kaydedildi!\n\nForm No: ' + formData.get('formNo') + '\nFirma: ' + formData.get('company'));

			console.log('Kaydedilen teklif verileri:', Object.fromEntries(formData));
		}

		function printOffer() {
			// Yazdırma öncesi sayfayı hazırla
			const printContent = document.querySelector('.form-container').innerHTML;
			const originalContent = document.body.innerHTML;

			// Yazdırma stillerini ekle
			const printStyles = `
				<style>
		@@media print {
						body { font-family: Arial, sans-serif; font-size: 12px; }
						.form-actions, .add-product-btn, .remove-product-btn { display: none !important; }
						.form-container { border: none; box-shadow: none; }
						.table-container { overflow: visible; }
						.product-table { min-width: auto; }
					}
				</style>
			`;

			document.body.innerHTML = printStyles + '<div class="form-container">' + printContent + '</div>';
			window.print();
			document.body.innerHTML = originalContent;

			// Event listener'ları yeniden bağla
			setTimeout(() => {
				calculateTotal();
			}, 100);
		}

		// Sayfa yüklendiğinde hesapla
		document.addEventListener('DOMContentLoaded', function() {
			calculateTotal();

			// Tüm input alanlarına change event'i ekle
			document.querySelectorAll('input[name="adet[]"], input[name="indirimliFiyat[]"]').forEach(input => {
				input.addEventListener('change', function() {
					calculateRowTotal(this);
				});
			});
		});

		function clearForm() {
			if (confirm('Formu temizlemek istediğinizden emin misiniz? Tüm veriler silinecektir.')) {
				// Form alanlarını temizle
				document.getElementById('offerForm').reset();

				// Tabloyu varsayılan duruma getir
				const tbody = document.getElementById('productTableBody');
				tbody.innerHTML = `
					<tr>
						<td>1</td>
						<td class="product-image-cell">
							<div class="product-image">
								<input type="file" accept="image/*" onchange="previewImage(this)">
								<div class="image-placeholder">Görsel<br>Seç</div>
							</div>
						</td>
						<td class="product-name-cell">
							<input type="text" name="urunAdi[]" placeholder="Ürün adı" />
							<div class="product-dimensions">Ölçüler</div>
						</td>
						<td><input type="number" name="adet[]" value="1" min="0" onchange="calculateRowTotal(this)" /></td>
						<td><input type="number" name="birimFiyat[]" value="0" step="0.01" onchange="calculateRowTotal(this)" /></td>
						<td><input type="number" name="indirimliFiyat[]" value="0" step="0.01" onchange="calculateRowTotal(this)" /></td>
						<td><span class="row-total">0,00 TL</span></td>
						<td>
							<button type="button" class="remove-product-btn" onclick="removeProductRow(this)">🗑️</button>
						</td>
					</tr>
				`;

				rowCounter = 1;
				calculateTotal();
			}
		}

		// Form değişikliklerini dinle
		document.getElementById('offerForm').addEventListener('input', function(e) {
			if (e.target.name === 'adet[]' || e.target.name === 'indirimliFiyat[]') {
				calculateRowTotal(e.target);
			}
		});

	function addProductRow() {
		rowCounter++;
		const tbody = document.getElementById('productTableBody');
		const newRow = `
			<tr>
				<td>${rowCounter}</td>
				<td class="product-image-cell">
					<div class="product-image">
						<input type="file" accept="image/*" onchange="previewImage(this)">
						<div class="image-placeholder">Görsel<br>Seç</div>
					</div>
				</td>
				<td class="product-name-cell">
					<input type="text" name="urunAdi[]" placeholder="Ürün adı" />
					<div class="product-dimensions">Ölçüler</div>
				</td>
				<td><input type="number" name="adet[]" value="1" min="0" onchange="calculateRowTotal(this)" /></td>
				<td><input type="number" name="birimFiyat[]" value="0" step="0.01" onchange="calculateRowTotal(this)" /></td>
				<td><input type="number" name="indirimliFiyat[]" value="0" step="0.01" onchange="calculateRowTotal(this)" /></td>
				<td><span class="row-total">0,00 TL</span></td>
				<td>
					<button type="button" class="remove-product-btn" onclick="removeProductRow(this)">🗑️</button>
				</td>
			</tr>
		`;
		tbody.insertAdjacentHTML('beforeend', newRow);
	}

	function previewImage(input) {
		const file = input.files[0];
		if (file) {
			const reader = new FileReader();
			reader.onload = function(e) {
				const imageContainer = input.parentElement;
				const placeholder = imageContainer.querySelector('.image-placeholder');

				// Mevcut görseli kaldır
				const existingImg = imageContainer.querySelector('img');
				if (existingImg) {
					existingImg.remove();
				}

				// Yeni görseli ekle
				const img = document.createElement('img');
				img.src = e.target.result;
				img.alt = 'Ürün Görseli';
				imageContainer.appendChild(img);

				// Placeholder'ı gizle
				if (placeholder) {
					placeholder.style.display = 'none';
				}
			};
			reader.readAsDataURL(file);
		}
	}

</script>