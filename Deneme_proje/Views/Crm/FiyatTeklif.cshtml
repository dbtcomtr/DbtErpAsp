										</td>
										<td><input type="number" name="adet[]" value="1" min="0" onchange="calculateRowTotal(this)" /></td>
										<td><input type="number" name="birimFiyat[]" value="35870" step="0.01" onchange="calculateRowTotal(this)" /></td>
										<td><input type="number" name="indirimliFiyat[]" value="30000" step="0.01" onchange="calculateRowTotal(this)" /></td>
