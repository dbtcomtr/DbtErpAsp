
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Ofis Mobilyaları Teklif Formu</title>
	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
			background-color: #f5f6fa;
			color: #2c3e50;
		}

		.main-content {
			padding: 20px;
		}

		.breadcrumb-custom {
			background: none;
			padding: 0;
			margin-bottom: 20px;
			font-size: 0.9rem;
			color: #6c757d;
		}

			.breadcrumb-custom a {
				color: #6c757d;
				text-decoration: none;
			}

				.breadcrumb-custom a:hover {
					color: #2c3e50;
				}

			.breadcrumb-custom .active {
				color: #2c3e50;
				font-weight: 600;
			}

		.form-container {
			background: white;
			border: 1px solid #e0e6ed;
			overflow: hidden;
			margin: 0 auto;
			max-width: 1400px;
		}

		.form-header {
			background: #34495e;
			color: white;
			padding: 20px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			border-bottom: 3px solid #2c3e50;
		}

		.form-title {
			font-size: 1.3rem;
			font-weight: 600;
			margin: 0;
		}

		.company-info {
			display: flex;
			gap: 20px;
			align-items: center;
			font-size: 0.9rem;
		}

		.form-body {
			padding: 30px;
		}

		.form-section {
			border: 1px solid #e0e6ed;
			overflow: hidden;
			margin-bottom: 25px;
		}

		.section-header {
			background: #f8f9fa;
			padding: 15px 20px;
			border-bottom: 1px solid #e0e6ed;
			border-left: 4px solid #34495e;
			font-weight: 600;
			color: #2c3e50;
			font-size: 1rem;
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		.add-main-product-btn {
			background: #27ae60;
			color: white;
			border: none;
			border-radius: 4px;
			padding: 8px 15px;
			cursor: pointer;
			font-size: 0.85rem;
			font-weight: 500;
			transition: all 0.2s ease;
		}

			.add-main-product-btn:hover {
				background: #229954;
				transform: translateY(-1px);
			}

		.product-image-cell {
			width: 80px;
			text-align: center;
		}

		.product-image {
			width: 60px;
			height: 60px;
			background: #f8f9fa;
			border: 2px solid #e0e6ed;
			border-radius: 8px;
			display: flex;
			align-items: center;
			justify-content: center;
			margin: 0 auto;
			cursor: pointer;
			transition: all 0.2s ease;
			position: relative;
			overflow: hidden;
		}

			.product-image:hover {
				border-color: #34495e;
				background: #e9ecef;
			}

			.product-image input[type="file"] {
				position: absolute;
				width: 100%;
				height: 100%;
				opacity: 0;
				cursor: pointer;
			}

			.product-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 6px;
			}

		.image-placeholder {
			font-size: 0.75em;
			color: #6c757d;
			text-align: center;
			line-height: 1.2;
		}

		.section-body {
			padding: 25px;
		}

		.form-row {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 20px;
			margin-bottom: 20px;
		}

		.form-group {
			display: flex;
			flex-direction: column;
		}

			.form-group label {
				font-weight: 600;
				color: #2c3e50;
				margin-bottom: 5px;
				font-size: 0.9rem;
			}

			.form-group input,
			.form-group select,
			.form-group textarea {
				padding: 12px 15px;
				border: 1px solid #e0e6ed;
				border-radius: 4px;
				font-size: 0.9rem;
				transition: all 0.2s ease;
				background: white;
			}

				.form-group input:focus,
				.form-group select:focus,
				.form-group textarea:focus {
					outline: none;
					border-color: #2c3e50;
					box-shadow: 0 0 0 2px rgba(44, 62, 80, 0.1);
				}

		/* Ürün Tablosu */
		.table-container {
			overflow-x: auto;
			border: 1px solid #e0e6ed;
			border-radius: 4px;
		}

		.product-table {
			width: 100%;
			border-collapse: collapse;
			min-width: 1000px;
		}

			.product-table th {
				background: #34495e;
				color: white;
				padding: 12px 10px;
				text-align: left;
				font-weight: 600;
				font-size: 0.85rem;
				border-right: 1px solid #2c3e50;
			}

				.product-table th:last-child {
					border-right: none;
				}

			.product-table td {
				padding: 10px;
				border: 1px solid #e0e6ed;
				vertical-align: middle;
			}

			.product-table input,
			.product-table select {
				width: 100%;
				padding: 8px 10px;
				border: 1px solid #e0e6ed;
				border-radius: 3px;
				font-size: 0.85rem;
				background: white;
			}

				.product-table input:focus,
				.product-table select:focus {
					outline: none;
					border-color: #2c3e50;
				}

		.product-name-cell {
			min-width: 200px;
		}

		.product-dimensions {
			font-size: 0.8rem;
			color: #7f8c8d;
			margin-top: 3px;
		}

		.add-product-btn,
		.remove-product-btn {
			border: none;
			border-radius: 3px;
			padding: 6px 10px;
			cursor: pointer;
			font-size: 0.8rem;
			font-weight: 500;
			margin-right: 5px;
		}

		.add-product-btn {
			background: #27ae60;
			color: white;
		}

		.remove-product-btn {
			background: #e74c3c;
			color: white;
		}

		.add-product-btn:hover {
			background: #229954;
		}

		.remove-product-btn:hover {
			background: #c0392b;
		}

		/* Toplam Bölümü */
		.totals-section {
			background: #f8f9fa;
			padding: 25px;
			border: 1px solid #e0e6ed;
			border-radius: 4px;
			margin-top: 20px;
		}

		.totals-row {
			display: flex;
			justify-content: space-between;
			padding: 8px 0;
			border-bottom: 1px solid #e0e6ed;
			font-size: 0.9rem;
		}

			.totals-row:last-child {
				border-bottom: none;
				font-weight: 600;
				color: #2c3e50;
				font-size: 1.1rem;
				margin-top: 10px;
				padding-top: 15px;
				border-top: 2px solid #34495e;
			}

		/* Butonlar */
		.form-actions {
			background: #f8f9fa;
			padding: 20px;
			display: flex;
			justify-content: space-between;
			gap: 15px;
			border-top: 1px solid #e0e6ed;
		}

		.btn {
			padding: 12px 25px;
			border: 1px solid transparent;
			border-radius: 4px;
			font-weight: 600;
			cursor: pointer;
			text-decoration: none;
			display: inline-flex;
			align-items: center;
			gap: 8px;
			transition: all 0.2s ease;
			font-size: 0.9rem;
		}

		.btn-primary {
			background: #2c3e50;
			color: white;
			border-color: #2c3e50;
		}

			.btn-primary:hover {
				background: #34495e;
				border-color: #34495e;
			}

		.btn-secondary {
			background: #95a5a6;
			color: white;
			border-color: #95a5a6;
		}

			.btn-secondary:hover {
				background: #7f8c8d;
				border-color: #7f8c8d;
			}

		.btn-success {
			background: #27ae60;
			color: white;
			border-color: #27ae60;
		}

			.btn-success:hover {
				background: #229954;
				border-color: #229954;
			}

		/* Şartlar Bölümü */
		.terms-section {
			background: #f8f9fa;
			padding: 20px;
			border: 1px solid #e0e6ed;
			border-radius: 4px;
			border-left: 4px solid #e74c3c;
		}

		.terms-title {
			font-weight: 600;
			margin-bottom: 15px;
			color: #2c3e50;
			font-size: 1rem;
		}

		.terms-list {
			list-style: none;
			padding: 0;
		}

			.terms-list li {
				margin: 8px 0;
				padding-left: 20px;
				position: relative;
				color: #34495e;
				font-size: 0.9rem;
			}

				.terms-list li:before {
					content: "•";
					color: #e74c3c;
					position: absolute;
					left: 0;
					font-weight: bold;
				}

		/* Responsive */
		@@media (max-width: 1200px) {
			.form-row {
				grid-template-columns: repeat(3, 1fr);
			}
		}

		@@media (max-width: 768px) {
			.form-row {
				grid-template-columns: repeat(2, 1fr);
				gap: 15px;
			}

			.form-actions {
				flex-direction: column;
			}

			.company-info {
				flex-direction: column;
				align-items: flex-start;
				gap: 10px;
			}
		}

		@@media (max-width: 480px) {
			.form-row {
				grid-template-columns: 1fr;
			}
		}
	</style>
</head>

<div class="main-content mt-5">
	<div class="px-lg-5 px-3">
		<!-- Breadcrumb -->
		<nav class="breadcrumb-custom">
