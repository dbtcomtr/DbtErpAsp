					<div class="section-body">
						<div class="form-row">
							<div class="form-group">
								<label>Firma / Kurum</label>
								<select id="company" name="company" required>
									<option value="">Firma Seçiniz</option>
									<option value="TOSÇELİK" selected>TOSÇELİK</option>
									<option value="ABC Ltd. Şti.">ABC Ltd. Şti.</option>
									<option value="XYZ A.Ş.">XYZ A.Ş.</option>
									<option value="DEF İnşaat">DEF İnşaat</option>
									<option value="GHI Teknoloji">GHI Teknoloji</option>
									<option value="Diğer">Diğer</option>
								</select>
							</div>
							<div class="form-group">
								<label>Tarih</label>
								<input type="date" id="date" name="date" value="2025-08-04" required>
							</div>
							<div class="form-group">
								<label>Form No</label>
								<input type="text" id="formNo" name="formNo" value="250715" required>
							</div>
							<div class="form-group">
								<label>Hazırlayan</label>
								<input type="text" id="preparedBy" name="preparedBy" value="GÜRKAN BERBER" required>
							</div>
						</div>

						<div class="form-row">
							<div class="form-group">
								<label>Yetkili</label>
								<input type="text" id="contact" name="contact" value="YEŞİM HANIM'IN DİKKATİNE !" required>
							</div>
							<div class="form-group">
								<label>Konu</label>
								<input type="text" id="subject" name="subject" value="OFİS MOBİLYALARI FİYAT TEKLİFİ" required>
							</div>
							<div class="form-group">
								<label>Geçerlilik Süresi</label>
								<select name="validity">
									<option value="7" selected>7 İş Günü</option>
									<option value="14">14 İş Günü</option>
									<option value="30">30 Gün</option>
								</select>
							</div>
							<div class="form-group">
								<label>Durum</label>
								<select name="status">
									<option value="hazırlanıyor" selected>Hazırlanıyor</option>
									<option value="gönderildi">Gönderildi</option>
									<option value="onaylandı">Onaylandı</option>
									<option value="reddedildi">Reddedildi</option>
								</select>
							</div>
						</div>
					</div>
				</div>

				<!-- Ürün Listesi -->
