		<!-- Cari Seçim Modal -->
		<div id="cariModal" class="modal">
			<div class="modal-content">
				<div class="modal-header">
					<h4 class="modal-title">Firma / Kurum Seçin</h4>
					<span class="close" onclick="closeCariModal()">&times;</span>
				</div>
				<div class="modal-body">
					<input type="text" class="search-input" placeholder="Firma adı ile arayın..." onkeyup="searchCari()" id="cariSearchInput">
					<div class="table-responsive">
						<table class="table table-striped" id="cariTable">
							<thead>
								<tr>
									<th>Kod</th>
									<th>Firma Adı</th>
									<th>Email</th>
									<th>Telefon</th>
								</tr>
							</thead>
							<tbody id="cariTableBody">
								@foreach (var cari in Model.CariHesaplar)
								{
									<tr class="select-row" onclick="selectCari('@cari.CariKod', '@cari.CariAdi')">
										<td>@cari.CariKod</td>
										<td>@cari.CariAdi @(cari.IsAdayCari ? "(Aday)" : "")</td>
										<td>@cari.Email</td>
										<td>@cari.Telefon</td>
