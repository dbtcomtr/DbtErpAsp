<!-- ============================================ -->
<!-- JAVASCRIPT - <script> TAG İÇİNE EKLENECEK -->
<!-- ============================================ -->
<script>
	// Global değişkenler
	let currentTeklifData = null;
	let allMikroStoklar = [];
	let currentEditingRow = null;

	// Modal açma fonksiyonu
	function openSiparisDonusturModal() {
		if (!currentTeklifNo) {
			alert('Lütfen önce bir teklif seçin.');
			return;
		}

		// Teklif verilerini yükle
		loadTeklifForSiparis(currentTeklifNo);
	}

			function loadTeklifForSiparis(teklifNo) {
		console.log('loadTeklifForSiparis çağrıldı, TeklifNo:', teklifNo);

		$.ajax({
			url: `/crm/GetTeklifForSiparis/${teklifNo}`,
			method: 'GET',
			success: function(data) {
				console.log('Backend\'den gelen veri:', data);

				if (!data) {
					alert('Teklif verileri alınamadı.');
					return;
				}

				// ✅ ÇÖZÜM: Hem PascalCase hem camelCase kontrolü
				const urunler = data.Urunler || data.urunler;

				if (!urunler || !Array.isArray(urunler)) {
					console.warn('Urunler bulunamadı:', data);
					alert('Bu teklifte ürün bulunmuyor.');
					return;
				}

				if (urunler.length === 0) {
					alert('Bu teklifte ürün bulunmuyor.');
					return;
				}

				// ✅ Data objesini normalize et - HEM PascalCase HEM camelCase desteği
				currentTeklifData = {
					TeklifNo: data.teklifNo || data.TeklifNo,
					MusteriAdi: data.musteriAdi || data.MusteriAdi,
					MusteriKod: data.musteriKod || data.MusteriKod,
					Urunler: urunler.map(u => ({
						TeklifStokKod: u.teklifStokKod || u.TeklifStokKod || '-',
						StokAdi: u.stokAdi || u.StokAdi || 'Bilinmeyen Ürün',
						SiparisMiktar: u.siparisMiktar || u.SiparisMiktar || 0,
						BirimPntr: u.birimPntr || u.BirimPntr || 1,
						MikrodaVarMi: u.mikrodaVarMi || u.MikrodaVarMi || false,
						MikroStokKod: u.mikroStokKod || u.MikroStokKod || null,
						EldekiMiktar: u.eldekiMiktar || u.EldekiMiktar || 0,
						SatinAlmaTalep: u.satinAlmaTalep || u.SatinAlmaTalep || 0
					}))
				};

				console.log('Normalize edilmiş data:', currentTeklifData);
				renderSiparisModal(currentTeklifData);

				document.getElementById('siparisDonusturModal').style.display = 'flex';
			},
			error: function(xhr, status, error) {
				console.error('Teklif yükleme hatası:', error);
				console.error('XHR Status:', xhr.status);
				console.error('Response Text:', xhr.responseText);
				alert('Teklif verileri yüklenirken bir hata oluştu: ' + error);
			}
		});
	}

	// renderSiparisModal fonksiyonu aynı kalabilir (zaten normalize edilmiş data alıyor)
	function renderSiparisModal(data) {
		console.log('renderSiparisModal çağrıldı, data:', data);

		if (!data) {
			console.error('renderSiparisModal: data null');
			return;
		}

		document.getElementById('modalTeklifNo').textContent = data.TeklifNo || '-';
		document.getElementById('modalMusteriAdi').textContent = data.MusteriAdi || '-';

		const tbody = document.getElementById('siparisTableBody');

		if (!tbody) {
			console.error('siparisTableBody elementi bulunamadı!');
			return;
		}

		tbody.innerHTML = '';

		if (!data.Urunler || !Array.isArray(data.Urunler) || data.Urunler.length === 0) {
			tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:20px;">Bu teklifte ürün bulunmuyor.</td></tr>';
			return;
		}

		console.log('Ürün sayısı:', data.Urunler.length);

		data.Urunler.forEach((urun, index) => {
			console.log(`Ürün ${index}:`, urun);

			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td>
					<strong>${urun.StokAdi || '-'}</strong>
					${urun.TeklifStokKod ? `<br><small style="color: #6c757d;">Teklif Kodu: ${urun.TeklifStokKod}</small>` : ''}
				</td>
				<td>
					<span class="status-badge-modal ${urun.MikrodaVarMi ? 'var' : 'yok'}">
						<i class="fas fa-${urun.MikrodaVarMi ? 'check-circle' : 'times-circle'}"></i>
						${urun.MikrodaVarMi ? 'Var' : 'Yok'}
					</span>
				</td>
				<td>
					<div class="mikro-kod-cell">
						<span class="mikro-kod-text" id="mikroKod_${index}">${urun.MikroStokKod || '-'}</span>
						<button class="degistir-btn" onclick="openStokSecimModal(${index})" ${!urun.MikrodaVarMi ? 'disabled' : ''}>
							<i class="fas fa-exchange-alt"></i> Değiştir
						</button>
					</div>
				</td>
				<td>
					<input type="number"
						   class="miktar-input eldeki"
						   id="eldekiMiktar_${index}"
						   value="${urun.EldekiMiktar || 0}"
						   readonly>
				</td>
				<td>
					<input type="number"
						   class="miktar-input siparis"
						   id="siparisMiktar_${index}"
						   value="${urun.SiparisMiktar || 0}"
						   onchange="calculateTalep(${index})">
				</td>
				<td>
					<input type="number"
						   class="miktar-input talep"
						   id="talepMiktar_${index}"
						   value="${urun.SatinAlmaTalep || 0}"
						   min="0">
				</td>
			`;
			tbody.appendChild(tr);
		});

		console.log('Modal render tamamlandı');
	}


	// Satın alma talebi hesaplama
	function calculateTalep(index) {
		const eldeki = parseFloat(document.getElementById(`eldekiMiktar_${index}`).value) || 0;
		const siparis = parseFloat(document.getElementById(`siparisMiktar_${index}`).value) || 0;

		const talep = Math.max(0, siparis - eldeki);
		document.getElementById(`talepMiktar_${index}`).value = talep;
	}

	// Stok seçim modalını açma
	function openStokSecimModal(rowIndex) {
		currentEditingRow = rowIndex;

		// Mikro stokları yükle
		$.ajax({
			url: '/crm/GetMikroStoklar',
			method: 'GET',
			success: function(data) {
				allMikroStoklar = data;
				renderStokList(data);
				document.getElementById('stokSecimModal').style.display = 'flex';
			},
			error: function(xhr, status, error) {
				console.error('Stok listesi yükleme hatası:', error);
				alert('Stok listesi yüklenirken bir hata oluştu.');
			}
		});
	}

	// Stok listesini render etme
	function renderStokList(stoklar) {
		const container = document.getElementById('stokListContainer');
		container.innerHTML = '';

		stoklar.forEach(stok => {
			const div = document.createElement('div');
			div.className = 'stok-item';
			div.onclick = () => selectStok(stok);
			div.innerHTML = `
				<div class="stok-item-info">
					<div class="stok-item-kod">${stok.StokKod}</div>
					<div class="stok-item-ad">${stok.StokAdi}</div>
				</div>
				<i class="fas fa-chevron-right stok-item-icon"></i>
			`;
			container.appendChild(div);
		});
	}

	// Stok filtreleme
	function filterStoklar() {
		const searchTerm = document.getElementById('stokSearchInput').value.toLowerCase();
		const filtered = allMikroStoklar.filter(stok =>
			stok.StokKod.toLowerCase().includes(searchTerm) ||
			stok.StokAdi.toLowerCase().includes(searchTerm)
		);
		renderStokList(filtered);
	}

	// Stok seçme
	function selectStok(stok) {
		if (currentEditingRow === null) return;

		// Mikro kodu güncelle
		document.getElementById(`mikroKod_${currentEditingRow}`).textContent = stok.StokKod;

		// Ürün verisini güncelle
		currentTeklifData.Urunler[currentEditingRow].MikroStokKod = stok.StokKod;
		currentTeklifData.Urunler[currentEditingRow].MikrodaVarMi = true;

		// Eldeki miktarı güncelle
		getEldekiMiktar(stok.StokKod, currentEditingRow);

		// Modalı kapat
		closeStokSecimModal();
	}

	// Eldeki miktarı getirme
	function getEldekiMiktar(stokKod, rowIndex) {
		$.ajax({
			url: '/crm/GetEldekiMiktar',
			method: 'GET',
			data: { stokKod: stokKod },
			success: function(miktar) {
				document.getElementById(`eldekiMiktar_${rowIndex}`).value = miktar;
				calculateTalep(rowIndex);
			},
			error: function() {
				console.error('Eldeki miktar alınamadı');
			}
		});
	}

	// Stok seçim modalını kapatma
	function closeStokSecimModal() {
		document.getElementById('stokSecimModal').style.display = 'none';
		currentEditingRow = null;
	}

	// Ana modalı kapatma
	function closeSiparisDonusturModal() {
		document.getElementById('siparisDonusturModal').style.display = 'none';
		currentTeklifData = null;
	}

	// Siparişe kaydetme
	function sipariseKaydet() {
		if (!currentTeklifData) {
			alert('Teklif verisi bulunamadı.');
			return;
		}

		// Güncellenmiş verileri topla
		const siparisData = {
			TeklifNo: currentTeklifData.TeklifNo,
			Urunler: []
		};

		currentTeklifData.Urunler.forEach((urun, index) => {
			siparisData.Urunler.push({
				MikroStokKod: document.getElementById(`mikroKod_${index}`).textContent,
				SiparisMiktar: parseFloat(document.getElementById(`siparisMiktar_${index}`).value) || 0,
				SatinAlmaTalep: parseFloat(document.getElementById(`talepMiktar_${index}`).value) || 0,
				TeklifStokKod: urun.TeklifStokKod
			});
		});

		// Ajax ile kaydet
		$.ajax({
			url: '/crm/TekliftenSiparisOlustur',
			method: 'POST',
			contentType: 'application/json',
			data: JSON.stringify(siparisData),
			success: function(response) {
				if (response.success) {
					showStatusMessage('Sipariş başarıyla oluşturuldu!', 'success');
					closeSiparisDonusturModal();

					// Teklif durumunu güncelle
					updateTeklifStatus(currentTeklifNo, 'Kazanıldı');
				} else {
					showStatusMessage(response.message || 'Sipariş oluşturulurken bir hata oluştu.', 'error');
				}
			},
			error: function(xhr, status, error) {
				console.error('Sipariş kaydetme hatası:', error);
				showStatusMessage('Sipariş oluşturulurken bir hata oluştu.', 'error');
			}
		});
	}

	// executeConvert fonksiyonunu güncelle
	function executeConvert() {
		const convertType = document.getElementById('convertTypeDropdown').value;

		if (!convertType) {
			alert('Lütfen dönüştürme tipi seçin.');
			return;
		}

		if (convertType === 'siparis') {
			openSiparisDonusturModal();
		} else if (convertType === 'proforma') {
			// Proforma işlemi burada yapılacak
			alert('Proforma dönüştürme özelliği henüz eklenmedi.');
		}
	}
</script>
