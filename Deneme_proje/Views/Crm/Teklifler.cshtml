            const printBtn = document.getElementById('btnPrint');

            console.log('Edit Button:', editBtn);
            console.log('Edit Button onclick:', editBtn ? editBtn.onclick : 'Bulunamadı');
            console.log('Print Button:', printBtn);
            console.log('Print Button onclick:', printBtn ? printBtn.onclick : 'Bulunamadı');

            console.log('currentTeklifNo:', currentTeklifNo);
        },

        testRoute: function(teklifNo) {
            console.log('=== ROUTE TEST ===');
            const testUrl = `/crm/teklifduzenle/${teklifNo}`;
            console.log('Test URL:', testUrl);

            $.ajax({
                url: testUrl,
                method: 'GET',
                success: function(response) {
                    console.log('Route başarılı - Response alındı');
                    console.log('Response tipi:', typeof response);
                },
                error: function(xhr, status, error) {
                    console.error('Route hatası:');
                    console.error('Status:', status);
                    console.error('Error:', error);
                    console.error('ResponseText:', xhr.responseText);
                }
            });
        },

        runAll: function() {
            this.checkGlobals();
            this.checkTableData();
            this.checkPipelineData();
            this.testSidebarButtons();
        }
    };
</script>