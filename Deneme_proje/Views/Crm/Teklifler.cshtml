<!-- Status Message -->
<div id="statusMessage" class="status-message"></div>

@functions {
	string GetStatusClass(string durum)
	{
		return durum switch
		{
			"Taslak" or "" or null => "taslak",
			"Gönderildi" => "gonderildi",
			"Kazanıldı" => "kazanildi",
			"Kaybedildi" => "kaybedildi",
			"Ertelendi" => "ertelendi",
			"İptal Edildi" => "iptal",
			_ => "taslak"
		};
	}
}

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap4.min.js"></script>
<script>
		$(document).ready(function() {
		$('#teklifTable').DataTable({
			"language": {
				"url": "//cdn.datatables.net/plug-ins/1.11.5/i18n/tr.json"
			},
			"order": [[4, "desc"]],
			"pageLength": 25,
			"columnDefs": [
				{ "orderable": false, "targets": 6 }
			]
		});

		closeSidebar();
	});

	// Tab Switching
	function switchTab(tab) {
		document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
		document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

		event.target.classList.add('active');
		document.getElementById(tab + '-content').classList.add('active');
	}

	// Sidebar Controls
	function updateConvertButton() {
		const statusDropdown = document.getElementById('statusDropdown');
		const convertBtn = document.getElementById('convertBtn');

		if (statusDropdown.value && currentTeklifNo) {
			convertBtn.disabled = false;
			convertBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Güncelle';
		} else {
			convertBtn.disabled = true;
			convertBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Güncelle';
		}

		statusDropdown.className = 'status-dropdown ' + (statusDropdown.value || '');
	}

	function convertTeklif() {
		if (!currentTeklifNo || !document.getElementById('statusDropdown').value) {
			showStatusMessage('Lütfen bir durum seçin', 'error');
			return;
		}

		const yeniDurum = document.getElementById('statusDropdown').value;
		const teklifNo = currentTeklifNo;

		const durumMapping = {
			'taslak': 'Taslak',
			'gonderildi': 'Gönderildi',
			'kazanildi': 'Kazanıldı',
			'kaybedildi': 'Kaybedildi',
			'ertelendi': 'Ertelendi',
			'iptal': 'İptal Edildi'
		};

		const yeniDurumText = durumMapping[yeniDurum] || yeniDurum;

		if (!confirm(`Teklif durumunu "${yeniDurumText}" olarak güncellemek istediğinizden emin misiniz?`)) {
			return;
		}

		const convertBtn = document.getElementById('convertBtn');
		const originalText = convertBtn.innerHTML;
		convertBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Güncelleniyor...';
		convertBtn.disabled = true;

		$.ajax({
			url: '/crm/TeklifDurumGuncelle',
			method: 'POST',
			contentType: 'application/json',
			data: JSON.stringify({
				teklifId: teklifNo,
				yeniDurum: yeniDurumText
			}),
			success: function(response) {
				if (response.success) {
					showStatusMessage('Teklif durumu başarıyla güncellendi', 'success');

					// UI'yi dinamik olarak güncelle
					updateUIAfterStatusChange(teklifNo, yeniDurumText);

					// Sidebar'daki durum bilgisini güncelle
					document.getElementById('detail-durum').innerHTML =
						`<span class="status-badge status-${getStatusClass(yeniDurumText)}">${yeniDurumText}</span>`;

					// Dropdown'ı temizle
					document.getElementById('statusDropdown').value = '';
					updateConvertButton();

				} else {
					showStatusMessage('Hata: ' + response.message, 'error');
				}
			},
			error: function() {
				showStatusMessage('Durum güncellenirken bir hata oluştu', 'error');
			},
			complete: function() {
				convertBtn.innerHTML = originalText;
				convertBtn.disabled = false;
			}
		});
	}

	function executeConvert() {
		const convertType = document.getElementById('convertTypeDropdown').value;

		if (!convertType || !currentTeklifNo) {
			showStatusMessage('Lütfen dönüştürme türünü seçin', 'error');
			return;
		}

		const convertText = convertType === 'proforma' ? 'Proformaya' : 'Siparişe';

		if (!confirm(`Bu teklifi ${convertText.toLowerCase()} dönüştürmek istediğinizden emin misiniz?`)) {
			return;
		}

		const convertBtn = document.getElementById('executeConvertBtn');
		const originalText = convertBtn.innerHTML;
		convertBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Dönüştürülüyor...';
		convertBtn.disabled = true;

		$.ajax({
			url: '/crm/TeklifDonustur',
			method: 'POST',
			contentType: 'application/json',
			data: JSON.stringify({
				teklifId: currentTeklifNo,
				donusturTuru: convertType
			}),
			success: function(response) {
				if (response.success) {
					showStatusMessage(`Teklif başarıyla ${convertText.toLowerCase()} dönüştürüldü`, 'success');
					showConversionSuccess(convertType, response.yeniEvrakId);
					document.getElementById('convertTypeDropdown').value = '';
				} else {
					showStatusMessage('Hata: ' + response.message, 'error');
				}
			},
			error: function() {
				showStatusMessage('Dönüştürme işleminde bir hata oluştu', 'error');
			},
			complete: function() {
				convertBtn.innerHTML = originalText;
				convertBtn.disabled = false;
			}
		});
	}

	function showConversionSuccess(convertType, yeniEvrakId) {
		const convertText = convertType === 'proforma' ? 'Proforma' : 'Sipariş';
		const targetPage = convertType === 'proforma' ? 'proforma' : 'siparis';

		const dialog = document.createElement('div');
		dialog.className = 'conversion-success-dialog';
		dialog.innerHTML = `
			<div class="dialog-content">
				<div class="dialog-header">
					<i class="fas fa-check-circle" style="color: #28a745;"></i>
					<h4>Dönüştürme Başarılı!</h4>
				</div>
				<div class="dialog-body">
					<p>${convertText} başarıyla oluşturuldu.</p>
					<p><strong>Belge No:</strong> ${yeniEvrakId}</p>
				</div>
				<div class="dialog-actions">
					<button class="btn-secondary" onclick="closeConversionDialog()">Kapat</button>
					<button class="btn-primary" onclick="openNewDocument('/${targetPage}/${yeniEvrakId}')">
						<i class="fas fa-external-link-alt"></i> Belgeyi Görüntüle
					</button>
				</div>
			</div>
		`;

		if (!document.getElementById('conversion-dialog-styles')) {
			const styles = document.createElement('style');
			styles.id = 'conversion-dialog-styles';
			styles.textContent = `
				.conversion-success-dialog {
					position: fixed;
					top: 0;
					left: 0;
					right: 0;
					bottom: 0;
					background: rgba(0,0,0,0.5);
					display: flex;
					align-items: center;
					justify-content: center;
					z-index: 10000;
					animation: fadeIn 0.3s ease;
				}

				.dialog-content {
					background: white;
					border-radius: 12px;
					padding: 0;
					max-width: 400px;
					width: 90%;
					box-shadow: 0 10px 40px rgba(0,0,0,0.2);
					animation: slideUp 0.3s ease;
				}

				.dialog-header {
					padding: 20px;
					border-bottom: 1px solid #e9ecef;
					text-align: center;
				}

				.dialog-header i {
					font-size: 2rem;
					margin-bottom: 10px;
				}

				.dialog-header h4 {
					margin: 0;
					color: #333;
				}

				.dialog-body {
					padding: 20px;
					text-align: center;
				}

				.dialog-actions {
					padding: 15px 20px;
					border-top: 1px solid #e9ecef;
					display: flex;
					gap: 10px;
					justify-content: flex-end;
				}

				.btn-secondary, .btn-primary {
					padding: 8px 16px;
					border: none;
					border-radius: 6px;
					cursor: pointer;
					font-size: 0.9rem;
					display: flex;
					align-items: center;
					gap: 5px;
				}

				.btn-secondary {
					background: #6c757d;
					color: white;
				}

				.btn-primary {
					background: #007bff;
					color: white;
				}

				@@keyframes fadeIn {
					from { opacity: 0; }
					to { opacity: 1; }
				}

				@@keyframes slideUp {
					from { transform: translateY(30px); opacity: 0; }
					to { transform: translateY(0); opacity: 1; }
				}
			`;
			document.head.appendChild(styles);
		}

		document.body.appendChild(dialog);
	}

	function closeConversionDialog() {
		const dialog = document.querySelector('.conversion-success-dialog');
		if (dialog) {
			dialog.remove();
		}
	}

	function openNewDocument(url) {
		window.open(url, '_blank');
		closeConversionDialog();
	}

	function handleOtherAction() {
		const action = document.getElementById('otherActions').value;

		if (!action || !currentTeklifNo) return;

		switch(action) {
			case 'pdf':
				window.open(`/crm/teklifyazdir/${currentTeklifNo}?format=pdf`, '_blank');
				break;
			case 'print':
				window.open(`/crm/teklifyazdir/${currentTeklifNo}`, '_blank');
				break;
			case 'copy':
				window.location.href = `/crm/fiyatteklif?copy=${currentTeklifNo}`;
				break;
			case 'delete':
				if (confirm('Bu teklifi silmek istediğinizden emin misiniz?')) {
					deleteTeklif(currentTeklifNo);
				}
				break;
		}

		document.getElementById('otherActions').value = '';
	}

	function deleteTeklif(teklifNo) {
		$.ajax({
			url: `/crm/teklif/${teklifNo}`,
			method: 'DELETE',
			success: function(response) {
				if (response.success) {
					showStatusMessage('Teklif başarıyla silindi', 'success');
					setTimeout(() => {
						location.reload();
					}, 1500);
				} else {
					showStatusMessage('Hata: ' + response.message, 'error');
				}
			},
			error: function() {
				showStatusMessage('Teklif silinirken bir hata oluştu', 'error');
			}
		});
	}

	// Drag and Drop Functions
	function allowDrop(ev) {
		ev.preventDefault();

		const column = ev.currentTarget.closest('.pipeline-column');
		if (!column.classList.contains('drag-over')) {
			column.classList.add('drag-over');
		}
	}

	function dragLeave(ev) {
		const column = ev.currentTarget.closest('.pipeline-column');
		if (!column.contains(ev.relatedTarget)) {
			column.classList.remove('drag-over');
		}
	}

	function drag(ev) {
		draggedElement = ev.target;
		ev.target.classList.add('dragging');
		ev.dataTransfer.setData("text", ev.target.getAttribute('data-teklif-id'));
		ev.dataTransfer.effectAllowed = "move";
	}

	function drop(ev) {
		ev.preventDefault();

		document.querySelectorAll('.pipeline-column').forEach(col => {
			col.classList.remove('drag-over');
		});

		const data = ev.dataTransfer.getData("text");
		const draggedCard = document.querySelector(`[data-teklif-id="${data}"]`);
		const targetColumn = ev.currentTarget.closest('.pipeline-column');
		const newStatus = targetColumn.getAttribute('data-status');
		const oldStatus = draggedCard.getAttribute('data-status');

		if (newStatus === oldStatus) {
			draggedCard.classList.remove('dragging');
			return;
		}

		draggedCard.classList.add('updating');

		updateTeklifStatusDragDrop(data, newStatus, draggedCard, targetColumn);
	}

	function updateTeklifStatusDragDrop(teklifId, yeniDurum, cardElement, targetColumn) {
		$.ajax({
			url: '/crm/TeklifDurumGuncelle',
			method: 'POST',
			contentType: 'application/json',
			data: JSON.stringify({
				teklifId: teklifId,
				yeniDurum: yeniDurum
			}),
			success: function(response) {
				if (response.success) {
					targetColumn.querySelector('.column-body').appendChild(cardElement);
					cardElement.setAttribute('data-status', yeniDurum);
					cardElement.classList.remove('dragging', 'updating');
					updateColumnCounts();
					showStatusMessage('Teklif durumu güncellendi', 'success');
				} else {
					cardElement.classList.remove('dragging', 'updating');
					showStatusMessage('Hata: ' + response.message, 'error');
				}
			},
			error: function() {
				cardElement.classList.remove('dragging', 'updating');
				showStatusMessage('Durum güncellenirken bir hata oluştu', 'error');
			}
		});
	}

	function updateColumnCounts() {
		document.querySelectorAll('.pipeline-column').forEach(column => {
			const count = column.querySelectorAll('.quote-card').length;
			const countElement = column.querySelector('.column-count');
			if (countElement) {
				// Sayı değişikliği animasyonu
				countElement.style.transform = 'scale(1.3)';
				countElement.style.backgroundColor = 'rgba(255,255,255,0.8)';
				countElement.textContent = count;

				setTimeout(() => {
					countElement.style.transform = '';
					countElement.style.backgroundColor = 'rgba(255,255,255,0.3)';
				}, 300);
			}
		});
	}

	document.addEventListener('dragend', function(e) {
		if (e.target.classList.contains('quote-card')) {
			e.target.classList.remove('dragging');
			document.querySelectorAll('.pipeline-column').forEach(col => {
				col.classList.remove('drag-over');
			});
		}
	});

	// Show Detail Function
	function showDetail(no, firma, konu, tutar, tarih, durum) {
		currentTeklifNo = no;
		currentTeklifStatus = durum;

		console.log('showDetail çağrıldı - TeklifNo:', no, 'Durum:', durum);

		document.querySelectorAll('.data-table tbody tr, .quote-card').forEach(el => {
			el.classList.remove('selected');
		});
		event.currentTarget.classList.add('selected');

		const sidebar = document.getElementById('sidebar');
		sidebar.style.display = 'block';
		sidebar.classList.add('open');

		document.getElementById('mainContainer').classList.add('sidebar-open');

		document.getElementById('detail-no').textContent = no;
		document.getElementById('detail-firma').textContent = firma;
		document.getElementById('detail-konu').textContent = konu;
		document.getElementById('detail-durum').innerHTML = `<span class="status-badge status-${getStatusClass(durum)}">${durum}</span>`;
		document.getElementById('detail-tutar').textContent = tutar;
		document.getElementById('detail-tarih').textContent = tarih;

		const tutarSayi = parseFloat(tutar.replace(/[^\d,]/g, '').replace(',', '.')) || 0;

		const toplam = tutarSayi ;


		document.getElementById('detail-toplam').textContent = formatCurrency(toplam);

		setupSidebarControls(durum);

		  $.ajax({
		url: `/crm/teklifdetay/${no}`,
		method: 'GET',
		success: function(response) {
			if (response.success && response.data && response.data.length > 0) {
				let satirlarHtml = '<div class="detail-urunler-list">';
				let toplamTutar = 0;

				response.data.forEach(satir => {
					// ✅ DÜZELTME: Teklif fiyatı ile toplam hesapla
					const satirToplam = satir.miktar * satir.indirimliFiyat;
					toplamTutar += satirToplam;

					satirlarHtml += `
						<div class="detail-urun">
							${satir.imageData
								? `<img src="data:image/jpeg;base64,${satir.imageData}" class="detail-urun-image" alt="${satir.stokAdi}">`
								: `<div class="detail-urun-no-image">Fotoğraf Yok</div>`}
							<div>
								<span class="detail-urun-label">${satir.stokAdi || 'Bilinmeyen Ürün'}</span>
								<span class="detail-urun-value">
									Miktar: ${satir.miktar}<br>
									Liste Fiyat: ${formatCurrency(satir.birimFiyat)}<br>
									Teklif Fiyat: ${formatCurrency(satir.indirimliFiyat)}<br>
									<strong>Toplam: ${formatCurrency(satirToplam)}</strong>
									${satir.aciklama ? '<br><small>' + satir.aciklama + '</small>' : ''}
								</span>
							</div>
						</div>`;
				});
				satirlarHtml += '</div>';
				document.getElementById('detail-satirlar').innerHTML = satirlarHtml;

				// ✅ Genel toplamı güncelle
				document.getElementById('detail-toplam').textContent = formatCurrency(toplamTutar);
			} else {
				document.getElementById('detail-satirlar').innerHTML = '<div class="detail-urun">Satır bulunamadı.</div>';
			}
		},
		error: function() {
			document.getElementById('detail-satirlar').innerHTML = '<div class="detail-urun">Satır bilgileri yüklenirken hata oluştu.</div>';
		}
	});


		document.getElementById('btnEdit').onclick = () => editTeklif(no);
		document.getElementById('btnPrint').onclick = () => printTeklif(no);
	}

	function setupSidebarControls(durum) {
		const normalControls = document.getElementById('normalControls');
		const convertControls = document.getElementById('convertControls');
		const statusDropdown = document.getElementById('statusDropdown');
		const convertTypeDropdown = document.getElementById('convertTypeDropdown');

		// Animasyonlu geçiş
		if (durum === 'Kazanıldı') {
			normalControls.style.opacity = '0';
			setTimeout(() => {
				normalControls.style.display = 'none';
				convertControls.style.display = 'flex';
				convertControls.style.opacity = '0';
				setTimeout(() => {
					convertControls.style.opacity = '1';
				}, 50);
			}, 150);
			convertTypeDropdown.value = '';
		} else {
			convertControls.style.opacity = '0';
			setTimeout(() => {
				convertControls.style.display = 'none';
				normalControls.style.display = 'flex';
				normalControls.style.opacity = '0';
				setTimeout(() => {
					normalControls.style.opacity = '1';
				}, 50);
			}, 150);
			statusDropdown.value = '';
			updateConvertButton();
		}
	}
	function updateMetrics(yeniDurum, eskiDurum) {
		// Eski durumdan çıkar
		if (eskiDurum && eskiDurum !== yeniDurum) {
			decrementMetric(eskiDurum);
		}

		// Yeni duruma ekle
		incrementMetric(yeniDurum);

		// Animasyon efekti
		const metrics = document.querySelectorAll('.metric');
		metrics.forEach(metric => {
			metric.style.transform = 'scale(1.05)';
			metric.style.transition = 'transform 0.2s ease';
			setTimeout(() => {
				metric.style.transform = '';
			}, 200);
		});
	}

	function incrementMetric(durum) {
		const metricSelectors = {
			'Taslak': '.metric:nth-child(2) .metric-value',
			'Gönderildi': '.metric:nth-child(3) .metric-value',
			'Kazanıldı': '.metric:nth-child(4) .metric-value',
			'Kaybedildi': '.metric:nth-child(5) .metric-value',
			'Ertelendi': '.metric:nth-child(6) .metric-value'
		};

		const selector = metricSelectors[durum];
		if (selector) {
			const element = document.querySelector(selector);
			if (element) {
				const currentValue = parseInt(element.textContent);
				element.textContent = currentValue + 1;

				// Artış animasyonu
				element.style.color = '#28a745';
				element.style.transform = 'scale(1.2)';
				setTimeout(() => {
					element.style.color = '';
					element.style.transform = '';
				}, 500);
			}
		}
	}

	function decrementMetric(durum) {
		const metricSelectors = {
			'Taslak': '.metric:nth-child(2) .metric-value',
			'Gönderildi': '.metric:nth-child(3) .metric-value',
			'Kazanıldı': '.metric:nth-child(4) .metric-value',
			'Kaybedildi': '.metric:nth-child(5) .metric-value',
			'Ertelendi': '.metric:nth-child(6) .metric-value'
		};

		const selector = metricSelectors[durum];
		if (selector) {
			const element = document.querySelector(selector);
			if (element) {
				const currentValue = parseInt(element.textContent);
				if (currentValue > 0) {
					element.textContent = currentValue - 1;

					// Azalış animasyonu
					element.style.color = '#dc3545';
					element.style.transform = 'scale(0.8)';
					setTimeout(() => {
						element.style.color = '';
						element.style.transform = '';
					}, 500);
				}
			}
		}
	}

	function updateUIAfterStatusChange(teklifNo, yeniDurum) {
		const eskiDurum = currentTeklifStatus;

		// Liste görünümünde güncelle
		const listRow = document.querySelector(`tr[onclick*="${teklifNo}"]`);
		if (listRow) {
			const statusCell = listRow.querySelector('.status-badge');
			if (statusCell) {
				statusCell.className = `status-badge status-${getStatusClass(yeniDurum)}`;
				statusCell.textContent = yeniDurum;
				listRow.style.backgroundColor = '#e8f5e8';
				setTimeout(() => {
					listRow.style.backgroundColor = '';
				}, 2000);
			}

			// onclick attributunu güncelle
			const onclick = listRow.getAttribute('onclick');
			const updatedOnclick = onclick.replace(
				new RegExp(`'${eskiDurum}'`),
				`'${yeniDurum}'`
			);
			listRow.setAttribute('onclick', updatedOnclick);
		}

		// Pipeline görünümünde güncelle
		const pipelineCard = document.querySelector(`[data-teklif-id="${teklifNo}"]`);
		if (pipelineCard) {
			const oldColumn = pipelineCard.closest('.pipeline-column');
			const newColumn = document.querySelector(`[data-status="${yeniDurum}"]`);

			if (newColumn && oldColumn !== newColumn) {
				// Kartı animasyonla taşı
				pipelineCard.style.transform = 'scale(0.9)';
				pipelineCard.style.opacity = '0.7';

				setTimeout(() => {
					const newColumnBody = newColumn.querySelector('.column-body');
					newColumnBody.appendChild(pipelineCard);
					pipelineCard.setAttribute('data-status', yeniDurum);

					// onclick attributunu güncelle
					const onclick = pipelineCard.getAttribute('onclick');
					if (onclick) {
						const updatedOnclick = onclick.replace(
							new RegExp(`'${eskiDurum}'`),
							`'${yeniDurum}'`
						);
						pipelineCard.setAttribute('onclick', updatedOnclick);
					}

					pipelineCard.style.transform = '';
					pipelineCard.style.opacity = '';
					pipelineCard.style.backgroundColor = '#e8f5e8';
					setTimeout(() => {
						pipelineCard.style.backgroundColor = '';
					}, 2000);
				}, 300);
			}
		}

		// Metrikleri güncelle
		updateMetrics(yeniDurum, eskiDurum);

		// Pipeline sütun sayılarını güncelle
		updateColumnCounts();

		// Sidebar kontrollerini yeniden düzenle
		setupSidebarControls(yeniDurum);

		// Global değişkeni güncelle
		currentTeklifStatus = yeniDurum;
	}

	function editTeklif(teklifNo) {
		console.log('editTeklif çağrıldı - TeklifNo:', teklifNo);
		if (!teklifNo || teklifNo === 'undefined' || teklifNo === 'null') {
			console.error('Geçersiz teklif numarası:', teklifNo);
			alert('Teklif numarası bulunamadı. Lütfen sayfayı yenileyin ve tekrar deneyin.');
			return;
		}

		window.location.href = `/crm/teklifduzenle/${String(teklifNo)}`;
	}

	function printTeklif(teklifNo) {
		console.log('printTeklif çağrıldı - TeklifNo:', teklifNo);
		if (!teklifNo) {
			alert('Teklif numarası bulunamadı');
			return;
		}
		window.open(`/crm/teklifyazdir/${teklifNo}`, '_blank');
	}

	function getStatusClass(durum) {
		switch (durum) {
			case 'Taslak': return 'taslak';
			case 'Gönderildi': return 'gonderildi';
			case 'Kazanıldı': return 'kazanildi';
			case 'Kaybedildi': return 'kaybedildi';
			case 'Ertelendi': return 'ertelendi';
			case 'İptal Edildi': return 'iptal';
			default: return 'taslak';
		}
	}

	function formatCurrency(amount) {
		return new Intl.NumberFormat('tr-TR', {
			style: 'currency',
			currency: 'TRY'
		}).format(amount || 0);
	}

	function showStatusMessage(message, type) {
		const messageEl = document.getElementById('statusMessage');
		messageEl.textContent = message;
		messageEl.className = `status-message ${type}`;
		messageEl.classList.add('show');

		const autoCloseTime = type === 'success' ? 3000 : 5000;

		setTimeout(() => {
			messageEl.classList.remove('show');
		}, autoCloseTime);
	}

	document.addEventListener('keydown', function(event) {
		if (event.key === 'Escape') {
			closeSidebar();
		}
	});

	document.addEventListener('click', function(event) {
		const sidebar = document.getElementById('sidebar');
		if (sidebar.classList.contains('open') &&
			!sidebar.contains(event.target) &&
			!event.target.closest('.data-table tbody tr') &&
			!event.target.closest('.quote-card')) {
			closeSidebar();
		}
	});

	function closeSidebar() {
		const sidebar = document.getElementById('sidebar');
		const mainContainer = document.getElementById('mainContainer');

		sidebar.classList.remove('open');
		mainContainer.classList.remove('sidebar-open');

		setTimeout(() => {
			if (!sidebar.classList.contains('open')) {
				sidebar.style.display = 'none';
			}
		}, 300);

		document.querySelectorAll('.data-table tbody tr, .quote-card').forEach(el => {
			el.classList.remove('selected');
		});

		currentTeklifNo = null;
		currentTeklifStatus = null;
	}

	let currentTeklifNo = null;
	let currentTeklifStatus = null;
	let draggedElement = null;

	window.debugTeklif = {
		checkGlobals: function() {
			console.log('=== GLOBAL DEĞİŞKENLER ===');
			console.log('currentTeklifNo:', currentTeklifNo);
			console.log('currentTeklifStatus:', currentTeklifStatus);
			console.log('draggedElement:', draggedElement);
		},

		checkTableData: function() {
			console.log('=== TABLO VERİLERİ ===');
			const rows = document.querySelectorAll('.data-table tbody tr');
			rows.forEach((row, index) => {
				const onclick = row.getAttribute('onclick');
				const teklifNo = row.querySelector('.teklif-no').textContent;
				console.log(`Satır ${index + 1}: TeklifNo=${teklifNo}, onclick=${onclick}`);
			});
		},

		checkPipelineData: function() {
			console.log('=== PİPELİNE VERİLERİ ===');
			const cards = document.querySelectorAll('.quote-card');
			cards.forEach((card, index) => {
				const teklifId = card.getAttribute('data-teklif-id');
				const onclick = card.getAttribute('onclick');
				console.log(`Kart ${index + 1}: TeklifId=${teklifId}, onclick=${onclick}`);
			});
		},

		testEdit: function(teklifNo) {
			console.log(`=== EDİT TEST: ${teklifNo} ===`);
			console.log('TeklifNo tipi:', typeof teklifNo);
			console.log('TeklifNo değeri:', teklifNo);

			if (teklifNo) {
				const url = `/crm/teklifduzenle/${teklifNo}`;
				console.log('Oluşturulan URL:', url);
				console.log('Test URL\'ini yeni sekmede açıyorum...');
				window.open(url, '_blank');
			} else {
				console.error('TeklifNo boş veya undefined!');
			}
		},

		testSidebarButtons: function() {
			console.log('=== SİDEBAR BUTTON TEST ===');
			const editBtn = document.getElementById('btnEdit');
			const printBtn = document.getElementById('btnPrint');

			console.log('Edit Button:', editBtn);
			console.log('Edit Button onclick:', editBtn ? editBtn.onclick : 'Bulunamadı');
			console.log('Print Button:', printBtn);
			console.log('Print Button onclick:', printBtn ? printBtn.onclick : 'Bulunamadı');

			console.log('currentTeklifNo:', currentTeklifNo);
		},

		testRoute: function(teklifNo) {
			console.log('=== ROUTE TEST ===');
			const testUrl = `/crm/teklifduzenle/${teklifNo}`;
			console.log('Test URL:', testUrl);

			$.ajax({
				url: testUrl,
				method: 'GET',
				success: function(response) {
					console.log('Route başarılı - Response alındı');
					console.log('Response tipi:', typeof response);
				},
				error: function(xhr, status, error) {
					console.error('Route hatası:');
					console.error('Status:', status);
					console.error('Error:', error);
					console.error('ResponseText:', xhr.responseText);
				}
			});
		},

		runAll: function() {
			this.checkGlobals();
			this.checkTableData();
			this.checkPipelineData();
			this.testSidebarButtons();
		}
	};
</script>

