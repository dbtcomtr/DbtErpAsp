@model IEnumerable<Deneme_proje.Models.SirketDurumuEntites.StokDepoListesi>
@{
    ViewData["Title"] = "Stok-Depo Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var selectedStokKodu = ViewBag.SelectedStokKodu?.ToString() ?? "";
    var selectedDepoNo = ViewBag.SelectedDepoNo?.ToString() ?? "";
}

<link href="~/content/assets/css/bahcepinar.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f8f9fa;
    }

    .page-title {
        color: #162e54;
        font-weight: 600;
        margin-bottom: 1.5rem;
        border-left: 4px solid #0076a8;
        padding-left: 15px;
    }

    .search-form {
        background: white;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border-radius: 0.5rem;
        padding: 20px;
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: #495057;
    }

    .form-control {
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        padding: 0.5rem 0.75rem;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #0076a8;
            box-shadow: 0 0 0 0.2rem rgba(0, 118, 168, 0.25);
        }

    .input-group {
        display: flex;
        width: 100%;
    }

    .input-group-append {
        display: flex;
    }

        .input-group-append .btn {
            border-radius: 0;
            margin: 0;
            white-space: nowrap;
            border: 1px solid #ced4da;
        }

            .input-group-append .btn:last-child {
                border-radius: 0 4px 4px 0;
            }

    .input-group .form-control {
        border-radius: 4px 0 0 4px;
    }

    .btn-outline-secondary {
        background-color: #f8f9fa;
        border-color: #ced4da;
        color: #495057;
    }

        .btn-outline-secondary:hover {
            background-color: #e9ecef;
            border-color: #ced4da;
            color: #495057;
        }

    .hidden-select {
        display: none;
    }

    .stok-arama-container {
        position: relative;
        width: 100%;
    }

    .select2-container--default .select2-selection--single {
        height: 38px !important;
        border: 1px solid #ced4da !important;
        border-radius: 0.25rem !important;
    }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px !important;
            font-size: 14px;
        }

    .select2-container--default.select2-container--focus .select2-selection--single {
        border-color: #0076a8 !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 118, 168, 0.25) !important;
    }

    .btn-tumblr {
        background: linear-gradient(135deg, #162e54 0%, #0076a8 100%);
        color: white;
        border: none;
        border-radius: 0.25rem;
        padding: 0.5rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s ease;
        height: 38px;
    }

        .btn-tumblr:hover {
            background: linear-gradient(135deg, #0c1a32 0%, #00648f 100%);
            transform: translateY(-2px);
            box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.15);
            color: white;
        }

    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid rgba(0, 0, 0, 0.125);
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.15);
        }

    .card-header {
        background: linear-gradient(135deg, #162e54 0%, #0076a8 100%);
        color: white;
        border-radius: 0.5rem 0.5rem 0 0 !important;
        padding: 15px 20px;
        border: none;
    }

        .card-header h5 {
            margin: 0;
            font-weight: 600;
            font-size: 18px;
        }

    .info-box {
        background: #e6f2ff;
        border-left: 4px solid #0076a8;
        padding: 15px 20px;
        border-radius: 0.25rem;
        margin-bottom: 20px;
    }

        .info-box i {
            margin-right: 10px;
            color: #0076a8;
        }

    table.dataTable {
        border-collapse: collapse !important;
        width: 100%;
    }

        table.dataTable thead th {
            background-color: #162e54 !important;
            color: white !important;
            font-weight: 600;
            font-size: 14px;
            padding: 12px 16px;
            border-bottom: 2px solid #0c1a32;
        }

        table.dataTable tbody td {
            font-size: 14px;
            padding: 12px 16px;
            border-bottom: 1px solid #dee2e6;
            vertical-align: middle;
        }

        table.dataTable tbody tr {
            transition: background-color 0.15s ease;
        }

            table.dataTable tbody tr:hover {
                background-color: #f0f8ff;
            }

    div.dt-buttons {
        margin-bottom: 15px;
        text-align: right;
    }

    .dt-button {
        margin-right: 5px !important;
        border-radius: 4px !important;
        padding: 6px 12px !important;
        font-size: 14px !important;
        transition: all 0.3s ease;
        border: none !important;
        font-weight: 500;
    }

        .dt-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.15);
        }

    .btn-success {
        background-color: #28a745 !important;
        color: white !important;
    }

    .btn-danger {
        background-color: #dc3545 !important;
        color: white !important;
    }

    .btn-secondary {
        background-color: #6c757d !important;
        color: white !important;
    }

    #stokSearchModal .modal-content,
    #depoSearchModal .modal-content {
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    #stokSearchModal .modal-header,
    #depoSearchModal .modal-header {
        background: linear-gradient(135deg, #162e54 0%, #0076a8 100%);
        color: white;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    #stokSearchModal .close,
    #depoSearchModal .close {
        color: white;
        text-shadow: none;
        opacity: 0.8;
    }

        #stokSearchModal .close:hover,
        #depoSearchModal .close:hover {
            opacity: 1;
        }

    #stokTable, #depoTable {
        width: 100%;
        border-collapse: collapse;
    }

        #stokTable th, #depoTable th {
            position: sticky;
            top: 0;
            background-color: #162e54;
            color: white;
            z-index: 10;
        }

        #stokTable tbody tr:hover,
        #depoTable tbody tr:hover {
            background-color: #f0f8ff;
            cursor: pointer;
        }

    .simple-scroll-table {
        width: 100%;
        overflow-x: auto;
        overflow-y: visible;
    }

    .badge-success {
        background-color: #28a745;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
    }

    .badge-warning {
        background-color: #ffc107;
        color: #212529;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
    }

    @@media (max-width: 768px) {
        .search-form

    {
        padding: 15px;
    }

    .btn-tumblr {
        width: 100%;
    }

    table.dataTable thead th,
    table.dataTable tbody td {
        font-size: 12px;
        padding: 8px;
    }

    }

    @@media print {
        .dt-buttons, .dataTables_filter, .dataTables_length, .dataTables_paginate, .dataTables_info

    {
        display: none !important;
    }

    table.dataTable thead th {
        background-color: #162e54 !important;
        color: white !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    }
</style>

<div class="main-content mt-5">
    <div class="container-fluid px-lg-4 px-3 mt-5">
        <div class="row mb-3">
            <div class="col-12">
                <h4 class="page-title">Stok-Depo Listesi</h4>
            </div>
        </div>

   <div class="row mb-4">
    <div class="col-12">
        <div class="card search-form">
            <form method="get">
                <input type="hidden" id="selectedStokText" name="selectedStokText" value="" />
                <input type="hidden" id="selectedDepoText" name="selectedDepoText" value="" />

                <div class="row">
                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <div class="form-group mb-0">
                            <label for="stokArama">Stok Kodu:</label>
                            <div class="stok-arama-container">
                                <div class="input-group">
                                    <input type="text" id="stokArama" class="form-control"
                                           placeholder="Stok Kodu veya Adını Arayın"
                                           autocomplete="off">
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary" type="button" onclick="openStokSearchModal()">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary" type="button" onclick="clearStokSearch()">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <select id="stokKodu" name="stokKodu" class="hidden-select">
                                    <option value="">Tüm Stoklar</option>
                                    @if (ViewBag.Stoklar != null)
                                    {
                                        foreach (var stok in ViewBag.Stoklar)
                                        {
                                            var isStokSelected = stok.StokKodu == selectedStokKodu;
                                            <option value="@stok.StokKodu" selected="@isStokSelected">
                                                @stok.StokKodu - @stok.StokAdi
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <div class="form-group mb-0">
                            <label for="depoArama">Depo:</label>
                            <div class="stok-arama-container">
                                <div class="input-group">
                                    <input type="text" id="depoArama" class="form-control"
                                           placeholder="Depo Adını Arayın"
                                           autocomplete="off">
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary" type="button" onclick="openDepoSearchModal()">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary" type="button" onclick="clearDepoSearch()">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <select id="depoNo" name="depoNo" class="hidden-select">
                                    <option value="">Tüm Depolar</option>
                                    @if (ViewBag.Depolar != null)
                                    {
                                        foreach (var depo in ViewBag.Depolar)
                                        {
                                            var isDepoSelected = depo.DepoNo.ToString() == selectedDepoNo;
                                            <option value="@depo.DepoNo" selected="@isDepoSelected">
                                                @depo.DepoAdi
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12">
                        <div class="form-group mb-0">
                            <label for="durum">Durum:</label>
                            <select id="durum" name="durum" class="form-control">
                                <option value="" @@(ViewBag.SelectedDurum == null || ViewBag.SelectedDurum == "" ? "selected" : "")>Tüm Durumlar</option>
                                <option value="Stokta" @@(ViewBag.SelectedDurum == "Stokta" ? "selected" : "")>Stokta</option>
                                <option value="Tükendi" @@(ViewBag.SelectedDurum == "Tükendi" ? "selected" : "")>Tükendi</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12">
                        <button type="submit" class="btn btn-tumblr w-100">Listele</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="fa fa-warehouse"></i> Stok-Depo Listesi</h5>
                    </div>
                    <div class="card-body">
                        @if (Model != null && Model.Any())
                        {
                            <div class="info-box">
                                <i class="fa fa-info-circle"></i> Bu raporda <strong>@Model.Count()</strong> adet kayıt bulunmaktadır.
                            </div>

                            <div class="simple-scroll-table">
                                <table id="example" class="table table-bordered table-striped" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Stok Kodu</th>
                                            <th>Stok Adı</th>
                                            <th>Depo</th>
                                            <th class="text-right">Miktar</th>
                                            <th>Birim</th>
                                            <th class="text-right">Fiyat</th>
                                            <th>Döviz</th>
                                            <th class="text-right">Toplam Değer</th>
                                            <th>Durum</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            var toplamDeger = item.Miktar * item.Fiyat;
                                            var durum = item.Miktar > 0 ? "Stokta" : "Tükendi";
                                            var durumClass = item.Miktar > 0 ? "badge-success" : "badge-warning";

                                            <tr>
                                                <td>@item.StokKodu</td>
                                                <td>@item.StokAdi</td>
                                                <td>@item.DepoAdi</td>
                                                <td class="text-right"><strong>@item.Miktar.ToString("N2")</strong></td>
                                                <td>@item.BirimAdi</td>
                                                <td class="text-right">@item.Fiyat.ToString("N2")</td>
                                                <td>@item.DovizCinsi</td>
                                                <td class="text-right"><strong>@toplamDeger.ToString("N2")</strong></td>
                                                <td><span class="@durumClass">@durum</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="info-box">
                                <i class="fa fa-exclamation-triangle"></i>
                                Seçilen kriterlere uygun kayıt bulunamadı.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stok Arama Modal -->
<div class="modal fade" id="stokSearchModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-search"></i> Stok Arama</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <input type="text" class="form-control" id="stokModalSearch"
                           placeholder="Stok Kodu veya Adı ile Arayın..."
                           onkeyup="filterStokTable()">
                </div>
                <div style="max-height: 400px; overflow-y: auto;">
                    <table id="stokTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Stok Kodu</th>
                                <th>Stok Adı</th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.Stoklar != null)
                            {
                                foreach (var stok in ViewBag.Stoklar)
                                {
                                    <tr>
                                        <td>@stok.StokKodu</td>
                                        <td>@stok.StokAdi</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    onclick="selectStokFromModal('@stok.StokKodu', '@stok.StokAdi')">
                                                <i class="fa fa-check"></i> Seç
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Depo Arama Modal -->
<div class="modal fade" id="depoSearchModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-search"></i> Depo Arama</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <input type="text" class="form-control" id="depoModalSearch"
                           placeholder="Depo Adı ile Arayın..."
                           onkeyup="filterDepoTable()">
                </div>
                <div style="max-height: 400px; overflow-y: auto;">
                    <table id="depoTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Depo No</th>
                                <th>Depo Adı</th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.Depolar != null)
                            {
                                foreach (var depo in ViewBag.Depolar)
                                {
                                    <tr>
                                        <td>@depo.DepoNo</td>
                                        <td>@depo.DepoAdi</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    onclick="selectDepoFromModal('@depo.DepoNo', '@depo.DepoAdi')">
                                                <i class="fa fa-check"></i> Seç
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript" src="~/Content/DataTables/datatables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

<script>
    $(document).ready(function() {
        var hasData = @(Model != null && Model.Any() ? "true" : "false");

       if (hasData) {
        // Extend DataTables search
        $.fn.dataTable.ext.search.push(
            function(settings, data, dataIndex) {
                var durumFilter = $('#durum').val();
                var durumColumn = data[8]; // "Durum" column index (9th column, 0-based)

                if (durumFilter === '') {
                    return true; // Show all rows if no filter is selected
                }
                return durumColumn === durumFilter;
            }
        );

        var table = $('#example').DataTable({
            "order": [[0, "asc"]],
            "dom": '<"row"<"col-sm-12"B>>' +
                   '<"row"<"col-sm-6"l><"col-sm-6"f>>' +
                   't' +
                   '<"row"<"col-sm-6"i><"col-sm-6"p>>',
            "language": {
                "url": "/Content/DataTables/turkish.json"
            },
            "buttons": [
                {
                    extend: 'excel',
                    text: '<i class="fa fa-file-excel"></i> Excel',
                    className: 'btn btn-success',
                    title: 'Stok-Depo Listesi'
                },
                {
                    extend: 'pdf',
                    text: '<i class="fa fa-file-pdf"></i> PDF',
                    className: 'btn btn-danger',
                    title: 'Stok-Depo Listesi'
                },
                {
                    extend: 'print',
                    text: '<i class="fa fa-print"></i> Yazdır',
                    className: 'btn btn-secondary',
                    title: 'Stok-Depo Listesi'
                }
            ],
            "pageLength": 50,
            "lengthMenu": [[10, 25, 50, 100, 500], [10, 25, 50, 100, 500]],
            "scrollX": true
        });

        // Redraw table when durum filter changes
        $('#durum').on('change', function() {
            table.draw();
        });
    }

        // Modal işlemleri
         // Modal Enter tuşuna basıldığında ilk eşleşen kaydı seç
        $('#stokModalSearch').keypress(function(e) {
            if (e.which == 13) {
                e.preventDefault();
                var firstVisibleRow = $('#stokTable tbody tr:visible').first();
                if (firstVisibleRow.length > 0) {
                    var stokKod = firstVisibleRow.find('td:first').text();
                    var stokAdi = firstVisibleRow.find('td:eq(1)').text();
                    selectStokFromModal(stokKod, stokAdi);
                }
            }
        });

        // Modal kapatıldığında
        $('#stokSearchModal').on('hidden.bs.modal', function() {
            $('#stokModalSearch').val('');
            filterStokTable();
        });
    });

    // Stok Arama Modal fonksiyonları
    function openStokSearchModal() {
        $('#stokSearchModal').modal('show');
        setTimeout(function() {
            $('#stokModalSearch').focus();
        }, 500);
    }

    // Stok tablosundaki aramaları filtreleme
    function filterStokTable() {
        var input, filter, table, tr, td1, td2, i, txtValue1, txtValue2;
        input = document.getElementById("stokModalSearch");
        filter = input.value.toUpperCase();
        table = document.getElementById("stokTable");
        tr = table.getElementsByTagName("tr");

        for (i = 0; i < tr.length; i++) {
            if (tr[i].getElementsByTagName("td").length > 0) {
                td1 = tr[i].getElementsByTagName("td")[0];
                td2 = tr[i].getElementsByTagName("td")[1];

                if (td1 && td2) {
                    txtValue1 = td1.textContent || td1.innerText;
                    txtValue2 = td2.textContent || td2.innerText;

                    if (txtValue1.toUpperCase().indexOf(filter) > -1 ||
                        txtValue2.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }
    }

    // Modal'dan stok seçimi yapıldığında
    function selectStokFromModal(stokKod, stokAdi) {
            try {document.getElementById('stokKodu').value = stokKod;
            document.getElementById('stokArama').value = stokKod + " - " + stokAdi;

            if (document.getElementById('selectedStokText')) {
                document.getElementById('selectedStokText').value = stokKod + " - " + stokAdi;
            }

            console.log("Stok seçildi: " + stokKod + " - " + stokAdi);

            $('#stokSearchModal').modal('hide');

        } catch (error) {
            console.error("Stok seçim hatası:", error);
        }
    }

    // Input temizleme fonksiyonu
    function clearStokSearch() {
        document.getElementById('stokArama').value = '';
        document.getElementById('stokKodu').value = '';

        if (document.getElementById('selectedStokText')) {
            document.getElementById('selectedStokText').value = '';
        }

        document.getElementById('stokArama').focus();
    }

    // Arama inputundan seçilen değeri gerçek select'e aktarmak için
    function updateStokCodeSelect(selectedValue) {
        var stokKodSelect = document.getElementById('stokKodu');

        if (stokKodSelect && selectedValue) {
            stokKodSelect.value = selectedValue;

            var selectedOption = document.querySelector('#stokKodu option[value="' + selectedValue + '"]');
            if (selectedOption) {
                document.getElementById('stokArama').value = selectedOption.textContent;
                document.getElementById('selectedStokText').value = selectedOption.textContent;
            }
        }
    }
</script>